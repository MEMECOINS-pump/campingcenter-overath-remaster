---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SeoHead, { type SeoProps } from '@/components/layout/SeoHead.astro';
import Header from '@/components/layout/Header.astro';
import MobileMenu from '@/components/layout/MobileMenu.astro';
import MobileActionBar from '@/components/layout/MobileActionBar.astro';
import Footer from '@/components/layout/Footer.astro';
import CookieConsent from '@/components/layout/CookieConsent.astro';
import CompareTray from '@/components/vehicles/CompareTray.astro';
import ChatWidget from '@/components/layout/ChatWidget.astro';
import CampingCompanion from '@/components/layout/CampingCompanion.astro';
import { organizationSchema } from '@/lib/schema';
import { buildBootScript } from '@/lib/boot-script';
import { getLangFromPath, htmlLang, t, type Locale } from '@/i18n';

interface Props extends SeoProps {
  /** Transparent header over a full-bleed hero. */
  overlayHeader?: boolean;
  /** Show the generic mobile action bar (pages with their own sticky CTA pass false). */
  actionBar?: boolean;
  inquiryHref?: string;
  inquiryLabel?: string;
  bodyClass?: string;
  /** Floating "X von 3 im Vergleich" pill – only where vehicles are listed. */
  compareTray?: boolean;
  /** Override locale (otherwise derived from URL: `/en/...` → en). */
  lang?: Locale;
}

const {
  overlayHeader = false,
  actionBar = true,
  inquiryHref,
  inquiryLabel,
  bodyClass,
  compareTray = false,
  jsonLd = [],
  lang: langProp,
  ...seo
} = Astro.props;

const lang = langProp ?? getLangFromPath(Astro.url.pathname);
const boot = buildBootScript();
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <script is:inline set:html={boot} />
    <SeoHead {...seo} lang={lang} jsonLd={[organizationSchema(Astro.site), ...jsonLd]} />
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body class={bodyClass} data-actionbar={actionBar || Astro.slots.has('sticky') ? '' : undefined} data-lang={lang}>
    <a class="skip-link" href="#main">{t(lang, 'skipToContent')}</a>
    <Header overlay={overlayHeader} lang={lang} />
    <MobileMenu lang={lang} />
    <main id="main" tabindex="-1" transition:animate="fade">
      <slot />
    </main>
    <Footer lang={lang} />
    {actionBar && <MobileActionBar inquiryHref={inquiryHref} inquiryLabel={inquiryLabel} lang={lang} />}
    <slot name="sticky" />
    {compareTray && <CompareTray />}
    <CampingCompanion lang={lang} transition:persist="cco-companion" />
    <ChatWidget lang={lang} transition:persist="cco-chat" />
    <CookieConsent lang={lang} transition:persist="cco-consent" />
    <div class="toast" role="status" aria-live="polite" data-toast transition:persist="cco-toast"></div>
    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
