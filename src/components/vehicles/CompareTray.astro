---
import Icon from '@/components/ui/Icon.astro';
import { url } from '@/lib/url';
---

<aside class="ctray" data-compare-tray hidden aria-label="Fahrzeugvergleich">
  <p class="ctray-text">
    <Icon name="compare" />
    <span><strong data-compare-count>0</strong> von 3 im Vergleich</span>
  </p>
  <a class="btn btn-accent btn-sm" href={url('/vergleich/')} data-track="compare_open">Vergleichen</a>
  <button type="button" class="ctray-clear" data-compare-clear aria-label="Vergleich leeren">
    <Icon name="close" />
  </button>
</aside>

<style>
  .ctray {
    position: fixed;
    z-index: 40;
    left: 50%;
    bottom: calc(var(--actionbar-h, 0px) + 0.75rem + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: max-content;
    max-width: calc(100vw - 1.5rem);
    padding: 0.4rem 0.4rem 0.4rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--graphite);
    color: #fff;
    box-shadow: var(--shadow-lg, 0 18px 40px rgb(0 0 0 / 0.25));
    transform: translateX(-50%);
    animation: ctray-in 0.3s var(--ease-out);
  }

  .ctray[hidden] {
    display: none;
  }

  :global(body.kb-open) .ctray,
  :global(body.scroll-locked) .ctray {
    display: none;
  }

  .ctray-text {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-sm);
    white-space: nowrap;
  }

  .ctray-clear {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  .ctray-clear:hover {
    background: rgb(255 255 255 / 0.22);
  }

  @keyframes ctray-in {
    from {
      opacity: 0;
      transform: translate(-50%, 1rem);
    }
  }
</style>
