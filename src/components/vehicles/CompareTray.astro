---
import Icon from '@/components/ui/Icon.astro';
import { COMPARE_MAX } from '@/lib/collections';
import { url } from '@/lib/url';
---

<aside class="ctray" data-compare-tray hidden aria-label="Fahrzeugvergleich">
  <p class="ctray-text">
    <Icon name="compare" />
    <span><strong data-compare-count>0</strong> von {COMPARE_MAX} im Vergleich</span>
  </p>
  <a class="btn btn-accent btn-sm" href={url('/vergleich/')} data-track="compare_open">Vergleichen</a>
  <button type="button" class="ctray-clear" data-compare-clear aria-label="Vergleich leeren">
    <Icon name="close" />
  </button>
</aside>

<style>
  .ctray {
    position: fixed;
    z-index: var(--z-compare, 42);
    /* Keep clear of Adventure Compass FAB (bottom-right) + action bar */
    left: max(0.75rem, env(safe-area-inset-left, 0px));
    right: calc(var(--companion-fab-h, 3.5rem) + 1.5rem + env(safe-area-inset-right, 0px));
    bottom: calc(var(--actionbar-h, 0px) + 0.75rem + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: max-content;
    max-width: calc(100vw - var(--companion-fab-h, 3.5rem) - 2.5rem - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px));
    margin-inline: auto;
    padding: 0.4rem 0.4rem 0.4rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--graphite);
    color: #fff;
    box-shadow: var(--shadow-lg, 0 18px 40px rgb(0 0 0 / 0.25));
    animation: ctray-in 0.3s var(--ease-out);
  }

  :global(body.bar-hidden) .ctray {
    display: none;
  }

  .ctray[hidden] {
    display: none;
  }

  :global(body.kb-open) .ctray,
  :global(body.scroll-locked) .ctray {
    display: none;
  }

  .ctray-text {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-sm);
    white-space: nowrap;
  }

  .ctray-clear {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  .ctray-clear:hover {
    background: rgb(255 255 255 / 0.22);
  }

  @keyframes ctray-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @media (min-width: 64em) {
    .ctray {
      left: 50%;
      right: auto;
      max-width: calc(100vw - 1.5rem);
      transform: translateX(-50%);
    }

    @keyframes ctray-in {
      from {
        opacity: 0;
        transform: translate(-50%, 1rem);
      }
    }
  }
</style>
