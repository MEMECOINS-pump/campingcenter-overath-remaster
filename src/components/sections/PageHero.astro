---
import Photo from '@/components/ui/Photo.astro';
import Breadcrumbs, { type Crumb } from '@/components/ui/Breadcrumbs.astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image: string;
  imageAlt: string;
  crumbs: Crumb[];
  /** object-position presets (inline styles are blocked by the CSP). */
  focus?: 'center' | 'left' | 'right' | 'top' | 'bottom';
  size?: 'md' | 'lg';
}
const { eyebrow, title, lead, image, imageAlt, crumbs, focus = 'center', size = 'md' } = Astro.props;
---

<section class:list={['phero', `phero-${size}`, `focus-${focus}`]} aria-labelledby="page-title">
  <div class="phero-media">
    <Photo src={image} alt={imageAlt} priority sizes="100vw" widths={[640, 960, 1280, 1920]} quality={70} />
  </div>
  <div class="phero-shade" aria-hidden="true"></div>
  <div class="container phero-inner">
    <Breadcrumbs items={crumbs} tone="light" />
    <div class="phero-copy">
      <p class="phero-eyebrow">{eyebrow}</p>
      <h1 id="page-title">{title}</h1>
      {lead && <p class="phero-lead">{lead}</p>}
      {Astro.slots.has('default') && <div class="btn-row phero-ctas"><slot /></div>}
    </div>
  </div>
</section>

<style>
  .phero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: clamp(32rem, 72svh, 44rem);
    color: #fff;
    background: #2a2622;
  }

  .phero-lg {
    min-height: clamp(34rem, 88svh, 52rem);
  }

  .phero-media,
  .phero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .phero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .focus-left .phero-media :global(img) {
    object-position: 25% 50%;
  }

  .focus-right .phero-media :global(img) {
    object-position: 75% 50%;
  }

  .focus-top .phero-media :global(img) {
    object-position: 50% 25%;
  }

  .focus-bottom .phero-media :global(img) {
    object-position: 50% 75%;
  }

  .phero-shade {
    background:
      linear-gradient(to top, rgb(14 12 10 / 0.85) 0%, rgb(14 12 10 / 0.4) 50%, rgb(14 12 10 / 0.55) 100%),
      linear-gradient(to right, rgb(14 12 10 / 0.45), transparent 70%);
  }

  .phero-inner {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 2rem;
    padding-top: calc(var(--header-h) + var(--safe-top) + 1.25rem);
    padding-bottom: clamp(2.25rem, 1.5rem + 3vw, 4.5rem);
  }

  .phero-copy {
    align-self: end;
    max-width: 46rem;
  }

  .phero-eyebrow {
    font-size: var(--fs-xs);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffd9a3;
  }

  .phero h1 {
    margin-top: 0.75rem;
    max-width: 18ch;
    color: #fff;
    font-size: var(--fs-hero);
    line-height: 1.02;
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.25);
  }

  .phero-lead {
    margin-top: 1rem;
    max-width: 36rem;
    font-size: var(--fs-lg);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.9);
  }

  .phero-ctas {
    margin-top: 1.75rem;
  }

  @media (max-width: 35.99em) {
    .phero-ctas :global(.btn) {
      width: 100%;
    }
  }
</style>
