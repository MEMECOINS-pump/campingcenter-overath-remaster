---
import { Image } from 'astro:assets';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import { brands } from '@/data/brands';
import { brandsEn } from '@/data/content-en';
import { vehicles } from '@/lib/vehicles';
import { getLangFromPath, localizedPath, t, type Locale } from '@/i18n';
import { url } from '@/lib/url';

interface Props {
  showHeader?: boolean;
  lang?: Locale;
}
const { showHeader = true, lang: langProp } = Astro.props;
const lang = langProp ?? getLangFromPath(Astro.url.pathname);
const L = (path: string) => url(localizedPath(path, lang));
const list = lang === 'en' ? brandsEn : brands;
const count = (make?: string) => (make ? vehicles.filter((v) => v.make === make).length : 0);
---

<section class="section brands" aria-labelledby="brands-title">
  <div class="container">
    {
      showHeader && (
        <div class="section-head-row">
          <SectionHeader
            id="brands-title"
            eyebrow={t(lang, 'brandsEyebrow')}
            title={t(lang, 'brandsTitle')}
            lead={t(lang, 'brandsLead')}
          />
          <a class="btn btn-ghost" href={L('/marken/')}>
            {t(lang, 'brandsAll')} <Icon name="arrow-right" class="arrow" />
          </a>
        </div>
      )
    }
    <ul class="brand-grid" role="list">
      {
        list.map((b) => {
          const n = count(b.inventoryMake);
          const meta = b.internalHref
            ? t(lang, 'brandsOwnPage')
            : n > 0
              ? t(lang, 'brandsInStock').replace('{n}', String(n))
              : t(lang, 'brandsMore');
          return (
            <li class="brand">
              <a href={L(`/marken/#${b.id}`)} class="brand-link">
                <Image
                  src={b.logo}
                  alt={b.name}
                  widths={[160, 320]}
                  sizes="10rem"
                  class:list={['brand-logo', { 'brand-logo-square': b.logo.width / b.logo.height < 1.6 }]}
                  loading="lazy"
                />
                <span class="brand-meta">{meta}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .brand-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    list-style: none;
  }

  .brand-link {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.9rem;
    height: 100%;
    min-height: 8.5rem;
    padding: 1.25rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .brand-link:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }

  .brand-logo {
    width: auto;
    max-width: min(100%, 9.5rem);
    height: 2.5rem;
    object-fit: contain;
  }

  .brand-logo-square {
    height: 3.75rem;
  }

  .brand-meta {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text-muted);
  }

  .brand:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  @media (min-width: 48em) {
    .brand-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
    }

    .brand:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
</style>
