---
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import { getLangFromPath, localizedPath, t, type Locale } from '@/i18n';
import { url } from '@/lib/url';

interface Props {
  title?: string;
  text?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  lang?: Locale;
}
const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const L = (path: string) => url(localizedPath(path, lang));
const {
  title = t(lang, 'ctaTitle'),
  text = t(lang, 'ctaText'),
  primary = { label: t(lang, 'heroCtaVehicles'), href: '/wohnmobile/' },
  secondary = { label: t(lang, 'heroCtaAdvice'), href: '/kontakt/#beratung' },
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta-media">
    <Photo src="road-landscape" alt="" sizes="100vw" widths={[640, 1024, 1600, 2200]} />
  </div>
  <div class="cta-shade" aria-hidden="true"></div>
  <div class="container-narrow cta-inner">
    <h2 id="cta-title">{title}</h2>
    <p>{text}</p>
    <div class="btn-row">
      <a class="btn btn-accent btn-lg" href={L(primary.href)} data-track="cta_click" data-track-location="final-cta">
        {primary.label} <Icon name="arrow-right" class="arrow" />
      </a>
      <a class="btn btn-glass btn-lg" href={L(secondary.href)} data-track="cta_click" data-track-location="final-cta">{secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 30rem;
    color: #fff;
    background: #1e2227;
    text-align: center;
  }

  .cta-media,
  .cta-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cta-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-shade {
    background: linear-gradient(to top, rgb(14 12 10 / 0.88), rgb(14 12 10 / 0.45));
  }

  .cta-inner {
    display: grid;
    gap: 1rem;
    justify-items: center;
    align-content: center;
    padding-block: clamp(3rem, 2rem + 5vw, 5rem);
  }

  .cta-inner h2 {
    max-width: 16ch;
    margin: 0;
    color: #fff;
  }

  .cta-inner p {
    max-width: 36rem;
    margin: 0;
    color: rgb(255 255 255 / 0.9);
  }

  .cta-inner .btn-row {
    justify-content: center;
    margin-top: 0.75rem;
  }
</style>
