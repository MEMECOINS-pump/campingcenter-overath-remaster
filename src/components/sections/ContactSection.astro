---
import Icon from '@/components/ui/Icon.astro';
import MapPreview from '@/components/embeds/MapPreview.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import OpenState from '@/components/ui/OpenState.astro';
import { company, openingHours, formatHours } from '@/data/company';
import { getLangFromPath, t, type Locale } from '@/i18n';

interface Props {
  title?: string;
  eyebrow?: string;
  lang?: Locale;
}
const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const title = Astro.props.title ?? t(lang, 'contactTitle');
const eyebrow = Astro.props.eyebrow ?? t(lang, 'contactEyebrow');
const dayLabels =
  lang === 'en'
    ? openingHours.map((p) => ({
        ...p,
        days: p.schemaDays.includes('Saturday') ? 'Saturday' : 'Monday to Friday',
      }))
    : openingHours;
---

<section class="section section-sand contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div class="contact-info">
      <SectionHeader id="contact-title" eyebrow={eyebrow} title={title} />
      <address class="contact-address">
        <strong>{company.legalName}</strong><br />
        {company.address.street}<br />
        {company.address.postalCode} {company.address.city}
      </address>

      <div class="contact-actions">
        <a class="btn btn-accent btn-lg" href={company.phone.href} data-track="call_click" data-track-location="contact-section">
          <Icon name="phone" /> {t(lang, 'contactCall')}
        </a>
        <a class="btn btn-lg" href={`mailto:${company.email}`} data-track="email_click" data-track-location="contact-section">
          <Icon name="mail" /> {t(lang, 'contactWrite')}
        </a>
        <a class="btn btn-ghost btn-lg" href={company.directions} target="_blank" rel="noopener" data-track="route_click" data-track-location="contact-section">
          <Icon name="route" /> {t(lang, 'contactRoute')}
        </a>
      </div>
      <p class="contact-lines">
        {t(lang, 'contactPhoneLabel')} <a href={company.phone.href}>{company.phone.display}</a> · {t(lang, 'contactEmailLabel')}{' '}
        <a href={`mailto:${company.email}`}>{company.email}</a>
      </p>

      <div class="hours">
        <div class="hours-head">
          <h3>{t(lang, 'openingHours')}</h3>
          <OpenState />
        </div>
        <dl>
          {
            dayLabels.map((p) => (
              <div>
                <dt>{p.days}</dt>
                <dd>
                  {lang === 'en'
                    ? p.hours.map((h) => `${h.opens}–${h.closes}`).join(' and ')
                    : formatHours(p)}
                </dd>
              </div>
            ))
          }
          <div>
            <dt>{t(lang, 'daysSunday')}</dt>
            <dd>{t(lang, 'closed')}</dd>
          </div>
          <div>
            <dt>{t(lang, 'daysHolidaysNrw')}</dt>
            <dd>{t(lang, 'closed')}</dd>
          </div>
        </dl>
      </div>
    </div>
    <MapPreview />
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    gap: 2.5rem;
  }

  .contact-info .section-head {
    margin-bottom: 1.25rem;
  }

  .contact-address {
    font-style: normal;
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
  }

  .contact-lines {
    margin-bottom: 1.5rem;
    font-size: var(--fs-sm);
  }

  .hours-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .hours-head h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .hours dl {
    display: grid;
    gap: 0.45rem;
    margin: 0;
  }

  .hours dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--fs-sm);
  }

  .hours dt {
    font-weight: 700;
  }

  @media (min-width: 64em) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: start;
    }
  }
</style>
