---
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import { rental } from '@/data/content';
import { rentalEn } from '@/data/content-en';
import { getLangFromPath, localizedPath, t, type Locale } from '@/i18n';
import { url } from '@/lib/url';

interface Props {
  lang?: Locale;
}
const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const L = (path: string) => url(localizedPath(path, lang));
const copy = lang === 'en' ? rentalEn : rental;
---

<section class="section rental" aria-labelledby="rental-title">
  <div class="container split">
    <div class="rental-media reveal">
      <Photo
        src="rental-header"
        alt={lang === 'en' ? 'Rental motorhome on a country road' : 'Mietwohnmobil auf einer Landstraße'}
        sizes="(min-width: 60em) 44vw, 92vw"
        widths={[480, 768, 1080, 1440]}
      />
    </div>
    <div class="rental-copy">
      <p class="eyebrow">{t(lang, 'rentalEyebrow')}</p>
      <h2 id="rental-title">{t(lang, 'rentalTitle')}</h2>
      <p class="lead">{t(lang, 'rentalLead')}</p>
      <ul class="rental-benefits">
        {
          copy.benefits.map((b) => (
            <li>
              <Icon name="check" />
              <span>
                <strong>{b.title}</strong> – {b.text}
              </span>
            </li>
          ))
        }
      </ul>
      <div class="btn-row">
        <a class="btn" href={L('/vermietung-wohnmobile/')}>
          {t(lang, 'rentalCta')} <Icon name="arrow-right" class="arrow" />
        </a>
        <a class="btn btn-ghost" href={copy.adacBookingUrl} target="_blank" rel="noopener" data-track="rental_booking_click" data-track-location="home">
          {t(lang, 'rentalAdac')} <Icon name="external" />
          <span class="sr-only">({t(lang, 'opensExternal')})</span>
        </a>
      </div>
      <p class="rental-note">{t(lang, 'rentalNote')}</p>
    </div>
  </div>
</section>

<style>
  .rental-media {
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 3 / 2;
  }

  .rental-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rental-copy {
    display: grid;
    gap: 1.1rem;
  }

  .rental-benefits {
    display: grid;
    gap: 0.65rem;
    list-style: none;
  }

  .rental-benefits li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    font-size: var(--fs-sm);
  }

  .rental-benefits :global(.icon) {
    color: var(--forest);
  }

  .rental-note {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
</style>
