---
import Icon from '@/components/ui/Icon.astro';
import Atmosphere from '@/components/ui/Atmosphere.astro';
import { company } from '@/data/company';
import { vehicles } from '@/lib/vehicles';
import { url } from '@/lib/url';

const items = [
  { icon: 'shield' as const, label: 'Seit 30 Jahren', hint: 'Familiär in Overath' },
  { icon: 'tag' as const, label: '3 Markenpartner', hint: 'Challenger · LA STRADA · Eura Mobil' },
  { icon: 'van' as const, label: `${vehicles.length} Fahrzeuge`, hint: 'Aktueller Bestand' },
  { icon: 'wrench' as const, label: 'Fachwerkstatt', hint: 'Service & Nachrüstung' },
];
---

<section class="prestige" aria-label="Warum Campingcenter Overath">
  <div class="container">
    <div class="prestige-inner atmo atmo-card">
      <Atmosphere src="atmo-shore" focus="center" />
    <p class="prestige-brand">
      <span class="prestige-mark">CCO</span>
      <span class="prestige-name">{company.name}</span>
      <span class="prestige-claim">Wir pflegen die Kultur des Campings</span>
    </p>
    <ul class="prestige-list" role="list">
      {
        items.map((item) => (
          <li>
            <Icon name={item.icon} />
            <span>
              <strong>{item.label}</strong>
              <small>{item.hint}</small>
            </span>
          </li>
        ))
      }
    </ul>
    <a class="prestige-link" href={url('/ueber-uns/')}>
      Über uns <Icon name="arrow-right" />
    </a>
    </div>
  </div>
</section>

<style>
  .prestige {
    position: relative;
    z-index: 2;
    margin-top: -2.5rem;
    padding-bottom: 0.5rem;
  }
  .prestige-inner {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: var(--radius-lg);
    background: rgb(20 18 16 / 0.62);
    box-shadow: var(--shadow-md);
    color: #fff;
  }
  @media (min-width: 64em) {
    .prestige-inner {
      grid-template-columns: minmax(12rem, 0.9fr) 1.6fr auto;
      align-items: center;
      gap: 1.5rem;
    }
  }
  .prestige-brand { display: grid; gap: 0.15rem; margin: 0; }
  .prestige-mark {
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.14em;
    text-transform: uppercase; color: #ffd9a3;
  }
  .prestige-name {
    font-family: var(--font-display); font-size: 1.15rem; font-weight: 650; color: #fff;
  }
  .prestige-claim { font-size: 0.9rem; color: rgb(255 255 255 / 0.88); }
  .prestige-list {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem 1rem;
    margin: 0; padding: 0; list-style: none;
  }
  @media (min-width: 48em) {
    .prestige-list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .prestige-list li { display: flex; gap: 0.55rem; align-items: flex-start; min-width: 0; }
  .prestige-list :global(svg) {
    width: 1.15rem; height: 1.15rem; flex-shrink: 0; margin-top: 0.15rem; color: #ffd9a3;
  }
  .prestige-list strong { display: block; font-size: 0.92rem; font-weight: 700; color: #fff; }
  .prestige-list small { display: block; font-size: 0.78rem; color: rgb(255 255 255 / 0.82); }
  .prestige-link {
    display: inline-flex; align-items: center; gap: 0.35rem; justify-self: start;
    font-weight: 700; color: #ffd9a3; text-decoration: none;
  }
  .prestige-link:hover { color: #fff; }
  .prestige-link :global(svg) { width: 1rem; height: 1rem; }
</style>
