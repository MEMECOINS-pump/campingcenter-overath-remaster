---
import Icon from '@/components/ui/Icon.astro';
import { company } from '@/data/company';
import { vehicles } from '@/lib/vehicles';
import { getLangFromPath, localizedPath, t, type Locale } from '@/i18n';
import { url } from '@/lib/url';

interface Props {
  lang?: Locale;
}
const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const L = (path: string) => url(localizedPath(path, lang));

const items = [
  { icon: 'shield' as const, label: t(lang, 'brandFounded'), hint: t(lang, 'prestigeFamily') },
  { icon: 'tag' as const, label: t(lang, 'prestigePartners'), hint: 'Challenger · LA STRADA · Eura Mobil' },
  { icon: 'van' as const, label: `${vehicles.length} ${t(lang, 'prestigeStock')}`, hint: t(lang, 'prestigeStockHint') },
  { icon: 'wrench' as const, label: t(lang, 'prestigeWorkshop'), hint: t(lang, 'prestigeWorkshopHint') },
];
---

<section class="prestige" aria-label={t(lang, 'prestigeAria')}>
  <div class="container prestige-inner">
    <p class="prestige-brand">
      <span class="prestige-mark">CCO</span>
      <span class="prestige-name">{company.name}</span>
      <span class="prestige-claim">{t(lang, 'brandClaim')}</span>
    </p>
    <ul class="prestige-list" role="list">
      {
        items.map((item) => (
          <li>
            <Icon name={item.icon} />
            <span>
              <strong>{item.label}</strong>
              <small>{item.hint}</small>
            </span>
          </li>
        ))
      }
    </ul>
    <a class="prestige-link" href={L('/ueber-uns/')}>
      {t(lang, 'prestigeAbout')} <Icon name="arrow-right" />
    </a>
  </div>
</section>

<style>
  .prestige {
    position: relative;
    z-index: 2;
    margin-top: -2.5rem;
    padding-bottom: 0.5rem;
  }

  .prestige-inner {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.92);
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(10px);
  }

  @media (min-width: 64em) {
    .prestige-inner {
      grid-template-columns: minmax(12rem, 0.9fr) 1.6fr auto;
      align-items: center;
      gap: 1.5rem;
    }
  }

  .prestige-brand {
    display: grid;
    gap: 0.15rem;
    margin: 0;
  }

  .prestige-mark {
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-ink);
  }

  .prestige-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .prestige-claim {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .prestige-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    list-style: none;
  }

  @media (min-width: 40em) {
    .prestige-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 80em) {
    .prestige-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .prestige-list li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
  }

  .prestige-list :global(.icon) {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.2rem;
    color: var(--brand-ink);
  }

  .prestige-list strong {
    display: block;
    font-size: var(--fs-sm);
    line-height: 1.25;
  }

  .prestige-list small {
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .prestige-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    font-weight: 700;
    white-space: nowrap;
  }
</style>
