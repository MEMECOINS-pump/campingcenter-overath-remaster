---
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import { story } from '@/data/content';
import { company } from '@/data/company';
import { url } from '@/lib/url';
---

<section class="section section-sand story" aria-labelledby="story-title">
  <div class="container split">
    <div class="story-media reveal">
      <div class="story-main">
        <Photo src="team" alt="Das Team des Campingcenter Overath vor einem Wohnmobil" sizes="(min-width: 60em) 40vw, 92vw" widths={[480, 768, 1080]} />
      </div>
      <div class="story-badge">
        <strong>{company.foundedStatement}</strong>
        <span>Camping-Kompetenz in der Weberstraße</span>
      </div>
    </div>
    <div class="story-copy">
      <p class="eyebrow">Über uns</p>
      <h2 id="story-title">Von Campern für Camper.</h2>
      <p class="lead">{story.lead}</p>
      <p>{story.body[0]}</p>
      <div class="btn-row">
        <a class="btn" href={url('/ueber-uns/')}>Unsere Geschichte <Icon name="arrow-right" class="arrow" /></a>
        <a class="btn btn-ghost" href={url('/kontakt/')}>Besuch uns in Overath</a>
      </div>
    </div>
  </div>
</section>

<style>
  .story-media {
    position: relative;
    padding-bottom: 2rem;
  }

  .story-main {
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow);
  }

  .story-main :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-badge {
    position: absolute;
    right: 1rem;
    bottom: 0;
    display: grid;
    gap: 0.15rem;
    max-width: 15rem;
    padding: 1rem 1.2rem;
    border-radius: var(--radius);
    background: var(--graphite);
    color: #fff;
    box-shadow: var(--shadow-lg);
  }

  .story-badge strong {
    font-family: var(--font-head);
    font-size: 1.6rem;
    font-weight: 600;
    color: #ffc778;
  }

  .story-badge span {
    font-size: var(--fs-sm);
    color: rgb(255 255 255 / 0.85);
  }

  .story-copy {
    display: grid;
    gap: 1.1rem;
  }

  .story-copy .btn-row {
    margin-top: 0.5rem;
  }
</style>
