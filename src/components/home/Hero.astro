---
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import { company } from '@/data/company';
import { getLangFromPath, localizedPath, t, type Locale } from '@/i18n';
import { url } from '@/lib/url';

interface Props {
  lang?: Locale;
}
const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const L = (path: string) => url(localizedPath(path, lang));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-media">
    <Photo
      src="hero-sunset"
      alt={t(lang, 'heroAlt')}
      priority
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="100vw"
      quality={70}
      class="hero-img"
    />
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-brand">
        <span class="hero-brand-name">{company.name}</span>
        <span class="hero-brand-claim">{t(lang, 'brandClaim')}</span>
      </p>
      <h1 id="hero-title" class="display">{t(lang, 'heroTitle')}</h1>
      <p class="hero-lead">{t(lang, 'heroLead')}</p>
      <div class="btn-row hero-ctas">
        <a class="btn btn-accent btn-lg" href={L('/wohnmobile/')} data-track="cta_click" data-track-location="hero">
          {t(lang, 'heroCtaVehicles')} <Icon name="arrow-right" class="arrow" />
        </a>
        <a class="btn btn-glass btn-lg" href={L('/kontakt/') + '#beratung'} data-track="cta_click" data-track-location="hero">
          {t(lang, 'heroCtaAdvice')}
        </a>
      </div>
      <a class="hero-rent" href={L('/vermietung-wohnmobile/')}>
        {t(lang, 'heroRentLead')} <span>{t(lang, 'heroRentLink')}</span> <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: max(38rem, 100svh);
    color: #fff;
    background: #2a2622;
  }

  .hero-media,
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-media :global(picture),
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
  }

  .hero-media :global(img) {
    object-fit: cover;
    object-position: 24% 50%;
  }

  @media (min-width: 48em) {
    .hero-media :global(img) {
      object-position: 62% 50%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-media :global(img) {
      animation: hero-ken 18s var(--ease-out) both;
    }
  }

  @keyframes hero-ken {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  .hero-shade {
    background:
      linear-gradient(to top, rgb(14 12 10 / 0.82) 0%, rgb(14 12 10 / 0.35) 45%, rgb(14 12 10 / 0.18) 70%, rgb(14 12 10 / 0.5) 100%),
      linear-gradient(to right, rgb(14 12 10 / 0.45), transparent 65%);
  }

  .hero-inner {
    display: grid;
    align-content: end;
    gap: 2.25rem;
    padding-top: calc(var(--sticky-top) + 3rem);
    padding-bottom: clamp(2.5rem, 1.2rem + 5vw, 5rem);
  }

  .hero-copy {
    max-width: 46rem;
  }

  .hero-brand {
    display: grid;
    gap: 0.35rem;
    margin: 0;
  }

  .hero-brand-name {
    font-family: var(--font-head);
    font-size: clamp(1.35rem, 1.1rem + 1.2vw, 2rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #fff;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }

  .hero-brand-claim {
    font-size: var(--fs-xs);
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffd9a3;
  }

  .hero h1 {
    margin-top: 0.85rem;
    color: #fff;
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.25);
  }

  .hero-lead {
    margin-top: 1.1rem;
    max-width: 34rem;
    font-size: var(--fs-lg);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.9);
  }

  .hero-ctas {
    margin-top: 1.75rem;
  }

  .hero-rent {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    margin-top: 0.75rem;
    color: rgb(255 255 255 / 0.85);
    font-size: var(--fs-sm);
    text-decoration: none;
  }

  .hero-rent span {
    color: #fff;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hero-rent :global(.icon) {
    width: 1rem;
    height: 1rem;
  }

  @media (max-width: 35.99em) {
    .hero-ctas :global(.btn) {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy {
      animation: hero-rise 800ms var(--ease-out) both;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 64em) {
    .hero-inner {
      padding-bottom: 5.5rem;
    }
  }
</style>
