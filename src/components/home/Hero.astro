---
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import { company } from '@/data/company';
import { url } from '@/lib/url';
import { vehicles } from '@/lib/vehicles';

const facts = [
  { icon: 'shield' as const, text: `${company.foundedStatement} in Overath` },
  { icon: 'tag' as const, text: 'Vertragspartner Challenger, LA STRADA & Eura Mobil' },
  { icon: 'key' as const, text: 'ADAC-Mietstation Köln-Ost' },
  { icon: 'wrench' as const, text: 'Fachwerkstatt für Wohnmobile & Wohnwagen' },
];
---

<section class="hero" aria-labelledby="hero-title" data-header-theme="dark">
  <div class="hero-media">
    <Photo
      src="atmo-campfire"
      alt=""
      priority
      widths={[640, 1280, 1920, 2560, 3840]}
      sizes="100vw"
      quality={72}
      class="hero-img"
    />
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">{company.name} · {company.claim}</p>
      <h1 id="hero-title" class="display">Dein Abenteuer beginnt hier.</h1>
      <p class="hero-lead">Wohnmobile kaufen, mieten und professionell betreuen lassen – bei deinen Camping-Experten in Overath.</p>
      <a class="hero-banner" href={url('/camper-finder/')} data-track="camping_finder_start" data-track-location="hero-banner">
        <span>Jetzt Traumcamper finden</span>
        <Icon name="arrow-right" />
      </a>
      <div class="btn-row hero-ctas">
        <a class="btn btn-accent btn-lg" href={url('/wohnmobile/')} data-track="cta_click" data-track-location="hero">
          Fahrzeuge entdecken <Icon name="arrow-right" class="arrow" />
        </a>
        <a class="btn btn-light btn-lg" href={url('/kontakt/#beratung')} data-track="cta_click" data-track-location="hero">
          Beratung vereinbaren
        </a>
      </div>
      <a class="hero-rent" href={url('/vermietung-wohnmobile/')}>
        Lieber erst mieten? <span>Wohnmobil mieten</span> <Icon name="arrow-right" />
      </a>
    </div>

    <ul class="hero-facts">
      {
        facts.map((f) => (
          <li>
            <Icon name={f.icon} />
            <span>{f.text}</span>
          </li>
        ))
      }
      <li class="hero-stock">
        <Icon name="van" />
        <span>{vehicles.length} Fahrzeuge im Bestand</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: max(38rem, 100svh);
    color: #fff;
    background: #2a2622;
  }

  .hero-media,
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-media :global(picture),
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
  }

  .hero-media :global(img) {
    object-fit: cover;
    object-position: 50% 62%;
  }

  @media (min-width: 48em) {
    .hero-media :global(img) {
      object-position: 50% 55%;
    }
  }

  @media (min-width: 80em) {
    .hero-media :global(img) {
      object-position: 48% 52%;
    }
  }

  .hero-shade {
    background:
      linear-gradient(to top, rgb(14 12 10 / 0.82) 0%, rgb(14 12 10 / 0.35) 45%, rgb(14 12 10 / 0.18) 70%, rgb(14 12 10 / 0.5) 100%),
      linear-gradient(to right, rgb(14 12 10 / 0.45), transparent 65%);
  }

  .hero-inner {
    display: grid;
    align-content: end;
    gap: 2.25rem;
    padding-top: calc(var(--sticky-top) + 3rem);
    padding-bottom: clamp(2rem, 1rem + 4vw, 4rem);
  }

  .hero-copy {
    max-width: 46rem;
  }

  .hero-eyebrow {
    font-size: var(--fs-xs);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffd9a3;
  }

  .hero h1 {
    margin-top: 0.9rem;
    color: #fff;
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.25);
  }

  .hero-lead {
    margin-top: 1.1rem;
    max-width: 34rem;
    font-size: var(--fs-lg);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.9);
  }

  .hero-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 38rem;
    margin-top: 1.35rem;
    padding: 0.95rem 1.15rem;
    border-radius: 16px;
    background: rgb(250 248 244 / 0.96);
    color: var(--graphite);
    font-family: var(--font-head);
    font-size: clamp(1.25rem, 1rem + 1.1vw, 1.85rem);
    font-weight: 650;
    line-height: 1.15;
    text-decoration: none;
    box-shadow: 0 16px 40px -24px rgb(0 0 0 / 0.65);
  }

  .hero-banner :global(.icon) {
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
  }

  .hero-banner:hover {
    background: #fff;
    color: var(--brand-ink);
  }

  .hero-ctas {
    margin-top: 1.75rem;
  }

  .hero-rent {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    margin-top: 0.75rem;
    color: rgb(255 255 255 / 0.85);
    font-size: var(--fs-sm);
    text-decoration: none;
  }

  .hero-rent span {
    color: #fff;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hero-rent :global(.icon) {
    width: 1rem;
    height: 1rem;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.2);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  .hero-facts :global(.icon) {
    width: 1rem;
    height: 1rem;
    color: #ffc778;
  }

  @media (max-width: 63.99em) {
    /* A full-viewport hero pins the facts under the fixed action bar. Let the hero size to its content. */
    .hero {
      min-height: auto;
    }

    .hero-inner {
      align-content: start;
      padding-top: calc(var(--sticky-top) + 1.35rem);
      padding-bottom: calc(var(--actionbar-h) + 1.15rem);
    }

    .hero-facts {
      padding-right: calc(var(--companion-fab-h) + 1.15rem);
    }
  }

  @media (max-width: 35.99em) {
    .hero-ctas :global(.btn) {
      width: 100%;
    }

    .hero-facts li:nth-child(n + 3):not(.hero-stock) {
      display: none;
    }
  }

  @media (min-width: 64em) {
    .hero-inner {
      padding-bottom: 5.5rem;
    }
  }
</style>
