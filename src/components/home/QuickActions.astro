---
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import { getLangFromPath, localizedPath, t, type Locale } from '@/i18n';
import { url } from '@/lib/url';

interface Props {
  lang?: Locale;
}
const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const L = (path: string) => url(localizedPath(path, lang));

const actions: { title: string; text: string; cta: string; href: string; icon: IconName }[] = [
  { title: t(lang, 'quickBuyTitle'), text: t(lang, 'quickBuyText'), cta: t(lang, 'quickBuyCta'), href: '/wohnmobile/', icon: 'van' },
  { title: t(lang, 'quickSellTitle'), text: t(lang, 'quickSellText'), cta: t(lang, 'quickSellCta'), href: '/wohnmobil-ankauf/', icon: 'tag' },
  { title: t(lang, 'quickRentTitle'), text: t(lang, 'quickRentText'), cta: t(lang, 'quickRentCta'), href: '/vermietung-wohnmobile/', icon: 'key' },
  { title: t(lang, 'quickWsTitle'), text: t(lang, 'quickWsText'), cta: t(lang, 'quickWsCta'), href: '/werkstatt-kundendienst/', icon: 'wrench' },
];
---

<section class="quick" aria-labelledby="quick-title">
  <div class="container">
    <h2 id="quick-title" class="sr-only">{t(lang, 'quickAria')}</h2>
    <ul class="quick-grid">
      {
        actions.map((a) => (
          <li class="quick-card">
            <span class="quick-icon">
              <Icon name={a.icon} />
            </span>
            <h3>
              <a href={L(a.href)} data-track="cta_click" data-track-location="quick-actions">
                {a.title}
              </a>
            </h3>
            <p>{a.text}</p>
            <span class="quick-cta" aria-hidden="true">
              {a.cta} <Icon name="arrow-right" />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .quick {
    position: relative;
    z-index: 2;
    padding-top: 1.25rem;
  }

  .quick-grid {
    display: grid;
    gap: 0.75rem;
    list-style: none;
  }

  .quick-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      'icon title arrow'
      'icon text arrow';
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.2rem;
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    transition:
      border-color 160ms var(--ease),
      box-shadow 160ms var(--ease),
      transform 160ms var(--ease);
  }

  .quick-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .quick-icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    background: var(--brand-soft);
    color: var(--brand-ink);
  }

  .quick-card h3 {
    grid-area: title;
    margin: 0;
    font-size: 1.05rem;
  }

  .quick-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .quick-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .quick-card p {
    grid-area: text;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .quick-cta {
    grid-area: arrow;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--brand-ink);
  }

  @media (min-width: 48em) {
    .quick-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 80em) {
    .quick-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .quick-cta {
      display: none;
    }
  }
</style>
