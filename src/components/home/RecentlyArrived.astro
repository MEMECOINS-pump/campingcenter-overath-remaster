---
import VehicleCard from '@/components/vehicles/VehicleCard.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { recentlyArrivedVehicles, snapshotDate } from '@/lib/vehicles';
import { formatDateLocalized } from '@/lib/format';
import { getLangFromPath, localizedPath, t, type Locale } from '@/i18n';
import { url } from '@/lib/url';

interface Props {
  lang?: Locale;
}
const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const L = (path: string) => url(localizedPath(path, lang));
const { vehicles: arrived, showNewBadge } = recentlyArrivedVehicles(4);
---

{
  arrived.length > 0 && (
    <section class="section arrived" aria-labelledby="arrived-title">
      <div class="container">
        <div class="section-head-row">
          <SectionHeader
            id="arrived-title"
            eyebrow={t(lang, 'arrivedEyebrow')}
            title={t(lang, 'arrivedTitle')}
            lead={showNewBadge ? t(lang, 'arrivedLeadBadge') : t(lang, 'arrivedLead')}
          />
          <a class="btn btn-ghost" href={L('/wohnmobile/')}>
            {t(lang, 'arrivedCta')} <Icon name="arrow-right" class="arrow" />
          </a>
        </div>

        <div class="rail" data-rail>
          <ul class="rail-track" role="list">
            {arrived.map((v, i) => (
              <li class="rail-item">
                <VehicleCard vehicle={v} index={i} priority={i === 0} showNewInventoryBadge={showNewBadge} lang={lang} />
              </li>
            ))}
          </ul>
        </div>
        <p class="arrived-note">
          {t(lang, 'asOf')} {formatDateLocalized(snapshotDate, lang)} · {t(lang, 'featuredNote')}
        </p>
      </div>
    </section>
  )
}

<style>
  .arrived {
    background: var(--sand);
  }

  .rail {
    margin-inline: calc(var(--gutter) * -1);
  }

  .rail-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82%, 21rem);
    gap: 1rem;
    padding: 0.25rem var(--gutter) 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    list-style: none;
    scrollbar-width: thin;
  }

  .rail-item {
    display: flex;
    scroll-snap-align: start;
  }

  .rail-item > :global(*) {
    flex: 1;
  }

  .arrived-note {
    margin-top: 0.75rem;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  @media (min-width: 64em) {
    .rail {
      margin-inline: 0;
    }

    .rail-track {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
      padding: 0;
      overflow: visible;
    }
  }
</style>
