---
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import { ankauf } from '@/data/content';
import { url } from '@/lib/url';
---

<section class="section section-dark ankauf" aria-labelledby="ankauf-title">
  <div class="container split split-reverse">
    <div class="ankauf-media reveal">
      <Photo src="ankauf-owner" alt="Wohnmobilbesitzer übergibt sein Fahrzeug" sizes="(min-width: 60em) 40vw, 92vw" widths={[480, 768, 1080]} />
    </div>
    <div class="ankauf-copy">
      <p class="eyebrow">Wohnmobil verkaufen</p>
      <h2 id="ankauf-title">Dein Camper, fair bewertet.</h2>
      <p class="lead">
        Wir kaufen {ankauf.vehicleTypes.join(', ').replace(/, ([^,]*)$/, ' und $1')} an. {ankauf.promise}
      </p>
      <ol class="steps">
        {
          ankauf.process.map((s, i) => (
            <li>
              <span class="step-no">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="btn-row">
        <a class="btn btn-accent btn-lg" href={url('/wohnmobil-ankauf/')} data-track="cta_click" data-track-location="ankauf-teaser">
          Fahrzeug bewerten <Icon name="arrow-right" class="arrow" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ankauf-media {
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 5;
    max-height: 40rem;
  }

  .ankauf-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 15% 45%;
  }

  @media (max-width: 59.99em) {
    .ankauf-media {
      aspect-ratio: 16 / 10;
    }
  }

  .ankauf-copy {
    display: grid;
    gap: 1.1rem;
  }

  .ankauf-copy .lead {
    color: #cfd4d8;
  }

  .steps {
    display: grid;
    gap: 1.1rem;
    margin: 0.5rem 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .steps li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .step-no {
    font-family: var(--font-head);
    font-size: 1.5rem;
    line-height: 1;
    color: #f0b560;
  }

  .steps h3 {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .steps p {
    margin-top: 0.25rem;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
</style>
