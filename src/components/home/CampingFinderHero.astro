---
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import { url } from '@/lib/url';
---

<section class="cf-hero" aria-labelledby="cf-hero-title">
  <div class="cf-media" aria-hidden="true">
    <Photo src="lake-motorhomes" alt="" sizes="100vw" widths={[960, 1440, 1920]} quality={68} />
  </div>
  <div class="cf-shade" aria-hidden="true"></div>
  <div class="container cf-inner">
    <p class="eyebrow">Camping Finder</p>
    <h2 id="cf-hero-title" class="display">Dein Camper. Dein Leben. Dein Match.</h2>
    <p class="lead">
      Sag uns, wie du reisen möchtest – wir zeigen dir Fahrzeuge, die wirklich zu deinen Anforderungen passen. Inklusive Sitzplätze, Schlafplätze, Bettlänge und Fahrzeuglänge.
    </p>
    <div class="btn-row">
      <a class="btn btn-accent btn-lg" href={url('/camper-finder/')} data-track="camping_finder_start" data-track-location="home">
        Camper finden <Icon name="arrow-right" class="arrow" />
      </a>
      <a class="btn btn-glass btn-lg" href={url('/wohnmobile/')}>Bestand ansehen</a>
    </div>
    <ul class="cf-points" role="list">
      <li>Persönliche Empfehlung statt Marken-Ratespiel</li>
      <li>Bettlänge & Fahrzeuglänge als echte Filter</li>
      <li>Danach Beratung mit deinen Antworten</li>
    </ul>
  </div>
</section>

<style>
  .cf-hero {
    position: relative;
    isolation: isolate;
    color: #fff;
    overflow: hidden;
  }

  .cf-media,
  .cf-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cf-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cf-shade {
    background:
      linear-gradient(120deg, rgb(14 12 10 / 0.88) 10%, rgb(14 12 10 / 0.45) 55%, rgb(14 12 10 / 0.7)),
      linear-gradient(to top, rgb(14 12 10 / 0.55), transparent 50%);
  }

  .cf-inner {
    padding-block: clamp(3.5rem, 2.5rem + 5vw, 6.5rem);
    max-width: 46rem;
  }

  .cf-hero .eyebrow {
    color: #ffd9a3;
  }

  .cf-hero .display {
    margin: 0.6rem 0 0.9rem;
    color: #fff;
    font-size: clamp(2.2rem, 1.6rem + 2.8vw, 3.6rem);
    line-height: 1.05;
  }

  .cf-hero .lead {
    color: rgb(255 255 255 / 0.9);
    max-width: 36rem;
  }

  .cf-points {
    display: grid;
    gap: 0.45rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
    color: rgb(255 255 255 / 0.86);
  }

  .cf-points li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .cf-points li::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    margin-top: 0.45rem;
    border-radius: 50%;
    background: var(--brand);
    flex: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cf-inner {
      animation: cf-rise 700ms var(--ease) both;
    }
  }

  @keyframes cf-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
