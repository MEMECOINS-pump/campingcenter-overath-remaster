---
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import { getLangFromPath, localizedPath, t, type Locale } from '@/i18n';
import { url } from '@/lib/url';

interface Props {
  lang?: Locale;
}
const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const L = (path: string) => url(localizedPath(path, lang));
---

<section class="cf-hero" aria-labelledby="cf-hero-title">
  <div class="cf-media" aria-hidden="true">
    <Photo src="lake-motorhomes" alt="" sizes="100vw" widths={[960, 1440, 1920]} quality={68} />
  </div>
  <div class="cf-shade" aria-hidden="true"></div>
  <div class="container cf-inner">
    <p class="eyebrow">Camping Finder</p>
    <h2 id="cf-hero-title" class="display">{t(lang, 'finderHeroTitle')}</h2>
    <p class="lead">{t(lang, 'finderHeroLead')}</p>
    <div class="btn-row">
      <a class="btn btn-accent btn-lg" href={L('/camper-finder/')} data-track="camping_finder_start" data-track-location="home">
        {t(lang, 'finderHeroCta')} <Icon name="arrow-right" class="arrow" />
      </a>
      <a class="btn btn-glass btn-lg" href={L('/wohnmobile/')}>{t(lang, 'finderHeroStock')}</a>
    </div>
    <ul class="cf-points" role="list">
      <li>{t(lang, 'finderHeroP1')}</li>
      <li>{t(lang, 'finderHeroP2')}</li>
      <li>{t(lang, 'finderHeroP3')}</li>
    </ul>
  </div>
</section>

<style>
  .cf-hero {
    position: relative;
    isolation: isolate;
    color: #fff;
    overflow: hidden;
  }

  .cf-media,
  .cf-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cf-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cf-shade {
    background: linear-gradient(105deg, rgb(14 12 10 / 0.82) 0%, rgb(14 12 10 / 0.45) 55%, rgb(14 12 10 / 0.35) 100%);
  }

  .cf-inner {
    padding-block: clamp(3.5rem, 2.5rem + 5vw, 6rem);
    max-width: 40rem;
  }

  .cf-inner .eyebrow {
    color: #ffd9a3;
  }

  .cf-inner .lead {
    color: rgb(255 255 255 / 0.9);
  }

  .cf-points {
    display: grid;
    gap: 0.45rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    font-weight: 650;
  }

  .cf-points li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .cf-points li::before {
    content: '';
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    margin-top: 0.55rem;
    border-radius: 50%;
    background: #ffd9a3;
  }
</style>
