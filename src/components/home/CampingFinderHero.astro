---
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import { url } from '@/lib/url';
---

<section class="cf-hero" data-header-theme="dark" aria-labelledby="cf-hero-title">
  <div class="cf-media" aria-hidden="true">
    <Photo src="atmo-shore" alt="" sizes="100vw" widths={[640, 960, 1280, 1920, 2560, 3200, 3840]} quality={85} />
  </div>
  <div class="cf-shade" aria-hidden="true"></div>
  <div class="container cf-inner">
    <p class="eyebrow">Camper-Finder</p>
    <h2 id="cf-hero-title" class="display">Dein Camper. Dein Leben. Dein Match.</h2>
    <p class="lead">
      Sag uns, wie du reisen möchtest – wir zeigen dir Fahrzeuge, die wirklich zu deinen Anforderungen passen. Inklusive Sitzplätze, Schlafplätze, Bettlänge und Fahrzeuglänge.
    </p>
    <div class="btn-row">
      <a class="btn btn-accent btn-lg" href={url('/camper-finder/')} data-track="camping_finder_start" data-track-location="home">
        Camper finden <Icon name="arrow-right" class="arrow" />
      </a>
      <a class="btn btn-light btn-lg" href={url('/wohnmobile/')}>Bestand ansehen</a>
    </div>
    <ul class="cf-points" role="list">
      <li>Persönliche Empfehlung statt Marken-Ratespiel</li>
      <li>Bettlänge & Fahrzeuglänge als echte Filter</li>
      <li>Danach Beratung mit deinen Antworten</li>
    </ul>
  </div>
</section>

<style>
  .cf-hero {
    position: relative;
    isolation: isolate;
    color: #fff;
    overflow: hidden;
    background: #141210;
  }

  .cf-media,
  .cf-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cf-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 64% 72%;
    filter: sepia(0.16) saturate(0.86) contrast(1.05) brightness(0.88);
  }

  .cf-shade {
    background:
      linear-gradient(180deg, #141210 0, rgb(20 18 16 / 0.2) 3rem, rgb(20 18 16 / 0.2) calc(100% - 3.5rem), #141210 100%),
      linear-gradient(90deg, rgb(12 10 8 / 0.62), rgb(12 10 8 / 0.16) 62%);
  }

  .cf-inner {
    padding-block: clamp(3.5rem, 2.5rem + 5vw, 6.5rem);
    max-width: 46rem;
  }

  .cf-hero .eyebrow {
    color: #ffd9a3;
  }

  .cf-hero .display {
    margin: 0.6rem 0 0.9rem;
    color: #fff;
    font-size: clamp(2.2rem, 1.6rem + 2.8vw, 3.6rem);
    line-height: 1.05;
  }

  .cf-hero .lead {
    color: rgb(255 255 255 / 0.9);
    max-width: 36rem;
  }

  .cf-points {
    display: grid;
    gap: 0.45rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
    color: rgb(255 255 255 / 0.86);
  }

  .cf-points li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .cf-points li::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    margin-top: 0.45rem;
    border-radius: 50%;
    background: var(--brand);
    flex: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cf-inner {
      animation: cf-rise 700ms var(--ease) both;
    }
  }

  @keyframes cf-rise {
    from {
      transform: translateY(12px);
    }
    to {
      transform: none;
    }
  }
</style>
