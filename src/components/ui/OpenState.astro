---
/** Compact badge – status only client-side (Europe/Berlin + NRW-Feiertage). */
---

<span class="open-state" data-open-state data-state="pending" data-reason="hours">Öffnungszeiten</span>

<style>
  .open-state {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: 750;
    background: var(--sand);
    color: var(--text-muted);
  }

  .open-state::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  .open-state[data-state='open'] {
    background: var(--success-soft);
    color: var(--success);
  }

  .open-state[data-state='closed'] {
    background: #fdecea;
    color: #7a1f14;
  }

  .open-state[data-reason='holiday'] {
    background: #ffedd5;
    color: #7c2d12;
    border: 1px solid #ea580c;
  }
</style>
