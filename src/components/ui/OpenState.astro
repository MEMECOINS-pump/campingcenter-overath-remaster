---
/** Compact badge – status only client-side (Europe/Berlin + NRW-Feiertage). */
---

<span class="open-state" data-open-state data-state="pending" data-reason="hours">Öffnungszeiten</span>

<style>
  .open-state {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: 750;
    background: var(--sand);
    color: var(--text-muted);
  }

  .open-state::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  .open-state[data-state='pending'] {
    opacity: 0.75;
  }

  .open-state[data-state='open'] {
    background: var(--success-soft);
    color: var(--success);
  }

  .open-state[data-state='closed'] {
    background: #fdecea;
    color: #7a1f14;
  }

  .open-state[data-reason='holiday'] {
    background: #ffedd5;
    color: #7c2d12;
    border: 1px solid #ea580c;
  }
</style>

<script>
  import { computeOpenStatus } from '@/lib/opening-hours';

  function tick() {
    document.querySelectorAll<HTMLElement>('[data-open-state]').forEach((el) => {
      const status = computeOpenStatus();
      el.dataset.state = status.state;
      el.dataset.reason = status.reason;
      el.textContent =
        status.state === 'open' ? `Jetzt geöffnet · bis ${status.closesAt} Uhr` : status.shortLabel === 'Geschlossen' ? 'Aktuell geschlossen' : status.shortLabel;
      if (status.reason === 'holiday') el.textContent = `Feiertag · Geschlossen`;
      else if (status.state === 'open') el.textContent = `Jetzt geöffnet`;
      else el.textContent = 'Aktuell geschlossen';
    });
  }

  tick();
  window.setInterval(tick, 30_000);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') tick();
  });
</script>
