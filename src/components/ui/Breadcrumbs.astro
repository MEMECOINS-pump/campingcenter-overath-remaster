---
import Icon from '@/components/ui/Icon.astro';
import { url } from '@/lib/url';

export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
  tone?: 'dark' | 'light';
}
const { items, tone = 'dark' } = Astro.props;
const all: Crumb[] = [{ label: 'Start', href: '/' }, ...items];
---

<nav class:list={['crumbs', `crumbs-${tone}`]} aria-label="Brotkrumen">
  {/* ul (not ol): even with zero CSS, browsers never paint "1. 2." markers after VT/CSP style drops */}
  <ul role="list">
    {
      all.map((c, i) => (
        <li>
          {i > 0 && <Icon name="chevron-right" class="crumb-sep" />}
          {c.href && i < all.length - 1 ? <a href={url(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        </li>
      ))
    }
  </ul>
</nav>