---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import VehicleCard from '@/components/vehicles/VehicleCard.astro';
import { vehicles } from '@/lib/vehicles';
import { breadcrumbSchema } from '@/lib/schema';
import { url } from '@/lib/url';
import { getLangFromPath, localizedPath, t, type Locale } from '@/i18n';

interface Props {
  lang?: Locale;
}
const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const L = (path: string) => url(localizedPath(path, lang));
const crumbs = [{ label: t(lang, 'wishlistEyebrow'), href: '/merkliste/' }];
---

<BaseLayout
  lang={lang}
  compareTray
  title={t(lang, 'wishlistTitle')}
  description={t(lang, 'wishlistDesc')}
  path="/merkliste/"
  noindex
  jsonLd={[breadcrumbSchema(crumbs, Astro.site)]}
>
  <section class="page-hero section-paper">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">{t(lang, 'wishlistEyebrow')}</p>
      <h1>{t(lang, 'wishlistH1')}</h1>
      <p class="lead">{t(lang, 'wishlistLead')}</p>
    </div>
  </section>

  <section class="section-tight" aria-label={t(lang, 'wishlistAria')} data-favlist data-lang={lang}>
    <div class="container">
      <div class="fl-toolbar" data-fl-toolbar hidden>
        <p class="fl-count" role="status" aria-live="polite">
          <strong data-fl-count>0</strong>
          <span data-fl-noun>{t(lang, 'wishlistNoun')}</span>
          {t(lang, 'wishlistSaved')}
        </p>
        <div class="btn-row">
          <a
            class="btn btn-accent"
            href={L('/kontakt/') + '#formular'}
            data-fl-inquiry
            data-track="cta_click"
            data-track-location="favorites_inquiry"
          >
            <Icon name="mail" /> {t(lang, 'wishlistInquireAll')}
          </a>
          <button type="button" class="btn btn-ghost" data-fl-compare={L('/vergleich/')}>
            <Icon name="compare" /> {t(lang, 'wishlistCompare')}
          </button>
          <button type="button" class="btn btn-ghost" data-fl-clear>
            <Icon name="trash" /> {t(lang, 'wishlistClear')}
          </button>
        </div>
      </div>

      <ul class="fl-grid" role="list" data-fl-grid>
        {
          vehicles.map((v, i) => (
            <li data-fl-item={v.id} data-title={v.title} hidden>
              <VehicleCard vehicle={v} index={i} headingLevel={2} lang={lang} />
            </li>
          ))
        }
      </ul>

      <div class="fl-empty card card-pad" data-fl-empty>
        <span class="fl-empty-icon"><Icon name="heart" /></span>
        <h2>{t(lang, 'wishlistEmptyTitle')}</h2>
        <p class="muted">{t(lang, 'wishlistEmptyText')}</p>
        <div class="btn-row">
          <a class="btn" href={L('/wohnmobile/')}>
            {t(lang, 'wishlistBrowse')} <Icon name="arrow-right" class="arrow" />
          </a>
          <a class="btn btn-ghost" href={L('/camper-finder/')}>{t(lang, 'wishlistFinder')}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { clearCollection, COMPARE_MAX, onCollectionChange, readCollection, toggleItem } from '@/lib/collections';
  import { toast } from '@/scripts/site';

  const grid = document.querySelector<HTMLElement>('[data-fl-grid]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-fl-item]'));
  const empty = document.querySelector<HTMLElement>('[data-fl-empty]');
  const toolbar = document.querySelector<HTMLElement>('[data-fl-toolbar]');
  const count = document.querySelector('[data-fl-count]');
  const noun = document.querySelector('[data-fl-noun]');
  const inquiry = document.querySelector<HTMLAnchorElement>('[data-fl-inquiry]');
  const inquiryBase = inquiry?.getAttribute('href') ?? '';

  function render(): void {
    const ids = readCollection('favorites');
    const byId = new Map(items.map((el) => [el.dataset.flItem, el]));
    const shown = ids.map((id) => byId.get(id)).filter((el): el is HTMLElement => Boolean(el));
    items.forEach((el) => (el.hidden = !shown.includes(el)));
    shown.forEach((el) => grid?.append(el));
    if (empty) empty.hidden = shown.length > 0;
    if (toolbar) toolbar.hidden = shown.length === 0;
    if (count) count.textContent = String(shown.length);
    const pageLang = document.querySelector('[data-favlist]')?.getAttribute('data-lang') === 'en' ? 'en' : 'de';
    if (noun) {
      noun.textContent =
        pageLang === 'en'
          ? shown.length === 1
            ? 'vehicle'
            : 'vehicles'
          : shown.length === 1
            ? 'Fahrzeug'
            : 'Fahrzeuge';
    }
    if (inquiry) {
      const titles = shown.map((el) => el.dataset.title).join('; ');
      const [path, hash] = inquiryBase.split('#');
      inquiry.href = `${path}?fahrzeug=${encodeURIComponent(titles.slice(0, 480))}#${hash}`;
    }
  }

  document.querySelector('[data-fl-clear]')?.addEventListener('click', () => {
    clearCollection('favorites');
    const en = document.querySelector('[data-favlist]')?.getAttribute('data-lang') === 'en';
    toast(en ? 'Wishlist cleared' : 'Merkliste geleert');
  });

  const compareBtn = document.querySelector<HTMLButtonElement>('[data-fl-compare]');
  compareBtn?.addEventListener('click', () => {
    const favs = readCollection('favorites').slice(0, COMPARE_MAX);
    clearCollection('compare');
    favs.forEach((id) => toggleItem('compare', id));
    location.href = compareBtn.dataset.flCompare ?? '/';
  });

  onCollectionChange(render);
  render();
</script>

<style>
  .fl-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .fl-toolbar[hidden],
  .fl-empty[hidden] {
    display: none;
  }

  .fl-grid {
    display: grid;
    gap: 1.25rem;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }

  .fl-grid > li {
    display: grid;
  }

  .fl-grid > li[hidden] {
    display: none;
  }

  .fl-empty {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding-block: 3rem;
    text-align: center;
  }

  .fl-empty h2 {
    font-size: 1.5rem;
  }

  .fl-empty .btn-row {
    justify-content: center;
  }

  .fl-empty-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--sand);
  }
</style>
