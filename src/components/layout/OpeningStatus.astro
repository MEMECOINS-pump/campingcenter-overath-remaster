---
import Icon from '@/components/ui/Icon.astro';
import { company, openingHours, formatHours } from '@/data/company';
import { computeOpenStatus } from '@/lib/opening-hours';
import { url } from '@/lib/url';

/** SSR seed – client refreshes with Europe/Berlin + Feiertage. */
const initial = computeOpenStatus();
const holidayName = initial.holiday?.name ?? '';
const nextOpen = initial.state === 'closed' ? initial.opensNext : null;
---

<div class="oh" data-opening-status data-state={initial.state} data-reason={initial.reason}>
  <button
    type="button"
    class="oh-pill"
    data-oh-open
    aria-expanded="false"
    aria-controls="oh-sheet"
    data-state={initial.state}
    data-reason={initial.reason}
  >
    <span class="oh-dot" aria-hidden="true"></span>
    <span class="oh-text">
      <span class="oh-short" data-oh-short>{initial.shortLabel}</span>
      <span class="oh-long" data-oh-long>{initial.label}</span>
      <span class="oh-holiday" data-oh-holiday-chip hidden={!holidayName}>
        <span data-oh-holiday-name>{holidayName}</span>
      </span>
    </span>
  </button>

  <dialog class="oh-sheet" id="oh-sheet" data-oh-sheet>
    <div class="oh-sheet-inner">
      <header class="oh-sheet-head">
        <p class="eyebrow">Öffnungszeiten</p>
        <button type="button" class="oh-close" data-oh-close aria-label="Schließen"><Icon name="close" /></button>
      </header>

      <div class="oh-banner" data-oh-banner data-state={initial.state} data-reason={initial.reason}>
        <p class="oh-banner-title" data-oh-banner-title>
          {initial.state === 'open' ? 'Jetzt geöffnet' : 'Jetzt geschlossen'}
        </p>
        <p class="oh-banner-detail" data-oh-today>{initial.todayLabel}</p>
        <p class="oh-banner-next" data-oh-next hidden={!nextOpen}>
          {nextOpen ?? ''}
        </p>
      </div>

      <ul class="oh-week">
        {
          openingHours.map((p) => (
            <li>
              <strong>{p.days}</strong>
              <span>{formatHours(p)}</span>
            </li>
          ))
        }
      </ul>
      <p class="oh-sun">Sonntags und an gesetzlichen Feiertagen (NRW) geschlossen.</p>
      <div class="btn-row">
        <a class="btn btn-accent btn-sm" href={company.phone.href}>Anrufen</a>
        <a class="btn btn-ghost btn-sm" href={company.directions} target="_blank" rel="noopener">
          Route <span class="sr-only">(öffnet in neuem Tab)</span>
        </a>
        <a class="btn btn-ghost btn-sm" href={url('/kontakt/')}>Kontakt</a>
      </div>
    </div>
  </dialog>
</div>

<style>
  .oh {
    position: relative;
  }

  .oh-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 36px;
    max-width: min(100%, 28rem);
    padding: 0.25rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.85);
    color: var(--text);
    font: inherit;
    font-size: var(--fs-xs);
    font-weight: 700;
    cursor: pointer;
    text-align: left;
  }

  .oh-text {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    min-width: 0;
  }

  .site-header[data-overlay]:not(.is-solid) .oh-pill {
    border-color: rgb(255 255 255 / 0.28);
    background: rgb(14 12 10 / 0.35);
    color: #fff;
  }

  .oh-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--text-muted);
    flex: none;
  }

  .oh-pill[data-state='open'] .oh-dot {
    background: var(--success);
    box-shadow: 0 0 0 3px rgb(from var(--success) r g b / 0.22);
  }

  .oh-pill[data-state='closed'] {
    border-color: #c45c4a;
    background: #fdecea;
    color: #7a1f14;
  }

  .oh-pill[data-state='closed'] .oh-dot {
    background: #d64535;
    box-shadow: 0 0 0 3px rgb(214 69 53 / 0.2);
  }

  .oh-pill[data-reason='holiday'] {
    border-color: #b45309;
    background: #fff7ed;
    color: #7c2d12;
  }

  .oh-pill[data-reason='holiday'] .oh-dot {
    background: #ea580c;
  }

  .site-header[data-overlay]:not(.is-solid) .oh-pill[data-state='closed'],
  .site-header[data-overlay]:not(.is-solid) .oh-pill[data-reason='holiday'] {
    border-color: rgb(255 255 255 / 0.45);
    background: rgb(180 40 30 / 0.55);
    color: #fff;
  }

  .oh-long {
    display: none;
  }

  .oh-holiday {
    display: inline-flex;
    align-items: center;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-pill);
    background: rgb(234 88 12 / 0.18);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .oh-holiday[hidden] {
    display: none;
  }

  @media (min-width: 48em) {
    .oh-short {
      display: none;
    }
    .oh-long {
      display: inline;
    }
  }

  .oh-sheet {
    width: min(100% - 1.5rem, 24rem);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--text);
    box-shadow: var(--shadow-lg);
  }

  .oh-sheet::backdrop {
    background: rgb(14 12 10 / 0.45);
  }

  .oh-sheet-inner {
    padding: 1.25rem 1.35rem 1.5rem;
  }

  .oh-sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .oh-close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--sand);
    cursor: pointer;
  }

  .oh-banner {
    margin: 0.85rem 0 1.15rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius);
    background: var(--sand);
  }

  .oh-banner[data-state='open'] {
    background: var(--success-soft);
  }

  .oh-banner[data-state='closed'] {
    background: #fdecea;
    color: #7a1f14;
  }

  .oh-banner[data-reason='holiday'] {
    background: #fff7ed;
    color: #7c2d12;
  }

  .oh-banner-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 800;
  }

  .oh-banner-detail,
  .oh-banner-next {
    margin: 0.35rem 0 0;
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .oh-banner-next[hidden] {
    display: none;
  }

  .oh-week {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .oh-week li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--fs-sm);
  }

  .oh-sun {
    margin: 0.85rem 0 1.25rem;
    font-size: var(--fs-sm);
    font-weight: 650;
  }
</style>

<script>
  import { computeOpenStatus, type OpenStatus } from '@/lib/opening-hours';

  function apply(root: HTMLElement, status: OpenStatus) {
    root.dataset.state = status.state;
    root.dataset.reason = status.reason;

    root.querySelectorAll<HTMLElement>('[data-oh-short]').forEach((el) => {
      el.textContent = status.shortLabel;
    });
    root.querySelectorAll<HTMLElement>('[data-oh-long]').forEach((el) => {
      el.textContent = status.label;
    });
    root.querySelectorAll<HTMLElement>('[data-oh-today]').forEach((el) => {
      el.textContent = status.todayLabel;
    });
    root.querySelectorAll<HTMLButtonElement>('[data-oh-open]').forEach((btn) => {
      btn.dataset.state = status.state;
      btn.dataset.reason = status.reason;
    });
    root.querySelectorAll<HTMLElement>('[data-oh-banner]').forEach((el) => {
      el.dataset.state = status.state;
      el.dataset.reason = status.reason;
    });
    root.querySelectorAll<HTMLElement>('[data-oh-banner-title]').forEach((el) => {
      el.textContent = status.state === 'open' ? 'Jetzt geöffnet' : 'Jetzt geschlossen';
    });

    const holidayName = status.holiday?.name ?? '';
    root.querySelectorAll<HTMLElement>('[data-oh-holiday-chip]').forEach((el) => {
      el.hidden = !holidayName;
    });
    root.querySelectorAll<HTMLElement>('[data-oh-holiday-name]').forEach((el) => {
      el.textContent = holidayName;
    });

    const next = status.state === 'closed' ? status.opensNext : null;
    root.querySelectorAll<HTMLElement>('[data-oh-next]').forEach((el) => {
      el.hidden = !next;
      el.textContent = next ?? '';
    });
  }

  function tick() {
    document.querySelectorAll<HTMLElement>('[data-opening-status]').forEach((root) => apply(root, computeOpenStatus()));
  }

  document.querySelectorAll<HTMLElement>('[data-opening-status]').forEach((root) => {
    apply(root, computeOpenStatus());
    const sheet = root.querySelector<HTMLDialogElement>('[data-oh-sheet]');
    root.querySelector('[data-oh-open]')?.addEventListener('click', () => sheet?.showModal());
    root.querySelector('[data-oh-close]')?.addEventListener('click', () => sheet?.close());
    sheet?.addEventListener('click', (e) => {
      if (e.target === sheet) sheet.close();
    });
  });

  // Nach Mitternacht / Feiertagswechsel ohne Reload aktualisieren
  window.setInterval(tick, 30_000);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') tick();
  });
</script>
