---
import Icon from '@/components/ui/Icon.astro';
import { company, openingHours, formatHours } from '@/data/company';
import { getLangFromPath, t, type Locale } from '@/i18n';
import { url } from '@/lib/url';

/**
 * Kein Build-Zeit-Status: GitHub Pages liefert sonst den Feiertag vom Deploy-Tag
 * (z. B. „Tag der Deutschen Einheit“) bei jedem Reload kurz mit aus.
 * Status kommt ausschließlich clientseitig (Europe/Berlin).
 */
interface Props {
  lang?: Locale;
}
const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const dayLabels =
  lang === 'en'
    ? openingHours.map((p) => ({
        ...p,
        days: p.schemaDays.includes('Saturday') ? 'Saturday' : 'Monday to Friday',
      }))
    : openingHours;
---

<div
  class="oh"
  data-opening-status
  data-state="pending"
  data-reason="hours"
  data-lang={lang}
  data-i18n-holiday-sub={lang === 'en' ? 'Public holiday (NRW)' : 'Gesetzlicher Feiertag (NRW)'}
  data-i18n-banner-holiday={lang === 'en' ? 'Public holiday today – closed' : 'Heute Feiertag – geschlossen'}
  data-i18n-banner-open={t(lang, 'companionOpenNow')}
  data-i18n-banner-closed={lang === 'en' ? 'Closed now' : 'Jetzt geschlossen'}
  data-i18n-alert-kicker={lang === 'en' ? 'Public holiday today' : 'Heute Feiertag'}
  data-i18n-alert-closed={lang === 'en' ? '— we are closed' : '— wir haben geschlossen'}
  data-i18n-companion-holiday={t(lang, 'companionHolidayClosed')}
  data-i18n-companion-open={t(lang, 'companionOpenNow')}
  data-i18n-companion-closed={t(lang, 'companionClosedNow')}
>
  <!-- Immer hidden im HTML – JS zeigt nur an echten Feiertagen -->
  <div class="oh-alert" data-oh-alert hidden role="status">
    <span class="oh-alert-kicker" data-oh-alert-kicker>{lang === 'en' ? 'Public holiday today' : 'Heute Feiertag'}</span>
    <strong class="oh-alert-name" data-oh-alert-name></strong>
    <span class="oh-alert-closed" data-oh-alert-closed>{lang === 'en' ? '— we are closed' : '— wir haben geschlossen'}</span>
  </div>

  <div class="header-shell">
    <slot name="leading" />
    <div class="header-gap">
      <button
        type="button"
        class="oh-pill"
        data-oh-open
        aria-expanded="false"
        aria-controls="oh-sheet"
        data-state="pending"
        data-reason="hours"
      >
        <span class="oh-dot" aria-hidden="true"></span>
        <span class="oh-copy">
          <span class="oh-line" data-oh-line>{t(lang, 'openingHours')}</span>
          <span class="oh-sub" data-oh-sub hidden></span>
        </span>
      </button>
    </div>
    <slot name="trailing" />
  </div>

  <dialog class="oh-sheet" id="oh-sheet" data-oh-sheet>
    <div class="oh-sheet-inner">
      <header class="oh-sheet-head">
        <p class="eyebrow">{t(lang, 'openingHours')}</p>
        <button type="button" class="oh-close" data-oh-close aria-label={t(lang, 'companionClose')}><Icon name="close" /></button>
      </header>
      <div class="oh-banner" data-oh-banner data-state="pending" data-reason="hours">
        <p class="oh-banner-title" data-oh-banner-title>{t(lang, 'openingHours')}</p>
        <p class="oh-banner-detail" data-oh-today></p>
        <p class="oh-banner-next" data-oh-next hidden></p>
      </div>
      <ul class="oh-week">
        {
          dayLabels.map((p) => (
            <li>
              <strong>{p.days}</strong>
              <span>{lang === 'en' ? p.hours.map((h) => `${h.opens}–${h.closes}`).join(' and ') : formatHours(p)}</span>
            </li>
          ))
        }
        <li>
          <strong>{lang === 'en' ? 'Sunday & public holidays' : 'Sonntag & Feiertage'}</strong>
          <span>{lang === 'en' ? 'closed' : 'geschlossen'}</span>
        </li>
      </ul>
      <p class="oh-sun">{t(lang, 'closedSundayHoliday')}</p>
      <div class="btn-row">
        <a class="btn btn-accent btn-sm" href={company.phone.href}>{t(lang, 'companionCallNow')}</a>
        <a class="btn btn-ghost btn-sm" href={company.directions} target="_blank" rel="noopener">
          {lang === 'en' ? 'Directions' : 'Route'} <span class="sr-only">({lang === 'en' ? 'opens in new tab' : 'öffnet in neuem Tab'})</span>
        </a>
        <a class="btn btn-ghost btn-sm" href={url(lang === 'en' ? '/en/kontakt/' : '/kontakt/')}>{t(lang, 'contact')}</a>
      </div>
    </div>
  </dialog>
</div>

<style>
  .oh {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* Mobile: logo row + compact status under it. Desktop: one row, pill in the gap. */
  .header-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'leading trailing'
      'gap gap';
    grid-template-rows: var(--header-h) var(--header-utility-h);
    align-items: center;
    column-gap: 0.75rem;
    width: min(100% - 2 * var(--gutter), 90rem);
    margin-inline: auto;
  }

  .header-gap {
    grid-area: gap;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
    height: 100%;
  }

  @media (min-width: 90em) {
    .header-shell {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: 'leading gap trailing';
      grid-template-rows: var(--header-h);
      column-gap: 0.65rem;
    }

    .header-gap {
      justify-content: center;
      padding-inline: 0.35rem;
    }
  }

  .oh-alert {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem 0.55rem;
    padding: 0.35rem 0.85rem;
    background: #c2410c;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 750;
    text-align: center;
    letter-spacing: 0.01em;
  }

  .oh-alert[hidden] {
    display: none !important;
  }

  .oh-alert-kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    font-weight: 800;
    opacity: 0.95;
  }

  .oh-alert-name {
    font-size: 1rem;
    font-weight: 800;
  }

  .oh-alert-closed {
    font-weight: 700;
  }

  .oh-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    max-width: 100%;
    min-height: 2.25rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.92);
    color: var(--text);
    font: inherit;
    font-size: var(--fs-xs);
    font-weight: 700;
    cursor: pointer;
    text-align: left;
  }

  @media (min-width: 90em) {
    .oh-pill {
      align-items: flex-start;
      gap: 0.45rem;
      min-height: 0;
      padding: 0.35rem 0.7rem;
    }
  }

  .oh-copy {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    min-width: 0;
  }

  .oh-line,
  .oh-sub {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.25;
  }

  .oh-sub {
    font-size: 0.75rem;
    font-weight: 650;
    opacity: 0.85;
  }

  .oh-sub:not([hidden])::before {
    content: '· ';
  }

  @media (min-width: 90em) {
    .oh-copy {
      display: grid;
      gap: 0.02rem;
    }

    .oh-sub:not([hidden])::before {
      content: none;
    }
  }

  .oh-sub[hidden] {
    display: none;
  }

  .oh-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--text-muted);
    flex: none;
  }

  @media (min-width: 90em) {
    .oh-dot {
      margin-top: 0.22rem;
    }
  }

  .oh-pill[data-state='open'] .oh-dot {
    background: var(--success);
    box-shadow: 0 0 0 3px rgb(from var(--success) r g b / 0.22);
  }

  .oh-pill[data-state='closed'] {
    border-color: #b91c1c;
    background: #fef2f2;
    color: #7f1d1d;
  }

  .oh-pill[data-state='closed'] .oh-dot {
    background: #dc2626;
  }

  .oh-pill[data-reason='holiday'] {
    border-color: #9a3412;
    background: #ffedd5;
    color: #7c2d12;
  }

  .oh-pill[data-reason='holiday'] .oh-dot {
    background: #ea580c;
  }

  .site-header[data-overlay]:not(.is-solid) .oh-pill {
    border-color: rgb(255 255 255 / 0.35);
    background: rgb(14 12 10 / 0.45);
    color: #fff;
  }

  .site-header[data-overlay]:not(.is-solid) .oh-pill[data-state='closed'],
  .site-header[data-overlay]:not(.is-solid) .oh-pill[data-reason='holiday'] {
    border-color: #fdba74;
    background: rgb(154 52 18 / 0.85);
    color: #fff;
  }

  .oh-sheet {
    width: min(100% - 1.5rem, 24rem);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--text);
    box-shadow: var(--shadow-lg);
  }

  .oh-sheet::backdrop {
    background: rgb(14 12 10 / 0.45);
  }

  .oh-sheet-inner {
    padding: 1.25rem 1.35rem 1.5rem;
  }

  .oh-sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .oh-close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--sand);
    cursor: pointer;
  }

  .oh-banner {
    margin: 0.85rem 0 1.15rem;
    padding: 0.95rem 1rem;
    border-radius: var(--radius);
    background: var(--sand);
  }

  .oh-banner[data-state='open'] {
    background: var(--success-soft);
  }

  .oh-banner[data-state='closed'] {
    background: #fef2f2;
    color: #7f1d1d;
  }

  .oh-banner[data-reason='holiday'] {
    background: #ffedd5;
    color: #7c2d12;
  }

  .oh-banner-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 800;
  }

  .oh-banner-detail,
  .oh-banner-next {
    margin: 0.4rem 0 0;
    font-size: var(--fs-sm);
    font-weight: 650;
  }

  .oh-banner-next[hidden] {
    display: none;
  }

  .oh-week {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .oh-week li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--fs-sm);
  }

  .oh-sun {
    margin: 0.85rem 0 1.25rem;
    font-size: var(--fs-sm);
    font-weight: 650;
  }
</style>

<!-- Opening status + sheet: bound in src/scripts/site.ts (boot + astro:page-load) -->


