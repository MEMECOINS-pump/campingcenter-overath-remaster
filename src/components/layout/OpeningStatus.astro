---
import Icon from '@/components/ui/Icon.astro';
import { company, openingHours, formatHours } from '@/data/company';
import { computeOpenStatus } from '@/lib/opening-hours';
import { url } from '@/lib/url';

const initial = computeOpenStatus();
const holidayName = initial.holiday?.name ?? '';
const nextOpen = initial.state === 'closed' ? initial.opensNext : null;
const isHoliday = initial.reason === 'holiday';
---

<div
  class="oh"
  data-opening-status
  data-state={initial.state}
  data-reason={initial.reason}
>
  <!-- Volle Breite – bewusst plakativ, auch auf dem Handy sofort lesbar -->
  <div class="oh-alert" data-oh-alert hidden={!isHoliday} role="status">
    <span class="oh-alert-kicker">Heute Feiertag</span>
    <strong class="oh-alert-name" data-oh-alert-name>{holidayName || '—'}</strong>
    <span class="oh-alert-closed">— wir haben geschlossen</span>
  </div>

  <div class="container oh-row">
    <button
      type="button"
      class="oh-pill"
      data-oh-open
      aria-expanded="false"
      aria-controls="oh-sheet"
      data-state={initial.state}
      data-reason={initial.reason}
    >
      <span class="oh-dot" aria-hidden="true"></span>
      <span class="oh-copy">
        <span class="oh-line" data-oh-line>{initial.label}</span>
        <span class="oh-sub" data-oh-sub hidden={!isHoliday && !nextOpen}>
          {isHoliday ? `Gesetzlicher Feiertag (NRW)${nextOpen ? ` · ${nextOpen}` : ''}` : nextOpen}
        </span>
      </span>
    </button>

    <a class="util-link" href={company.phone.href} data-track="call_click" data-track-location="header-utility">
      {company.phone.display}
    </a>
    <a class="util-link util-route" href={company.directions} target="_blank" rel="noopener">
      Route <span class="sr-only">(öffnet in neuem Tab)</span>
    </a>
  </div>

  <dialog class="oh-sheet" id="oh-sheet" data-oh-sheet>
    <div class="oh-sheet-inner">
      <header class="oh-sheet-head">
        <p class="eyebrow">Öffnungszeiten</p>
        <button type="button" class="oh-close" data-oh-close aria-label="Schließen"><Icon name="close" /></button>
      </header>

      <div class="oh-banner" data-oh-banner data-state={initial.state} data-reason={initial.reason}>
        <p class="oh-banner-title" data-oh-banner-title>
          {isHoliday ? 'Heute Feiertag – geschlossen' : initial.state === 'open' ? 'Jetzt geöffnet' : 'Jetzt geschlossen'}
        </p>
        <p class="oh-banner-detail" data-oh-today>{initial.todayLabel}</p>
        <p class="oh-banner-next" data-oh-next hidden={!nextOpen}>{nextOpen ?? ''}</p>
      </div>

      <ul class="oh-week">
        {
          openingHours.map((p) => (
            <li>
              <strong>{p.days}</strong>
              <span>{formatHours(p)}</span>
            </li>
          ))
        }
        <li>
          <strong>Sonntag & Feiertage</strong>
          <span>geschlossen</span>
        </li>
      </ul>
      <p class="oh-sun">An gesetzlichen Feiertagen in NRW haben wir geschlossen – genau wie sonntags.</p>
      <div class="btn-row">
        <a class="btn btn-accent btn-sm" href={company.phone.href}>Anrufen</a>
        <a class="btn btn-ghost btn-sm" href={company.directions} target="_blank" rel="noopener">
          Route <span class="sr-only">(öffnet in neuem Tab)</span>
        </a>
        <a class="btn btn-ghost btn-sm" href={url('/kontakt/')}>Kontakt</a>
      </div>
    </div>
  </dialog>
</div>

<style>
  .oh {
    width: 100%;
  }

  .oh-alert {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem 0.55rem;
    padding: 0.55rem 0.85rem;
    background: #c2410c;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 750;
    text-align: center;
    letter-spacing: 0.01em;
  }

  .oh-alert[hidden] {
    display: none !important;
  }

  .oh-alert-kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    font-weight: 800;
    opacity: 0.95;
  }

  .oh-alert-name {
    font-size: 1rem;
    font-weight: 800;
  }

  .oh-alert-closed {
    font-weight: 700;
  }

  .oh-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.4rem;
    padding-block: 0.35rem;
  }

  .oh-pill {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.55rem;
    min-height: 40px;
    max-width: min(100%, 36rem);
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.92);
    color: var(--text);
    font: inherit;
    font-size: var(--fs-xs);
    font-weight: 700;
    cursor: pointer;
    text-align: left;
  }

  .oh-copy {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .oh-line {
    line-height: 1.25;
  }

  .oh-sub {
    font-size: 0.7rem;
    font-weight: 650;
    opacity: 0.85;
  }

  .oh-sub[hidden] {
    display: none;
  }

  .oh-dot {
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.35rem;
    border-radius: 50%;
    background: var(--text-muted);
    flex: none;
  }

  .oh-pill[data-state='open'] .oh-dot {
    background: var(--success);
    box-shadow: 0 0 0 3px rgb(from var(--success) r g b / 0.22);
  }

  .oh-pill[data-state='closed'] {
    border-color: #b91c1c;
    background: #fef2f2;
    color: #7f1d1d;
  }

  .oh-pill[data-state='closed'] .oh-dot {
    background: #dc2626;
  }

  .oh-pill[data-reason='holiday'] {
    border-color: #9a3412;
    background: #ffedd5;
    color: #7c2d12;
  }

  .oh-pill[data-reason='holiday'] .oh-dot {
    background: #ea580c;
  }

  .util-link {
    display: none;
    margin-left: auto;
    color: inherit;
    text-decoration: none;
    font-size: var(--fs-xs);
    font-weight: 650;
  }

  .util-route {
    margin-left: 0;
  }

  @media (min-width: 48em) {
    .util-link {
      display: inline;
    }
  }

  .site-header[data-overlay]:not(.is-solid) .oh-pill {
    border-color: rgb(255 255 255 / 0.35);
    background: rgb(14 12 10 / 0.45);
    color: #fff;
  }

  .site-header[data-overlay]:not(.is-solid) .oh-pill[data-state='closed'],
  .site-header[data-overlay]:not(.is-solid) .oh-pill[data-reason='holiday'] {
    border-color: #fdba74;
    background: rgb(154 52 18 / 0.85);
    color: #fff;
  }

  .oh-sheet {
    width: min(100% - 1.5rem, 24rem);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--text);
    box-shadow: var(--shadow-lg);
  }

  .oh-sheet::backdrop {
    background: rgb(14 12 10 / 0.45);
  }

  .oh-sheet-inner {
    padding: 1.25rem 1.35rem 1.5rem;
  }

  .oh-sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .oh-close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--sand);
    cursor: pointer;
  }

  .oh-banner {
    margin: 0.85rem 0 1.15rem;
    padding: 0.95rem 1rem;
    border-radius: var(--radius);
    background: var(--sand);
  }

  .oh-banner[data-state='open'] {
    background: var(--success-soft);
  }

  .oh-banner[data-state='closed'] {
    background: #fef2f2;
    color: #7f1d1d;
  }

  .oh-banner[data-reason='holiday'] {
    background: #ffedd5;
    color: #7c2d12;
  }

  .oh-banner-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 800;
  }

  .oh-banner-detail,
  .oh-banner-next {
    margin: 0.4rem 0 0;
    font-size: var(--fs-sm);
    font-weight: 650;
  }

  .oh-banner-next[hidden] {
    display: none;
  }

  .oh-week {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .oh-week li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--fs-sm);
  }

  .oh-sun {
    margin: 0.85rem 0 1.25rem;
    font-size: var(--fs-sm);
    font-weight: 650;
  }
</style>

<script>
  import { computeOpenStatus, type OpenStatus } from '@/lib/opening-hours';

  function apply(root: HTMLElement, status: OpenStatus) {
    const isHoliday = status.reason === 'holiday';
    const next = status.state === 'closed' ? status.opensNext : null;
    root.dataset.state = status.state;
    root.dataset.reason = status.reason;

    root.querySelectorAll<HTMLElement>('[data-oh-line]').forEach((el) => {
      el.textContent = status.label;
    });
    root.querySelectorAll<HTMLElement>('[data-oh-sub]').forEach((el) => {
      if (isHoliday) {
        el.hidden = false;
        el.textContent = `Gesetzlicher Feiertag (NRW)${next ? ` · ${next}` : ''}`;
      } else if (next) {
        el.hidden = false;
        el.textContent = next;
      } else {
        el.hidden = true;
        el.textContent = '';
      }
    });
    root.querySelectorAll<HTMLElement>('[data-oh-today]').forEach((el) => {
      el.textContent = status.todayLabel;
    });
    root.querySelectorAll<HTMLButtonElement>('[data-oh-open]').forEach((btn) => {
      btn.dataset.state = status.state;
      btn.dataset.reason = status.reason;
    });
    root.querySelectorAll<HTMLElement>('[data-oh-banner]').forEach((el) => {
      el.dataset.state = status.state;
      el.dataset.reason = status.reason;
    });
    root.querySelectorAll<HTMLElement>('[data-oh-banner-title]').forEach((el) => {
      el.textContent = isHoliday
        ? 'Heute Feiertag – geschlossen'
        : status.state === 'open'
          ? 'Jetzt geöffnet'
          : 'Jetzt geschlossen';
    });
    root.querySelectorAll<HTMLElement>('[data-oh-alert]').forEach((el) => {
      el.hidden = !isHoliday;
    });
    root.querySelectorAll<HTMLElement>('[data-oh-alert-name]').forEach((el) => {
      el.textContent = status.holiday?.name ?? '';
    });
    root.querySelectorAll<HTMLElement>('[data-oh-next]').forEach((el) => {
      el.hidden = !next;
      el.textContent = next ?? '';
    });
  }

  function tick() {
    document.querySelectorAll<HTMLElement>('[data-opening-status]').forEach((root) => apply(root, computeOpenStatus()));
  }

  document.querySelectorAll<HTMLElement>('[data-opening-status]').forEach((root) => {
    apply(root, computeOpenStatus());
    const sheet = root.querySelector<HTMLDialogElement>('[data-oh-sheet]');
    root.querySelector('[data-oh-open]')?.addEventListener('click', () => sheet?.showModal());
    root.querySelector('[data-oh-close]')?.addEventListener('click', () => sheet?.close());
    sheet?.addEventListener('click', (e) => {
      if (e.target === sheet) sheet.close();
    });
  });

  window.setInterval(tick, 30_000);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') tick();
  });
</script>
