---
import { url } from '@/lib/url';
/**
 * Accessibility preference controls — embedded in CampingCompanion (no separate FAB).
 * Boot-before-paint still applies `cco:a11y` via `buildBootScript()`.
 */
interface Props {
  /** When true, omit outer chrome (used inside Companion). */
  embedded?: boolean;
}

const embedded = Astro.props.embedded ?? true;
---

<div class:list={['a11y', embedded && 'a11y-embedded']} data-a11y>
  <div class="a11y-sheet">
    {
      !embedded && (
        <header class="a11y-head">
          <div class="a11y-head-copy">
            <p class="a11y-kicker">{'Campingcenter Overath'}</p>
            <h2 id="a11y-title">{'Anzeige anpassen'}</h2>
          </div>
        </header>
      )
    }

    <p class="a11y-lead">
      {
        'Praktische Darstellungshilfen für diese Website. Die Einstellungen gelten lokal auf diesem Gerät und ersetzen keine vollständige Barrierefreiheitsprüfung.'
      }
    </p>

    <section class="a11y-section" aria-labelledby="a11y-font-label">
      <h3 class="a11y-label" id="a11y-font-label">{'Schriftgröße'}</h3>
      <div class="a11y-seg a11y-seg-4" role="radiogroup" aria-labelledby="a11y-font-label">
        <button type="button" class="a11y-seg-btn" data-a11y-font="sm" aria-pressed="false">
          {'Klein'}
        </button>
        <button type="button" class="a11y-seg-btn" data-a11y-font="md" aria-pressed="true">
          {'Normal'}
        </button>
        <button type="button" class="a11y-seg-btn" data-a11y-font="lg" aria-pressed="false">
          {'Groß'}
        </button>
        <button type="button" class="a11y-seg-btn" data-a11y-font="xl" aria-pressed="false">
          {'Sehr groß'}
        </button>
      </div>
    </section>

    <section class="a11y-section" aria-labelledby="a11y-contrast-label">
      <h3 class="a11y-label" id="a11y-contrast-label">{'Kontrast'}</h3>
      <div class="a11y-seg" role="radiogroup" aria-labelledby="a11y-contrast-label">
        <button type="button" class="a11y-seg-btn" data-a11y-choice="contrast" data-a11y-value="off" aria-pressed="true">
          {'Standard'}
        </button>
        <button type="button" class="a11y-seg-btn" data-a11y-choice="contrast" data-a11y-value="on" aria-pressed="false">
          {'Hoher Kontrast'}
        </button>
      </div>
    </section>

    <section class="a11y-section" aria-labelledby="a11y-motion-label">
      <h3 class="a11y-label" id="a11y-motion-label">{'Animationen'}</h3>
      <div class="a11y-seg" role="radiogroup" aria-labelledby="a11y-motion-label">
        <button
          type="button"
          class="a11y-seg-btn"
          data-a11y-choice="reduceMotion"
          data-a11y-value="off"
          aria-pressed="true"
        >
          {'Standard'}
        </button>
        <button
          type="button"
          class="a11y-seg-btn"
          data-a11y-choice="reduceMotion"
          data-a11y-value="on"
          aria-pressed="false"
        >
          {'Reduziert'}
        </button>
      </div>
    </section>

    <section class="a11y-section" aria-labelledby="a11y-links-label">
      <h3 class="a11y-label" id="a11y-links-label">{'Links hervorheben'}</h3>
      <div class="a11y-seg" role="radiogroup" aria-labelledby="a11y-links-label">
        <button type="button" class="a11y-seg-btn" data-a11y-choice="links" data-a11y-value="off" aria-pressed="true">
          {'Aus'}
        </button>
        <button type="button" class="a11y-seg-btn" data-a11y-choice="links" data-a11y-value="on" aria-pressed="false">
          {'Ein'}
        </button>
      </div>
    </section>

    <section class="a11y-section" aria-labelledby="a11y-readable-label">
      <h3 class="a11y-label" id="a11y-readable-label">{'Lesefreundliche Darstellung'}</h3>
      <div class="a11y-seg" role="radiogroup" aria-labelledby="a11y-readable-label">
        <button type="button" class="a11y-seg-btn" data-a11y-choice="readable" data-a11y-value="off" aria-pressed="true">
          {'Aus'}
        </button>
        <button type="button" class="a11y-seg-btn" data-a11y-choice="readable" data-a11y-value="on" aria-pressed="false">
          {'Ein'}
        </button>
      </div>
    </section>

    <section class="a11y-section" aria-labelledby="a11y-focus-label">
      <h3 class="a11y-label" id="a11y-focus-label">{'Tastatur-Fokus hervorheben'}</h3>
      <div class="a11y-seg" role="radiogroup" aria-labelledby="a11y-focus-label">
        <button type="button" class="a11y-seg-btn" data-a11y-choice="focus" data-a11y-value="off" aria-pressed="true">
          {'Standard'}
        </button>
        <button type="button" class="a11y-seg-btn" data-a11y-choice="focus" data-a11y-value="on" aria-pressed="false">
          {'Verstärkt'}
        </button>
      </div>
    </section>

    {/* Legacy toggle hooks kept for tests / sync — visually hidden, driven by segmented controls */}
    <div class="a11y-legacy" hidden>
      <button type="button" data-a11y-toggle="contrast" aria-pressed="false">contrast</button>
      <button type="button" data-a11y-toggle="reduceMotion" aria-pressed="false">reduceMotion</button>
      <button type="button" data-a11y-toggle="readable" aria-pressed="false">readable</button>
      <button type="button" data-a11y-toggle="links" aria-pressed="false">links</button>
      <button type="button" data-a11y-toggle="focus" aria-pressed="false">focus</button>
    </div>

    <div class="a11y-actions">
      <button type="button" class="a11y-reset" data-a11y-reset>{'Einstellungen zurücksetzen'}</button>
      {
        !embedded && (
          <a class="a11y-statement" href={url('/barrierefreiheit/')}>
            {'Erklärung zur Barrierefreiheit'}
          </a>
        )
      }
    </div>
  </div>
</div>

<style>
  .a11y-embedded .a11y-sheet {
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    padding: 0;
    gap: 0.75rem;
    display: grid;
  }

  .a11y-head {
    display: grid;
    gap: 0.15rem;
    padding: 0.25rem 0 0.35rem;
  }

  .a11y-kicker {
    margin: 0;
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-ink);
  }

  .a11y-head h2 {
    margin: 0.1rem 0 0;
    font-size: 1.05rem;
    font-weight: 800;
  }

  .a11y-lead {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .a11y-section {
    display: grid;
    gap: 0.35rem;
  }

  .a11y-label {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 750;
    color: var(--slate);
  }

  .a11y-seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.3rem;
    padding: 0.28rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--sand);
  }

  .a11y-seg-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .a11y-seg-btn {
    min-height: 2.45rem;
    padding: 0.35rem 0.3rem;
    border: 0;
    border-radius: 0.55rem;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 750;
    cursor: pointer;
  }

  .a11y-seg-btn[aria-pressed='true'] {
    background: #fff;
    color: var(--brand-ink);
    box-shadow: var(--shadow-sm);
  }

  .a11y-seg-btn:focus-visible,
  .a11y-reset:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .a11y-actions {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.1rem;
  }

  .a11y-reset {
    width: 100%;
    min-height: 2.65rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.75rem;
    background: var(--sand);
    color: var(--graphite);
    font: inherit;
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
  }

  .a11y-statement {
    justify-self: center;
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--brand-ink);
  }

  @media (max-width: 22em) {
    .a11y-seg-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<style is:global>
  html.a11y-font-sm {
    font-size: 93.75%;
  }
  html.a11y-font-lg {
    font-size: 118.75%;
  }
  html.a11y-font-xl {
    font-size: 137.5%;
  }

  html.a11y-contrast {
    --bg: #f4f0e6;
    --ivory: #f4f0e6;
    --paper: #fffef9;
    --surface: #fffef9;
    --sand: #e4ddd0;
    --sand-strong: #d2c9b8;
    --text: #121417;
    --graphite: #121417;
    --text-muted: #2f363c;
    --slate: #2f363c;
    --line: #8f8778;
    --line-strong: #6f685c;
    --brand: #8f561f;
    --brand-strong: #7a4818;
    --brand-ink: #6b3f14;
    --brand-soft: #f0dfc8;
    --forest: #3f4d3a;
    --focus: #0b4fad;
    --success: #1f5a35;
    --danger: #8f1d14;
  }

  html.a11y-contrast body {
    background: var(--bg);
    color: var(--text);
  }

  html.a11y-contrast img,
  html.a11y-contrast video,
  html.a11y-contrast svg:not(.companion-fab-compass):not(.companion-tab-a11y-svg):not(.icon) {
    filter: none;
  }

  html.a11y-reduce-motion *,
  html.a11y-reduce-motion *::before,
  html.a11y-reduce-motion *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  html.a11y-readable {
    letter-spacing: 0.02em;
    word-spacing: 0.05em;
  }

  html.a11y-readable body {
    line-height: 1.75;
  }

  html.a11y-readable p,
  html.a11y-readable li,
  html.a11y-readable label,
  html.a11y-readable .lead {
    max-width: 42rem;
  }

  html.a11y-readable p + p {
    margin-top: 1.1em;
  }

  html.a11y-links a:not(.btn):not(.companion-fab):not([class*='chip']) {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    font-weight: 700;
  }

  html.a11y-links a:not(.btn):visited {
    text-decoration-style: double;
  }

  html.a11y-focus-strong :focus-visible {
    outline: 3px solid var(--focus) !important;
    outline-offset: 3px !important;
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--focus) 28%, transparent) !important;
  }

  html.a11y-focus-strong a:focus-visible,
  html.a11y-focus-strong button:focus-visible,
  html.a11y-focus-strong input:focus-visible,
  html.a11y-focus-strong textarea:focus-visible,
  html.a11y-focus-strong select:focus-visible,
  html.a11y-focus-strong summary:focus-visible,
  html.a11y-focus-strong [tabindex]:focus-visible {
    outline: 3px solid var(--focus) !important;
    outline-offset: 3px !important;
  }
</style>

<script>
  const KEY = 'cco:a11y';
  const LEGACY = 'cco-a11y';
  const TOGGLES = ['contrast', 'reduceMotion', 'readable', 'links', 'focus'] as const;
  type Toggle = (typeof TOGGLES)[number];
  type FontSize = 'sm' | 'md' | 'lg' | 'xl';

  type Prefs = {
    font: FontSize;
    contrast: boolean;
    reduceMotion: boolean;
    readable: boolean;
    links: boolean;
    focus: boolean;
  };

  const defaults = (): Prefs => ({
    font: 'md',
    contrast: false,
    reduceMotion: false,
    readable: false,
    links: false,
    focus: false,
  });

  function read(): Prefs {
    try {
      const raw = localStorage.getItem(KEY) || localStorage.getItem(LEGACY);
      if (!raw) {
        const base = defaults();
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            base.reduceMotion = true;
          }
        } catch {
          /* ignore */
        }
        return base;
      }
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed)) {
        return {
          font: parsed.includes('text-lg') ? 'lg' : 'md',
          contrast: parsed.includes('contrast'),
          reduceMotion: parsed.includes('reduce-motion'),
          readable: parsed.includes('readable'),
          links: parsed.includes('links'),
          focus: parsed.includes('focus'),
        };
      }
      if (parsed && typeof parsed === 'object') {
        const font: FontSize =
          parsed.font === 'sm' || parsed.font === 'lg' || parsed.font === 'xl' ? parsed.font : 'md';
        return {
          font,
          contrast: !!parsed.contrast,
          reduceMotion: !!parsed.reduceMotion,
          readable: !!parsed.readable,
          links: !!parsed.links,
          focus: !!parsed.focus,
        };
      }
    } catch {
      /* ignore */
    }
    return defaults();
  }

  function write(prefs: Prefs) {
    try {
      localStorage.setItem(KEY, JSON.stringify(prefs));
      localStorage.removeItem(LEGACY);
    } catch {
      /* ignore */
    }
  }

  function apply(prefs: Prefs, root?: HTMLElement | null) {
    const html = document.documentElement;
    html.classList.toggle('a11y-font-sm', prefs.font === 'sm');
    html.classList.toggle('a11y-font-lg', prefs.font === 'lg');
    html.classList.toggle('a11y-font-xl', prefs.font === 'xl');
    html.dataset.a11yFont = prefs.font;
    html.classList.toggle('a11y-contrast', prefs.contrast);
    html.classList.toggle('a11y-reduce-motion', prefs.reduceMotion);
    html.classList.toggle('a11y-readable', prefs.readable);
    html.classList.toggle('a11y-links', prefs.links);
    html.classList.toggle('a11y-focus-strong', prefs.focus);

    root?.querySelectorAll<HTMLButtonElement>('[data-a11y-font]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.a11yFont === prefs.font));
    });

    root?.querySelectorAll<HTMLButtonElement>('[data-a11y-choice]').forEach((btn) => {
      const key = btn.dataset.a11yChoice as Toggle;
      const wantOn = btn.dataset.a11yValue === 'on';
      const isOn = !!prefs[key];
      btn.setAttribute('aria-pressed', String(wantOn === isOn));
    });

    root?.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((btn) => {
      const key = btn.dataset.a11yToggle as Toggle;
      btn.setAttribute('aria-pressed', String(!!prefs[key]));
    });
  }

  function bindRoot(root: HTMLElement) {
    let prefs = read();
    apply(prefs, root);

    root.querySelectorAll<HTMLButtonElement>('[data-a11y-font]').forEach((btn) => {
      btn.addEventListener('click', () => {
        prefs = { ...prefs, font: (btn.dataset.a11yFont as FontSize) || 'md' };
        write(prefs);
        apply(prefs, root);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-a11y-choice]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.a11yChoice as Toggle;
        if (!TOGGLES.includes(key)) return;
        prefs = { ...prefs, [key]: btn.dataset.a11yValue === 'on' };
        write(prefs);
        apply(prefs, root);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.a11yToggle as Toggle;
        if (!TOGGLES.includes(key)) return;
        prefs = { ...prefs, [key]: !prefs[key] };
        write(prefs);
        apply(prefs, root);
      });
    });

    root.querySelector('[data-a11y-reset]')?.addEventListener('click', () => {
      prefs = defaults();
      write(prefs);
      apply(prefs, root);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-a11y]').forEach(bindRoot);
  window.addEventListener('cco:a11y-sync', () => {
    document.querySelectorAll<HTMLElement>('[data-a11y]').forEach((root) => apply(read(), root));
  });
</script>
