---
import Icon from '@/components/ui/Icon.astro';
import { url } from '@/lib/url';
---

<div class="a11y" data-a11y>
  <button
    type="button"
    class="a11y-fab"
    data-a11y-open
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="a11y-panel"
    aria-label="Barrierefreiheit und Anzeigeeinstellungen öffnen"
    title="Barrierefreiheit"
  >
    <!-- Classic ISA pictogram on WCAG-safe accessibility blue (not stroke Icon chrome) -->
    <svg class="a11y-fab-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="4.35" r="2.15" fill="currentColor" />
      <path
        fill="currentColor"
        d="M4.75 8.15c0-.72.58-1.3 1.3-1.3h11.9c.72 0 1.3.58 1.3 1.3v.85c0 .72-.58 1.3-1.3 1.3h-3.55v2.35l3.55 6.85a1.15 1.15 0 0 1-2.04 1.06L12 14.55l-3.91 7.01a1.15 1.15 0 1 1-2.04-1.06l3.55-6.85V10.3H6.05c-.72 0-1.3-.58-1.3-1.3v-.85Z"
      />
    </svg>
  </button>

  <dialog class="a11y-panel" id="a11y-panel" data-a11y-panel aria-labelledby="a11y-title">
    <div class="a11y-sheet">
      <header class="a11y-head">
        <button type="button" class="a11y-close" data-a11y-close aria-label="Schließen">
          <Icon name="close" />
          <span class="a11y-close-label">Schließen</span>
        </button>
        <div class="a11y-head-copy">
          <p class="a11y-kicker">Campingcenter Overath</p>
          <h2 id="a11y-title">Anzeige anpassen</h2>
        </div>
      </header>

      <p class="a11y-lead">
        Praktische Darstellungshilfen für diese Website. Die rechtliche Erklärung findest du unter
        Barrierefreiheit.
      </p>

      <section class="a11y-section" aria-labelledby="a11y-font-label">
        <h3 class="a11y-label" id="a11y-font-label">Schriftgröße</h3>
        <div class="a11y-font" role="radiogroup" aria-labelledby="a11y-font-label">
          <button type="button" class="a11y-font-btn" data-a11y-font="sm" aria-pressed="false" title="Kleiner">
            <span aria-hidden="true">A−</span>
            <span class="sr-only">Schrift verkleinern</span>
          </button>
          <button type="button" class="a11y-font-btn" data-a11y-font="md" aria-pressed="true" title="Standard">
            <span aria-hidden="true">A</span>
            <span class="sr-only">Standard-Schriftgröße</span>
          </button>
          <button type="button" class="a11y-font-btn" data-a11y-font="lg" aria-pressed="false" title="Größer">
            <span aria-hidden="true">A+</span>
            <span class="sr-only">Schrift vergrößern</span>
          </button>
        </div>
      </section>

      <section class="a11y-section" aria-labelledby="a11y-opts-label">
        <h3 class="a11y-label" id="a11y-opts-label">Darstellung</h3>
        <ul class="a11y-list">
          <li>
            <button type="button" class="a11y-opt" data-a11y-toggle="contrast" aria-pressed="false">
              <span class="a11y-opt-text">Kontrast erhöhen</span>
              <span class="a11y-switch" aria-hidden="true"></span>
            </button>
          </li>
          <li>
            <button type="button" class="a11y-opt" data-a11y-toggle="reduceMotion" aria-pressed="false">
              <span class="a11y-opt-text">Animationen reduzieren</span>
              <span class="a11y-switch" aria-hidden="true"></span>
            </button>
          </li>
          <li>
            <button type="button" class="a11y-opt" data-a11y-toggle="readable" aria-pressed="false">
              <span class="a11y-opt-text">Lesefreundliche Darstellung</span>
              <span class="a11y-switch" aria-hidden="true"></span>
            </button>
          </li>
          <li>
            <button type="button" class="a11y-opt" data-a11y-toggle="links" aria-pressed="false">
              <span class="a11y-opt-text">Links hervorheben</span>
              <span class="a11y-switch" aria-hidden="true"></span>
            </button>
          </li>
        </ul>
      </section>

      <div class="a11y-actions">
        <button type="button" class="a11y-reset" data-a11y-reset>Zurücksetzen</button>
        <a class="a11y-statement" href={url('/barrierefreiheit/')}>Erklärung zur Barrierefreiheit</a>
      </div>
    </div>
  </dialog>
</div>

<style>
  .a11y {
    --a11y-blue: #0b5fff;
    --a11y-bottom: calc(
      var(--actionbar-h, 0px) + var(--safe-bottom) + var(--consent-lift, 0px) + var(--chat-fab-h, 3.6rem) + 1.15rem
    );
    position: fixed;
    right: max(0.75rem, env(safe-area-inset-right, 0px));
    bottom: var(--a11y-bottom);
    z-index: var(--z-a11y, 65);
    display: grid;
    justify-items: end;
    pointer-events: none;
  }

  .a11y > * {
    pointer-events: auto;
  }

  /* Chat-Panel offen: Compass zurückhalten, ohne Cookie/Chat zu überdecken */
  :global(body:has(.chatw.is-open)) .a11y-fab {
    opacity: 0.4;
    pointer-events: none;
  }

  .a11y-fab {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    min-width: 48px;
    min-height: 48px;
    padding: 0;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--a11y-blue);
    color: #fff;
    box-shadow:
      0 0 0 1px rgb(11 95 255 / 0.28),
      0 10px 24px -12px rgb(11 95 255 / 0.55),
      var(--shadow-sm);
    cursor: pointer;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      filter var(--dur) var(--ease);
  }

  @media (min-width: 64em) {
    .a11y-fab {
      width: 3.15rem;
      height: 3.15rem;
    }
  }

  .a11y-fab:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgb(11 95 255 / 0.35),
      0 14px 28px -12px rgb(11 95 255 / 0.6),
      var(--shadow);
  }

  .a11y-fab:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .a11y-fab[aria-expanded='true'] {
    filter: brightness(0.96);
    box-shadow:
      0 0 0 2px var(--brand),
      0 10px 24px -12px rgb(11 95 255 / 0.55);
  }

  .a11y-fab-icon {
    width: 1.45rem;
    height: 1.45rem;
    display: block;
  }

  .a11y-panel {
    width: min(calc(100vw - 1.25rem), 22.5rem);
    max-height: min(85dvh, 36rem);
    margin: auto;
    margin-bottom: max(0.75rem, env(safe-area-inset-bottom, 0px));
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: transparent;
    color: var(--text);
    box-shadow: none;
  }

  .a11y-panel::backdrop {
    background: rgb(36 40 43 / 0.42);
  }

  @media (max-width: 39.99em) {
    .a11y-panel {
      width: 100%;
      max-width: none;
      margin: 0;
      margin-top: auto;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      max-height: min(88dvh, 38rem);
    }

    .a11y-panel[open] {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      width: 100%;
      max-width: none;
      height: 100%;
      max-height: none;
      background: transparent;
      box-shadow: none;
    }

    .a11y-panel[open]::backdrop {
      background: rgb(36 40 43 / 0.48);
    }

    .a11y-panel[open] .a11y-sheet {
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    }
  }

  .a11y-sheet {
    display: grid;
    gap: 0.85rem;
    padding: 0 0 1rem;
    overflow: auto;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-lg);
  }

  .a11y-head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.7rem 0.55rem 0.55rem;
    background: linear-gradient(180deg, var(--sand) 0%, var(--ivory) 100%);
    border-bottom: 1px solid var(--line);
  }

  .a11y-close {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--graphite);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .a11y-close :global(.icon) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .a11y-close:focus-visible,
  .a11y-font-btn:focus-visible,
  .a11y-opt:focus-visible,
  .a11y-reset:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .a11y-close-label {
    line-height: 1;
  }

  @media (max-width: 22em) {
    .a11y-close-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  .a11y-kicker {
    margin: 0;
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-ink);
  }

  .a11y-head h2 {
    margin: 0.1rem 0 0;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--graphite);
  }

  .a11y-lead,
  .a11y-section,
  .a11y-actions {
    padding-inline: 1rem;
  }

  .a11y-lead {
    margin: 0;
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .a11y-section {
    display: grid;
    gap: 0.4rem;
  }

  .a11y-label {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.02em;
    color: var(--slate);
  }

  .a11y-font {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
    padding: 0.3rem;
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: var(--sand);
  }

  .a11y-font-btn {
    min-height: 2.75rem;
    border: 0;
    border-radius: 0.65rem;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .a11y-font-btn[data-a11y-font='sm'] {
    font-size: 0.85rem;
  }

  .a11y-font-btn[data-a11y-font='md'] {
    font-size: 1rem;
  }

  .a11y-font-btn[data-a11y-font='lg'] {
    font-size: 1.2rem;
  }

  .a11y-font-btn[aria-pressed='true'] {
    background: #fff;
    color: var(--brand-ink);
    box-shadow: var(--shadow-sm);
  }

  .a11y-list {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .a11y-opt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-height: 2.85rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: #fff;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 650;
    text-align: left;
    cursor: pointer;
  }

  .a11y-opt-text {
    flex: 1;
  }

  .a11y-switch {
    position: relative;
    flex: none;
    width: 2.55rem;
    height: 1.45rem;
    border-radius: var(--radius-pill);
    background: var(--sand-strong);
    transition: background-color var(--dur) var(--ease);
  }

  .a11y-switch::after {
    content: '';
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease);
  }

  .a11y-opt[aria-pressed='true'] {
    border-color: color-mix(in srgb, var(--brand) 55%, var(--line));
    background: var(--brand-soft);
    color: var(--brand-ink);
  }

  .a11y-opt[aria-pressed='true'] .a11y-switch {
    background: var(--forest);
  }

  .a11y-opt[aria-pressed='true'] .a11y-switch::after {
    transform: translateX(1.1rem);
  }

  .a11y-actions {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.15rem;
  }

  .a11y-reset {
    width: 100%;
    min-height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.75rem;
    background: var(--sand);
    color: var(--graphite);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }

  .a11y-statement {
    justify-self: center;
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--brand-ink);
    text-underline-offset: 0.15em;
  }
</style>

<style is:global>
  /* Real rem reflow (not transform/zoom) */
  html.a11y-font-sm {
    font-size: 93.75%;
  }

  html.a11y-font-lg {
    font-size: 118.75%;
  }

  /* Tested high-contrast warm palette — not CSS filter:invert */
  html.a11y-contrast {
    --bg: #f4f0e6;
    --ivory: #f4f0e6;
    --paper: #fffef9;
    --surface: #fffef9;
    --sand: #e4ddd0;
    --sand-strong: #d2c9b8;
    --text: #121417;
    --graphite: #121417;
    --text-muted: #2f363c;
    --slate: #2f363c;
    --line: #8f8778;
    --line-strong: #6f685c;
    --brand: #8f561f;
    --brand-strong: #7a4818;
    --brand-ink: #6b3f14;
    --brand-soft: #f0dfc8;
    --forest: #3f4d3a;
    --focus: #0b4fad;
    --success: #1f5a35;
    --danger: #8f1d14;
  }

  html.a11y-contrast body {
    background: var(--bg);
    color: var(--text);
  }

  html.a11y-reduce-motion *,
  html.a11y-reduce-motion *::before,
  html.a11y-reduce-motion *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  /* Spacing/readability — no dyslexia-font claims */
  html.a11y-readable {
    letter-spacing: 0.02em;
    word-spacing: 0.05em;
  }

  html.a11y-readable body {
    line-height: 1.75;
  }

  html.a11y-readable p,
  html.a11y-readable li,
  html.a11y-readable label,
  html.a11y-readable .lead {
    max-width: 42rem;
  }

  html.a11y-links a:not(.btn):not(.a11y-fab):not([class*='chip']) {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    font-weight: 700;
  }

  html.a11y-links a:not(.btn):visited {
    text-decoration-style: double;
  }
</style>

<script>
  const KEY = 'cco:a11y';
  const LEGACY = 'cco-a11y';
  const TOGGLES = ['contrast', 'reduceMotion', 'readable', 'links'] as const;
  type Toggle = (typeof TOGGLES)[number];
  type FontSize = 'sm' | 'md' | 'lg';

  type Prefs = {
    font: FontSize;
    contrast: boolean;
    reduceMotion: boolean;
    readable: boolean;
    links: boolean;
  };

  const defaults = (): Prefs => ({
    font: 'md',
    contrast: false,
    reduceMotion: false,
    readable: false,
    links: false,
  });

  function read(): Prefs {
    try {
      const raw = localStorage.getItem(KEY) || localStorage.getItem(LEGACY);
      if (!raw) return defaults();
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed)) {
        return {
          font: parsed.includes('text-lg') ? 'lg' : 'md',
          contrast: parsed.includes('contrast'),
          reduceMotion: parsed.includes('reduce-motion'),
          readable: parsed.includes('readable'),
          links: parsed.includes('links'),
        };
      }
      if (parsed && typeof parsed === 'object') {
        const font: FontSize = parsed.font === 'sm' || parsed.font === 'lg' ? parsed.font : 'md';
        return {
          font,
          contrast: !!parsed.contrast,
          reduceMotion: !!parsed.reduceMotion,
          readable: !!parsed.readable,
          links: !!parsed.links,
        };
      }
    } catch {
      /* ignore */
    }
    return defaults();
  }

  function write(prefs: Prefs) {
    try {
      localStorage.setItem(KEY, JSON.stringify(prefs));
      localStorage.removeItem(LEGACY);
    } catch {
      /* ignore */
    }
  }

  function apply(prefs: Prefs, root?: HTMLElement | null) {
    const html = document.documentElement;
    html.classList.toggle('a11y-font-sm', prefs.font === 'sm');
    html.classList.toggle('a11y-font-lg', prefs.font === 'lg');
    html.dataset.a11yFont = prefs.font;
    html.classList.toggle('a11y-contrast', prefs.contrast);
    html.classList.toggle('a11y-reduce-motion', prefs.reduceMotion);
    html.classList.toggle('a11y-readable', prefs.readable);
    html.classList.toggle('a11y-links', prefs.links);

    root?.querySelectorAll<HTMLButtonElement>('[data-a11y-font]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.a11yFont === prefs.font));
    });
    root?.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((btn) => {
      const key = btn.dataset.a11yToggle as Toggle;
      btn.setAttribute('aria-pressed', String(!!prefs[key]));
    });
  }

  document.querySelectorAll<HTMLElement>('[data-a11y]').forEach((root) => {
    const panel = root.querySelector<HTMLDialogElement>('[data-a11y-panel]');
    const openBtn = root.querySelector<HTMLButtonElement>('[data-a11y-open]');
    const closeBtn = root.querySelector('[data-a11y-close]');
    if (!panel || !openBtn) return;

    let prefs = read();
    apply(prefs, root);

    const setOpen = (open: boolean) => {
      openBtn.setAttribute('aria-expanded', String(open));
      if (open) {
        if (!panel.open) panel.showModal();
      } else if (panel.open) {
        panel.close();
      }
    };

    openBtn.addEventListener('click', () => setOpen(!panel.open));
    closeBtn?.addEventListener('click', () => setOpen(false));
    panel.addEventListener('click', (e) => {
      if (e.target === panel) setOpen(false);
    });
    panel.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });
    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    root.querySelectorAll<HTMLButtonElement>('[data-a11y-font]').forEach((btn) => {
      btn.addEventListener('click', () => {
        prefs = { ...prefs, font: (btn.dataset.a11yFont as FontSize) || 'md' };
        write(prefs);
        apply(prefs, root);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.a11yToggle as Toggle;
        if (!TOGGLES.includes(key)) return;
        prefs = { ...prefs, [key]: !prefs[key] };
        write(prefs);
        apply(prefs, root);
      });
    });

    root.querySelector('[data-a11y-reset]')?.addEventListener('click', () => {
      prefs = defaults();
      write(prefs);
      apply(prefs, root);
    });
  });
</script>
