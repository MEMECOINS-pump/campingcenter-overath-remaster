---
/**
 * Accessibility preference controls — embedded in CampingCompanion (no separate FAB).
 * Boot-before-paint still applies `cco:a11y` via `buildBootScript()`.
 */
import { getLangFromPath, t, type Locale } from '@/i18n';
import { url } from '@/lib/url';
import { localizedPath } from '@/i18n';

interface Props {
  lang?: Locale;
  /** When true, omit outer chrome (used inside Companion). */
  embedded?: boolean;
}

const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const embedded = Astro.props.embedded ?? true;
---

<div class:list={['a11y', embedded && 'a11y-embedded']} data-a11y>
  <div class="a11y-sheet">
    {
      !embedded && (
        <header class="a11y-head">
          <div class="a11y-head-copy">
            <p class="a11y-kicker">{t(lang, 'a11yKicker')}</p>
            <h2 id="a11y-title">{t(lang, 'a11yTitle')}</h2>
          </div>
        </header>
      )
    }

    <p class="a11y-lead">{t(lang, 'a11yLead')}</p>

    <section class="a11y-section" aria-labelledby="a11y-font-label">
      <h3 class="a11y-label" id="a11y-font-label">{t(lang, 'a11yFont')}</h3>
      <div class="a11y-font" role="radiogroup" aria-labelledby="a11y-font-label">
        <button type="button" class="a11y-font-btn" data-a11y-font="sm" aria-pressed="false" title={t(lang, 'a11yFontSm')}>
          <span aria-hidden="true">A−</span>
          <span class="sr-only">{t(lang, 'a11yFontSm')}</span>
        </button>
        <button type="button" class="a11y-font-btn" data-a11y-font="md" aria-pressed="true" title={t(lang, 'a11yFontMd')}>
          <span aria-hidden="true">A</span>
          <span class="sr-only">{t(lang, 'a11yFontMd')}</span>
        </button>
        <button type="button" class="a11y-font-btn" data-a11y-font="lg" aria-pressed="false" title={t(lang, 'a11yFontLg')}>
          <span aria-hidden="true">A+</span>
          <span class="sr-only">{t(lang, 'a11yFontLg')}</span>
        </button>
      </div>
    </section>

    <section class="a11y-section" aria-labelledby="a11y-opts-label">
      <h3 class="a11y-label" id="a11y-opts-label">{t(lang, 'a11yDisplay')}</h3>
      <ul class="a11y-list">
        <li>
          <button type="button" class="a11y-opt" data-a11y-toggle="contrast" aria-pressed="false">
            <span class="a11y-opt-text">{t(lang, 'a11yContrast')}</span>
            <span class="a11y-switch" aria-hidden="true"></span>
          </button>
        </li>
        <li>
          <button type="button" class="a11y-opt" data-a11y-toggle="reduceMotion" aria-pressed="false">
            <span class="a11y-opt-text">{t(lang, 'a11yMotion')}</span>
            <span class="a11y-switch" aria-hidden="true"></span>
          </button>
        </li>
        <li>
          <button type="button" class="a11y-opt" data-a11y-toggle="readable" aria-pressed="false">
            <span class="a11y-opt-text">{t(lang, 'a11yReadable')}</span>
            <span class="a11y-switch" aria-hidden="true"></span>
          </button>
        </li>
        <li>
          <button type="button" class="a11y-opt" data-a11y-toggle="links" aria-pressed="false">
            <span class="a11y-opt-text">{t(lang, 'a11yLinks')}</span>
            <span class="a11y-switch" aria-hidden="true"></span>
          </button>
        </li>
      </ul>
    </section>

    <div class="a11y-actions">
      <button type="button" class="a11y-reset" data-a11y-reset>{t(lang, 'a11yReset')}</button>
      {
        !embedded && (
          <a class="a11y-statement" href={url(localizedPath('/barrierefreiheit/', lang))}>
            {t(lang, 'a11yStatement')}
          </a>
        )
      }
    </div>
  </div>
</div>

<style>
  .a11y-embedded .a11y-sheet {
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    padding: 0;
    gap: 0.85rem;
    display: grid;
  }

  .a11y-head {
    display: grid;
    gap: 0.15rem;
    padding: 0.25rem 0 0.35rem;
  }

  .a11y-kicker {
    margin: 0;
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-ink);
  }

  .a11y-head h2 {
    margin: 0.1rem 0 0;
    font-size: 1.05rem;
    font-weight: 800;
  }

  .a11y-lead {
    margin: 0;
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .a11y-section {
    display: grid;
    gap: 0.4rem;
  }

  .a11y-label {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 750;
    color: var(--slate);
  }

  .a11y-font {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
    padding: 0.3rem;
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: var(--sand);
  }

  .a11y-font-btn {
    min-height: 2.75rem;
    border: 0;
    border-radius: 0.65rem;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .a11y-font-btn[data-a11y-font='sm'] {
    font-size: 0.85rem;
  }
  .a11y-font-btn[data-a11y-font='md'] {
    font-size: 1rem;
  }
  .a11y-font-btn[data-a11y-font='lg'] {
    font-size: 1.2rem;
  }

  .a11y-font-btn[aria-pressed='true'] {
    background: #fff;
    color: var(--brand-ink);
    box-shadow: var(--shadow-sm);
  }

  .a11y-font-btn:focus-visible,
  .a11y-opt:focus-visible,
  .a11y-reset:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .a11y-list {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .a11y-opt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-height: 2.85rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: #fff;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 650;
    text-align: left;
    cursor: pointer;
  }

  .a11y-switch {
    position: relative;
    flex: none;
    width: 2.55rem;
    height: 1.45rem;
    border-radius: var(--radius-pill);
    background: var(--sand-strong);
  }

  .a11y-switch::after {
    content: '';
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease);
  }

  .a11y-opt[aria-pressed='true'] {
    border-color: color-mix(in srgb, var(--brand) 55%, var(--line));
    background: var(--brand-soft);
    color: var(--brand-ink);
  }

  .a11y-opt[aria-pressed='true'] .a11y-switch {
    background: var(--forest);
  }

  .a11y-opt[aria-pressed='true'] .a11y-switch::after {
    transform: translateX(1.1rem);
  }

  .a11y-actions {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.15rem;
  }

  .a11y-reset {
    width: 100%;
    min-height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.75rem;
    background: var(--sand);
    color: var(--graphite);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }

  .a11y-statement {
    justify-self: center;
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--brand-ink);
  }
</style>

<style is:global>
  html.a11y-font-sm {
    font-size: 93.75%;
  }
  html.a11y-font-lg {
    font-size: 118.75%;
  }

  html.a11y-contrast {
    --bg: #f4f0e6;
    --ivory: #f4f0e6;
    --paper: #fffef9;
    --surface: #fffef9;
    --sand: #e4ddd0;
    --sand-strong: #d2c9b8;
    --text: #121417;
    --graphite: #121417;
    --text-muted: #2f363c;
    --slate: #2f363c;
    --line: #8f8778;
    --line-strong: #6f685c;
    --brand: #8f561f;
    --brand-strong: #7a4818;
    --brand-ink: #6b3f14;
    --brand-soft: #f0dfc8;
    --forest: #3f4d3a;
    --focus: #0b4fad;
    --success: #1f5a35;
    --danger: #8f1d14;
  }

  html.a11y-contrast body {
    background: var(--bg);
    color: var(--text);
  }

  html.a11y-reduce-motion *,
  html.a11y-reduce-motion *::before,
  html.a11y-reduce-motion *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  html.a11y-readable {
    letter-spacing: 0.02em;
    word-spacing: 0.05em;
  }

  html.a11y-readable body {
    line-height: 1.75;
  }

  html.a11y-readable p,
  html.a11y-readable li,
  html.a11y-readable label,
  html.a11y-readable .lead {
    max-width: 42rem;
  }

  html.a11y-links a:not(.btn):not(.companion-fab):not([class*='chip']) {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    font-weight: 700;
  }

  html.a11y-links a:not(.btn):visited {
    text-decoration-style: double;
  }
</style>

<script>
  const KEY = 'cco:a11y';
  const LEGACY = 'cco-a11y';
  const TOGGLES = ['contrast', 'reduceMotion', 'readable', 'links'] as const;
  type Toggle = (typeof TOGGLES)[number];
  type FontSize = 'sm' | 'md' | 'lg';

  type Prefs = {
    font: FontSize;
    contrast: boolean;
    reduceMotion: boolean;
    readable: boolean;
    links: boolean;
  };

  const defaults = (): Prefs => ({
    font: 'md',
    contrast: false,
    reduceMotion: false,
    readable: false,
    links: false,
  });

  function read(): Prefs {
    try {
      const raw = localStorage.getItem(KEY) || localStorage.getItem(LEGACY);
      if (!raw) return defaults();
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed)) {
        return {
          font: parsed.includes('text-lg') ? 'lg' : 'md',
          contrast: parsed.includes('contrast'),
          reduceMotion: parsed.includes('reduce-motion'),
          readable: parsed.includes('readable'),
          links: parsed.includes('links'),
        };
      }
      if (parsed && typeof parsed === 'object') {
        const font: FontSize = parsed.font === 'sm' || parsed.font === 'lg' ? parsed.font : 'md';
        return {
          font,
          contrast: !!parsed.contrast,
          reduceMotion: !!parsed.reduceMotion,
          readable: !!parsed.readable,
          links: !!parsed.links,
        };
      }
    } catch {
      /* ignore */
    }
    return defaults();
  }

  function write(prefs: Prefs) {
    try {
      localStorage.setItem(KEY, JSON.stringify(prefs));
      localStorage.removeItem(LEGACY);
    } catch {
      /* ignore */
    }
  }

  function apply(prefs: Prefs, root?: HTMLElement | null) {
    const html = document.documentElement;
    html.classList.toggle('a11y-font-sm', prefs.font === 'sm');
    html.classList.toggle('a11y-font-lg', prefs.font === 'lg');
    html.dataset.a11yFont = prefs.font;
    html.classList.toggle('a11y-contrast', prefs.contrast);
    html.classList.toggle('a11y-reduce-motion', prefs.reduceMotion);
    html.classList.toggle('a11y-readable', prefs.readable);
    html.classList.toggle('a11y-links', prefs.links);

    root?.querySelectorAll<HTMLButtonElement>('[data-a11y-font]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.a11yFont === prefs.font));
    });
    root?.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((btn) => {
      const key = btn.dataset.a11yToggle as Toggle;
      btn.setAttribute('aria-pressed', String(!!prefs[key]));
    });
  }

  function bindRoot(root: HTMLElement) {
    let prefs = read();
    apply(prefs, root);

    root.querySelectorAll<HTMLButtonElement>('[data-a11y-font]').forEach((btn) => {
      btn.addEventListener('click', () => {
        prefs = { ...prefs, font: (btn.dataset.a11yFont as FontSize) || 'md' };
        write(prefs);
        apply(prefs, root);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.a11yToggle as Toggle;
        if (!TOGGLES.includes(key)) return;
        prefs = { ...prefs, [key]: !prefs[key] };
        write(prefs);
        apply(prefs, root);
      });
    });

    root.querySelector('[data-a11y-reset]')?.addEventListener('click', () => {
      prefs = defaults();
      write(prefs);
      apply(prefs, root);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-a11y]').forEach(bindRoot);
  window.addEventListener('cco:a11y-sync', () => {
    document.querySelectorAll<HTMLElement>('[data-a11y]').forEach((root) => apply(read(), root));
  });
</script>
