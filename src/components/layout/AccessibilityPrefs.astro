---
import Icon from '@/components/ui/Icon.astro';
import { url } from '@/lib/url';
---

<div class="a11y" data-a11y>
  <button
    type="button"
    class="a11y-fab"
    data-a11y-open
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="a11y-panel"
    aria-label="Barrierefreiheit und Anzeigeeinstellungen öffnen"
    title="Barrierefreiheit"
  >
    <Icon name="a11y-compass" class="a11y-fab-icon" />
  </button>

  <dialog class="a11y-panel" id="a11y-panel" data-a11y-panel aria-labelledby="a11y-title">
    <div class="a11y-sheet">
      <header class="a11y-head">
        <div class="a11y-head-copy">
          <p class="a11y-kicker">Campingcenter Overath</p>
          <h2 id="a11y-title">Barrierefreiheit</h2>
        </div>
        <button type="button" class="a11y-close" data-a11y-close aria-label="Schließen">
          <Icon name="close" />
        </button>
      </header>

      <p class="a11y-lead">Passe die Darstellung dieser Website an deine Bedürfnisse an.</p>

      <div class="a11y-group" role="group" aria-labelledby="a11y-font-label">
        <p class="a11y-label" id="a11y-font-label">Schriftgröße</p>
        <div class="a11y-font" role="radiogroup" aria-labelledby="a11y-font-label">
          <button type="button" class="a11y-font-btn" data-a11y-font="sm" aria-pressed="false" title="Kleiner">
            <span aria-hidden="true">A−</span>
            <span class="sr-only">Schrift verkleinern</span>
          </button>
          <button type="button" class="a11y-font-btn" data-a11y-font="md" aria-pressed="true" title="Standard">
            <span aria-hidden="true">A</span>
            <span class="sr-only">Standard-Schriftgröße</span>
          </button>
          <button type="button" class="a11y-font-btn" data-a11y-font="lg" aria-pressed="false" title="Größer">
            <span aria-hidden="true">A+</span>
            <span class="sr-only">Schrift vergrößern</span>
          </button>
        </div>
      </div>

      <ul class="a11y-list">
        <li>
          <button type="button" class="a11y-opt" data-a11y-toggle="contrast" aria-pressed="false">
            Kontrast erhöhen
          </button>
        </li>
        <li>
          <button type="button" class="a11y-opt" data-a11y-toggle="reduceMotion" aria-pressed="false">
            Animationen reduzieren
          </button>
        </li>
        <li>
          <button type="button" class="a11y-opt" data-a11y-toggle="readable" aria-pressed="false">
            Lesefreundliche Darstellung
          </button>
        </li>
        <li>
          <button type="button" class="a11y-opt" data-a11y-toggle="links" aria-pressed="false">
            Links hervorheben
          </button>
        </li>
      </ul>

      <div class="a11y-actions">
        <button type="button" class="btn btn-ghost btn-sm" data-a11y-reset>Zurücksetzen</button>
        <a class="a11y-statement" href={url('/barrierefreiheit/')}>Erklärung zur Barrierefreiheit</a>
      </div>
    </div>
  </dialog>
</div>

<style>
  .a11y {
    --a11y-bottom: calc(
      var(--actionbar-h, 0px) + var(--safe-bottom) + var(--consent-lift, 0px) + var(--chat-fab-h, 3.6rem) + 1.15rem
    );
    position: fixed;
    right: max(0.75rem, env(safe-area-inset-right, 0px));
    bottom: var(--a11y-bottom);
    z-index: var(--z-a11y, 65);
    display: grid;
    justify-items: end;
    pointer-events: none;
  }

  .a11y > * {
    pointer-events: auto;
  }

  /* Chat-Panel offen: Compass zurückhalten, ohne Cookie/Chat zu überdecken */
  :global(body:has(.chatw.is-open)) .a11y-fab {
    opacity: 0.4;
    pointer-events: none;
  }

  .a11y-fab {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--paper);
    color: var(--graphite);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  @media (min-width: 64em) {
    .a11y-fab {
      width: 3rem;
      height: 3rem;
    }
  }

  .a11y-fab:hover {
    border-color: var(--brand);
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }

  .a11y-fab:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .a11y-fab[aria-expanded='true'] {
    border-color: var(--brand);
    background: var(--brand-soft);
    color: var(--brand-ink);
  }

  .a11y-fab-icon {
    width: 1.35rem;
    height: 1.35rem;
  }

  .a11y-panel {
    width: min(calc(100vw - 1.25rem), 22rem);
    max-height: min(85dvh, 34rem);
    margin: auto;
    margin-bottom: max(0.75rem, env(safe-area-inset-bottom, 0px));
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--text);
    box-shadow: var(--shadow-lg);
  }

  .a11y-panel::backdrop {
    background: rgb(36 40 43 / 0.42);
  }

  @media (max-width: 39.99em) {
    .a11y-panel {
      width: 100%;
      max-width: none;
      margin: 0;
      margin-top: auto;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      max-height: min(88dvh, 36rem);
    }

    .a11y-panel[open] {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      width: 100%;
      max-width: none;
      height: 100%;
      max-height: none;
      background: transparent;
      box-shadow: none;
    }

    .a11y-panel[open]::backdrop {
      background: rgb(36 40 43 / 0.48);
    }

    .a11y-panel[open] .a11y-sheet {
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      background: var(--paper);
      box-shadow: var(--shadow-lg);
      padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    }
  }

  .a11y-sheet {
    padding: 1rem 1.05rem 1.1rem;
    overflow: auto;
  }

  .a11y-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.65rem;
  }

  .a11y-kicker {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-ink);
  }

  .a11y-head h2 {
    margin: 0.15rem 0 0;
    font-family: var(--font-body);
    font-size: 1.12rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .a11y-close {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    min-width: 44px;
    min-height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--sand);
    color: var(--graphite);
    cursor: pointer;
  }

  .a11y-lead {
    margin: 0.65rem 0 0.95rem;
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .a11y-group {
    margin-bottom: 0.75rem;
  }

  .a11y-label {
    margin: 0 0 0.4rem;
    font-size: 0.78rem;
    font-weight: 750;
    color: var(--text-muted);
  }

  .a11y-font {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
  }

  .a11y-font-btn {
    min-height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: #fff;
    color: var(--text);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .a11y-font-btn[data-a11y-font='sm'] {
    font-size: 0.85rem;
  }

  .a11y-font-btn[data-a11y-font='md'] {
    font-size: 1rem;
  }

  .a11y-font-btn[data-a11y-font='lg'] {
    font-size: 1.2rem;
  }

  .a11y-font-btn[aria-pressed='true'] {
    border-color: var(--brand);
    background: var(--brand-soft);
    color: var(--brand-ink);
  }

  .a11y-list {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .a11y-opt {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: #fff;
    color: var(--text);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 650;
    text-align: left;
    cursor: pointer;
  }

  .a11y-opt[aria-pressed='true'] {
    border-color: var(--brand);
    background: var(--brand-soft);
    color: var(--brand-ink);
  }

  .a11y-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem 1rem;
    margin-top: 0.9rem;
  }

  .a11y-statement {
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--brand-ink);
  }
</style>

<style is:global>
  /* Real rem reflow (not transform/zoom) */
  html.a11y-font-sm {
    font-size: 93.75%;
  }

  html.a11y-font-lg {
    font-size: 118.75%;
  }

  /* Tested high-contrast warm palette — not CSS filter:invert */
  html.a11y-contrast {
    --bg: #f4f0e6;
    --ivory: #f4f0e6;
    --paper: #fffef9;
    --surface: #fffef9;
    --sand: #e4ddd0;
    --sand-strong: #d2c9b8;
    --text: #121417;
    --graphite: #121417;
    --text-muted: #2f363c;
    --slate: #2f363c;
    --line: #8f8778;
    --line-strong: #6f685c;
    --brand: #8f561f;
    --brand-strong: #7a4818;
    --brand-ink: #6b3f14;
    --brand-soft: #f0dfc8;
    --forest: #3f4d3a;
    --focus: #0b4fad;
    --success: #1f5a35;
    --danger: #8f1d14;
  }

  html.a11y-contrast body {
    background: var(--bg);
    color: var(--text);
  }

  html.a11y-reduce-motion *,
  html.a11y-reduce-motion *::before,
  html.a11y-reduce-motion *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  /* Spacing/readability — no dyslexia-font claims */
  html.a11y-readable {
    letter-spacing: 0.02em;
    word-spacing: 0.05em;
  }

  html.a11y-readable body {
    line-height: 1.75;
  }

  html.a11y-readable p,
  html.a11y-readable li,
  html.a11y-readable label,
  html.a11y-readable .lead {
    max-width: 42rem;
  }

  html.a11y-links a:not(.btn):not(.a11y-fab):not([class*='chip']) {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    font-weight: 700;
  }

  html.a11y-links a:not(.btn):visited {
    text-decoration-style: double;
  }
</style>

<script>
  const KEY = 'cco:a11y';
  const LEGACY = 'cco-a11y';
  const TOGGLES = ['contrast', 'reduceMotion', 'readable', 'links'] as const;
  type Toggle = (typeof TOGGLES)[number];
  type FontSize = 'sm' | 'md' | 'lg';

  type Prefs = {
    font: FontSize;
    contrast: boolean;
    reduceMotion: boolean;
    readable: boolean;
    links: boolean;
  };

  const defaults = (): Prefs => ({
    font: 'md',
    contrast: false,
    reduceMotion: false,
    readable: false,
    links: false,
  });

  function read(): Prefs {
    try {
      const raw = localStorage.getItem(KEY) || localStorage.getItem(LEGACY);
      if (!raw) return defaults();
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed)) {
        return {
          font: parsed.includes('text-lg') ? 'lg' : 'md',
          contrast: parsed.includes('contrast'),
          reduceMotion: parsed.includes('reduce-motion'),
          readable: parsed.includes('readable'),
          links: parsed.includes('links'),
        };
      }
      if (parsed && typeof parsed === 'object') {
        const font: FontSize = parsed.font === 'sm' || parsed.font === 'lg' ? parsed.font : 'md';
        return {
          font,
          contrast: !!parsed.contrast,
          reduceMotion: !!parsed.reduceMotion,
          readable: !!parsed.readable,
          links: !!parsed.links,
        };
      }
    } catch {
      /* ignore */
    }
    return defaults();
  }

  function write(prefs: Prefs) {
    try {
      localStorage.setItem(KEY, JSON.stringify(prefs));
      localStorage.removeItem(LEGACY);
    } catch {
      /* ignore */
    }
  }

  function apply(prefs: Prefs, root?: HTMLElement | null) {
    const html = document.documentElement;
    html.classList.toggle('a11y-font-sm', prefs.font === 'sm');
    html.classList.toggle('a11y-font-lg', prefs.font === 'lg');
    html.dataset.a11yFont = prefs.font;
    html.classList.toggle('a11y-contrast', prefs.contrast);
    html.classList.toggle('a11y-reduce-motion', prefs.reduceMotion);
    html.classList.toggle('a11y-readable', prefs.readable);
    html.classList.toggle('a11y-links', prefs.links);

    root?.querySelectorAll<HTMLButtonElement>('[data-a11y-font]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.a11yFont === prefs.font));
    });
    root?.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((btn) => {
      const key = btn.dataset.a11yToggle as Toggle;
      btn.setAttribute('aria-pressed', String(!!prefs[key]));
    });
  }

  document.querySelectorAll<HTMLElement>('[data-a11y]').forEach((root) => {
    const panel = root.querySelector<HTMLDialogElement>('[data-a11y-panel]');
    const openBtn = root.querySelector<HTMLButtonElement>('[data-a11y-open]');
    const closeBtn = root.querySelector('[data-a11y-close]');
    if (!panel || !openBtn) return;

    let prefs = read();
    apply(prefs, root);

    const setOpen = (open: boolean) => {
      openBtn.setAttribute('aria-expanded', String(open));
      if (open) {
        if (!panel.open) panel.showModal();
      } else if (panel.open) {
        panel.close();
      }
    };

    openBtn.addEventListener('click', () => setOpen(!panel.open));
    closeBtn?.addEventListener('click', () => setOpen(false));
    panel.addEventListener('click', (e) => {
      if (e.target === panel) setOpen(false);
    });
    panel.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });

    root.querySelectorAll<HTMLButtonElement>('[data-a11y-font]').forEach((btn) => {
      btn.addEventListener('click', () => {
        prefs = { ...prefs, font: (btn.dataset.a11yFont as FontSize) || 'md' };
        write(prefs);
        apply(prefs, root);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.a11yToggle as Toggle;
        if (!TOGGLES.includes(key)) return;
        prefs = { ...prefs, [key]: !prefs[key] };
        write(prefs);
        apply(prefs, root);
      });
    });

    root.querySelector('[data-a11y-reset]')?.addEventListener('click', () => {
      prefs = defaults();
      write(prefs);
      apply(prefs, root);
    });
  });
</script>
