---
import Logo from '@/components/brand/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { company, openingHours, formatHours } from '@/data/company';
import { legalNavFor } from '@/data/navigation';
import { getLangFromPath, localizedPath, t, type Locale } from '@/i18n';
import { url } from '@/lib/url';

interface Props {
  lang?: Locale;
}
const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const L = (path: string) => url(localizedPath(path, lang));
const legalNav = legalNavFor(lang);

const groups = [
  {
    title: t(lang, 'footerVehicles'),
    links: [
      { label: t(lang, 'footerAllMh'), href: '/wohnmobile/' },
      { label: t(lang, 'navUsed'), href: '/wohnmobil-verkauf/' },
      { label: t(lang, 'navFinder'), href: '/camper-finder/' },
      { label: t(lang, 'navBrands'), href: '/marken/' },
      { label: t(lang, 'navConfigurator'), href: '/la-strada-konfigurator/' },
      { label: t(lang, 'navWishlist'), href: '/merkliste/' },
    ],
  },
  {
    title: t(lang, 'footerService'),
    links: [
      { label: t(lang, 'footerSell'), href: '/wohnmobil-ankauf/' },
      { label: t(lang, 'footerRent'), href: '/vermietung-wohnmobile/' },
      { label: t(lang, 'footerWorkshop'), href: '/werkstatt-kundendienst/' },
      { label: t(lang, 'navWash'), href: '/fahrzeugwaesche-herbst/' },
      { label: t(lang, 'navTour'), href: '/360-rundgang/' },
    ],
  },
  {
    title: t(lang, 'footerCompany'),
    links: [
      { label: t(lang, 'navAbout'), href: '/ueber-uns/' },
      { label: t(lang, 'navJobs'), href: '/jobs/' },
      { label: t(lang, 'footerContactRoute'), href: '/kontakt/' },
    ],
  },
];

const dayLabel = (days: string) => {
  if (days.includes('Montag') || days.includes('Monday')) return t(lang, 'footerDaysMonFri');
  if (days.includes('Samstag') || days.includes('Saturday')) return t(lang, 'footerDaysSat');
  return days;
};
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo tone="light" />
      <p class="footer-motto">
        {company.motto}. {company.foundedStatement} {t(lang, 'footerMottoSuffix')}
      </p>
      <address class="footer-address">
        <strong>{company.legalName}</strong><br />
        {company.address.street}<br />
        {company.address.postalCode} {company.address.city}
      </address>
      <ul class="footer-contact">
        <li>
          <a href={company.phone.href} data-track="call_click" data-track-location="footer"
            ><Icon name="phone" /> {company.phone.display}</a
          >
        </li>
        <li>
          <a href={`mailto:${company.email}`} data-track="email_click" data-track-location="footer"
            ><Icon name="mail" /> {company.email}</a
          >
        </li>
        <li>
          <a href={company.directions} target="_blank" rel="noopener" data-track="route_click" data-track-location="footer"
            ><Icon name="route" /> {t(lang, 'planRoute')}</a
          >
        </li>
      </ul>
    </div>

    <div class="footer-hours">
      <h2 class="footer-title">{t(lang, 'openingHours')}</h2>
      <dl>
        {
          openingHours.map((p) => (
            <div>
              <dt>{dayLabel(p.days)}</dt>
              <dd>{formatHours(p)}</dd>
            </div>
          ))
        }
      </dl>
      <p class="footer-note">{t(lang, 'closedSundayHoliday')}</p>
    </div>

    {
      groups.map((g) => (
        <nav class="footer-links" aria-label={g.title}>
          <h2 class="footer-title">{g.title}</h2>
          <ul>
            {g.links.map((l) => (
              <li>
                <a href={L(l.href)}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="container footer-bottom">
    <p>
      © {new Date().getFullYear()} {company.legalName}
    </p>
    <ul class="footer-legal">
      {
        legalNav.map((l) => (
          <li>
            <a href={L(l.href)}>{l.label}</a>
          </li>
        ))
      }
      <li><button type="button" class="footer-consent" data-consent-open>{t(lang, 'cookieSettings')}</button></li>
      <li>
        <a href={company.social.facebook} target="_blank" rel="noopener" class="footer-social"
          ><Icon name="facebook" label={`${company.name} Facebook`} /></a
        >
      </li>
    </ul>
  </div>
  <div class="container footer-disclaimer">
    <p>
      {t(lang, 'footerDisclaimer')}{' '}
      <a href={company.officialWebsite} rel="noopener">ccoverath.de</a>. {t(lang, 'footerDisclaimerEnd')}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--graphite);
    color: #e9e5de;
    padding-top: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .site-footer a,
  .footer-consent {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover,
  .footer-consent:hover {
    color: #fff;
    text-decoration: underline;
  }

  .site-footer :focus-visible {
    outline-color: #ffd28f;
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .footer-brand,
  .footer-hours {
    grid-column: 1 / -1;
  }

  .footer-motto {
    max-width: 30rem;
    margin: 1.1rem 0 1.25rem;
    color: #c9c4bb;
    font-size: var(--fs-sm);
  }

  .footer-address {
    font-style: normal;
    font-size: var(--fs-sm);
    line-height: 1.55;
  }

  .footer-contact {
    list-style: none;
    display: grid;
    gap: 0.1rem;
    margin-top: 0.9rem;
  }

  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .footer-contact :global(.icon) {
    color: #f0b25c;
  }

  .footer-title {
    margin-bottom: 0.9rem;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f0b25c;
  }

  .footer-hours dl {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }

  .footer-hours dt {
    font-weight: 650;
  }

  .footer-hours dd {
    margin: 0;
    color: #c9c4bb;
  }

  .footer-note {
    margin-top: 0.9rem;
    font-size: var(--fs-xs);
    color: #aaa59c;
  }

  .footer-links ul {
    list-style: none;
    display: grid;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: var(--fs-sm);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 3rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: var(--fs-xs);
    color: #aaa59c;
  }

  .footer-legal {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.25rem;
  }

  .footer-legal a,
  .footer-consent {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer-consent {
    border: 0;
    background: none;
    padding: 0;
    font-size: inherit;
    cursor: pointer;
  }

  .footer-disclaimer {
    padding-bottom: calc(1.5rem + var(--safe-bottom));
    font-size: var(--fs-xs);
    color: #aaa59c;
  }

  .footer-disclaimer a {
    text-decoration: underline;
  }

  @media (min-width: 48em) {
    .footer-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / 3;
    }

    .footer-hours {
      grid-column: auto;
    }
  }

  @media (min-width: 64em) {
    .footer-grid {
      grid-template-columns: 1.6fr 1.1fr 1fr 1fr 1fr;
    }

    .footer-brand,
    .footer-hours {
      grid-column: auto;
    }
  }
</style>
