---
import Icon from '@/components/ui/Icon.astro';
import { CAMPING_QUICK_PROMPTS } from '@/lib/camping-assist';
import { challengerManualHighlights, challengerManuals } from '@/data/challenger-manuals';
import { url } from '@/lib/url';
---

<div class="chatw" data-chat-widget data-size="md">
  <div class="chatw-panel" data-chat-panel hidden id="chatw-panel" role="dialog" aria-labelledby="chatw-title">
    <header class="chatw-head">
      <div class="chatw-brand">
        <span class="chatw-avatar" aria-hidden="true"><Icon name="van" /></span>
        <div class="chatw-brand-text">
          <p class="chatw-kicker">ccoverath KI</p>
          <h2 class="chatw-title" id="chatw-title">Camping-Assistent</h2>
        </div>
      </div>
      <div class="chatw-tools">
        <div class="chatw-sizes" role="group" aria-label="Fenstergröße">
          <button type="button" class="chatw-size-btn" data-chat-size="sm" aria-label="Klein" title="Klein">S</button>
          <button type="button" class="chatw-size-btn is-active" data-chat-size="md" aria-label="Mittel" title="Mittel">M</button>
          <button type="button" class="chatw-size-btn" data-chat-size="lg" aria-label="Groß" title="Groß">L</button>
          <button type="button" class="chatw-size-btn" data-chat-size="xl" aria-label="Sehr groß" title="Sehr groß">XL</button>
        </div>
        <button type="button" class="chatw-x" data-chat-close aria-label="Assistent schließen">
          <Icon name="close" />
        </button>
      </div>
    </header>

    <div class="chatw-tabs" role="tablist" aria-label="Assistent-Bereiche">
      <button type="button" class="chatw-tab is-active" role="tab" aria-selected="true" data-chat-tab="chat" id="chatw-tab-chat">
        Chat
      </button>
      <button type="button" class="chatw-tab" role="tab" aria-selected="false" data-chat-tab="manuals" id="chatw-tab-manuals">
        Wartungshefte
      </button>
    </div>

    <div class="chatw-pane" data-chat-pane="chat" role="tabpanel" aria-labelledby="chatw-tab-chat">
      <div class="chatw-body" data-chat-body>
        <div class="chatw-msg chatw-msg-bot is-latest" data-chat-msg>
          <p class="chatw-msg-lead">Hallo – wie kann ich helfen?</p>
          <p>
            Fragen zu <strong>Challenger</strong>, Kauf, Miete, Ankauf, Öffnungszeiten oder Service. Kurze Stichworte reichen.
          </p>
        </div>
        <div class="chatw-chips" data-chat-chips>
          {
            CAMPING_QUICK_PROMPTS.map((q) => (
              <button type="button" class="chatw-chip" data-chat-chip data-text={q.text}>
                {q.label}
              </button>
            ))
          }
        </div>
        <div class="chatw-anchor" data-chat-anchor aria-hidden="true"></div>
      </div>

      <form class="chatw-composer" data-chat-form>
        <label class="sr-only" for="chatw-input">Nachricht</label>
        <div class="chatw-input-wrap">
          <textarea
            id="chatw-input"
            name="message"
            rows="1"
            placeholder="Nachricht an ccoverath KI …"
            data-chat-input
            maxlength="800"></textarea>
          <button type="submit" class="chatw-send" data-chat-send aria-label="Senden">
            <Icon name="arrow-right" />
          </button>
        </div>
        <p class="chatw-hint">Enter senden · Shift+Enter neue Zeile · Größe oben mit S–XL</p>
      </form>
    </div>

    <div class="chatw-pane" data-chat-pane="manuals" role="tabpanel" aria-labelledby="chatw-tab-manuals" hidden>
      <div class="chatw-manuals">
        <div class="chatw-manual-intro">
          <p class="chatw-manual-kicker">Challenger · Trigano VDL</p>
          <p class="chatw-manual-lead">Offizielle Wartungshefte & Ergänzungen – zum Lesen und Herunterladen.</p>
        </div>

        <ul class="chatw-highlights">
          {
            challengerManualHighlights.map((h) => (
              <li>
                <strong>{h.title}</strong>
                <span>{h.text}</span>
              </li>
            ))
          }
        </ul>

        <ul class="chatw-docs">
          {
            challengerManuals.map((m) => (
              <li class="chatw-doc">
                <div class="chatw-doc-main">
                  <span class="chatw-doc-badge" data-kind={m.kind}>
                    {m.kind === 'wartungsheft' ? 'Wartung' : m.kind === 'ergaenzung' ? 'Ergänzung' : 'Service'}
                  </span>
                  <p class="chatw-doc-title">{m.title}</p>
                  <p class="chatw-doc-sub">{m.subtitle}</p>
                  <p class="chatw-doc-meta">
                    {m.year} · PDF · {m.sizeLabel}
                  </p>
                  <ul class="chatw-doc-topics">
                    {m.topics.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </div>
                <a
                  class="chatw-doc-btn"
                  href={url(`/downloads/challenger/${m.file}`)}
                  target="_blank"
                  rel="noopener"
                  data-track="cta_click"
                  data-track-location="chat-manual"
                >
                  PDF öffnen
                  <Icon name="external" />
                </a>
              </li>
            ))
          }
        </ul>

        <p class="chatw-manual-note">
          Profiles-Kataloge (große Dateien) auf Anfrage. Bei Garantiefragen hilft auch unser Chat oder die
          <a href={url('/werkstatt-kundendienst/')}>Werkstatt</a>.
        </p>
      </div>
    </div>

    <div class="chatw-resize" data-chat-resize title="Ziehen zum Vergrößern" aria-hidden="true"></div>
  </div>

  <button type="button" class="chatw-fab" data-chat-toggle aria-expanded="false" aria-controls="chatw-panel">
    <span class="chatw-fab-icon" aria-hidden="true"><Icon name="van" /></span>
    <span class="chatw-fab-copy">
      <span class="chatw-fab-eyebrow">ccoverath</span>
      <span class="chatw-fab-label">Camping-KI</span>
    </span>
  </button>
</div>

<style>
  .chatw {
    --cw-radius: 1.25rem;
    --cw-pad: 1rem;
    --cw-gap-bottom: calc(var(--actionbar-h, 0px) + var(--safe-bottom) + 1rem);
    --cw-max-h: calc(100dvh - var(--cw-gap-bottom) - 0.75rem);
    --cw-w: min(calc(100vw - 1.25rem), 24rem);
    --cw-h: min(36rem, var(--cw-max-h));
    position: fixed;
    right: 1rem;
    bottom: var(--cw-gap-bottom);
    z-index: 80;
    display: grid;
    justify-items: end;
    align-content: end;
    gap: 0.75rem;
    width: var(--cw-w);
    max-width: calc(100vw - 1.25rem);
    font-family: var(--font-body);
    pointer-events: none;
  }

  .chatw > * {
    pointer-events: auto;
  }

  .chatw[data-size='sm'] {
    --cw-w: min(calc(100vw - 1.25rem), 20rem);
    --cw-h: min(28rem, var(--cw-max-h));
  }

  .chatw[data-size='md'] {
    --cw-w: min(calc(100vw - 1.25rem), 24rem);
    --cw-h: min(36rem, var(--cw-max-h));
  }

  .chatw[data-size='lg'] {
    --cw-w: min(calc(100vw - 1.25rem), 32rem);
    --cw-h: min(44rem, var(--cw-max-h));
  }

  .chatw[data-size='xl'] {
    --cw-w: min(calc(100vw - 1.25rem), 42rem);
    --cw-h: min(52rem, var(--cw-max-h));
  }

  /* Offen: FAB weg, Actionbar aus, Fenster bleibt im Viewport */
  .chatw.is-open {
    --cw-gap-bottom: calc(var(--safe-bottom) + 0.75rem);
    --cw-max-h: calc(100dvh - var(--cw-gap-bottom) - 0.5rem);
  }

  .chatw.is-open .chatw-fab {
    display: none;
  }

  @media (max-width: 40em) {
    .chatw.is-open {
      right: 0.5rem;
      left: 0.5rem;
      width: auto;
      max-width: none;
      --cw-w: 100%;
      --cw-h: var(--cw-max-h);
    }
  }

  .chatw-fab {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3.35rem;
    padding: 0.4rem 1.1rem 0.4rem 0.4rem;
    border: 0;
    border-radius: 999px;
    background: var(--graphite);
    color: #fff;
    font: inherit;
    cursor: pointer;
    box-shadow: 0 12px 32px -14px rgb(28 32 36 / 0.55);
    transition:
      transform 0.18s ease,
      background 0.18s ease;
  }

  .chatw-fab:hover {
    transform: translateY(-2px);
    background: #2a3036;
  }

  .chatw-fab[aria-expanded='true'] {
    background: var(--brand);
    color: var(--graphite);
  }

  .chatw-fab-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--brand);
    color: var(--graphite);
    flex: none;
  }

  .chatw-fab[aria-expanded='true'] .chatw-fab-icon {
    background: rgb(28 32 36 / 0.12);
  }

  .chatw-fab-icon :global(.icon) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .chatw-fab-copy {
    display: grid;
    gap: 0.05rem;
    text-align: left;
    line-height: 1.15;
  }

  .chatw-fab-eyebrow {
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .chatw-fab-label {
    font-size: 0.95rem;
    font-weight: 800;
  }

  .chatw-panel {
    position: relative;
    width: 100%;
    height: min(var(--cw-h), var(--cw-max-h));
    max-height: var(--cw-max-h);
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid rgb(28 32 36 / 0.08);
    border-radius: var(--cw-radius);
    background: #fff;
    color: var(--text);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.6) inset,
      0 24px 48px -20px rgb(28 32 36 / 0.35);
  }

  .chatw-panel[hidden] {
    display: none !important;
  }

  .chatw-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.85rem var(--cw-pad) 0.65rem;
    background: linear-gradient(165deg, #f8efe0 0%, #fbf9f5 70%);
  }

  .chatw-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }

  .chatw-avatar {
    display: grid;
    place-items: center;
    width: 2.45rem;
    height: 2.45rem;
    border-radius: 0.85rem;
    background: var(--brand);
    color: var(--graphite);
    flex: none;
  }

  .chatw-avatar :global(.icon) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .chatw-kicker {
    margin: 0;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-ink);
  }

  .chatw-title {
    margin: 0.1rem 0 0;
    font-family: var(--font-body);
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .chatw-tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
  }

  .chatw-sizes {
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.15rem;
    border-radius: 999px;
    background: rgb(28 32 36 / 0.06);
  }

  .chatw-size-btn {
    min-width: 1.7rem;
    height: 1.7rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.68rem;
    font-weight: 800;
    cursor: pointer;
  }

  .chatw-size-btn:hover {
    color: var(--text);
  }

  .chatw-size-btn.is-active {
    background: var(--graphite);
    color: #fff;
  }

  .chatw-x {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 0;
    border-radius: 50%;
    background: rgb(28 32 36 / 0.06);
    cursor: pointer;
  }

  .chatw-x:hover {
    background: rgb(28 32 36 / 0.1);
  }

  .chatw-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
    padding: 0 var(--cw-pad) 0.65rem;
    background: linear-gradient(165deg, #fbf9f5 0%, #fff 100%);
    border-bottom: 1px solid rgb(28 32 36 / 0.06);
  }

  .chatw-tab {
    min-height: 2.3rem;
    border: 0;
    border-radius: 0.7rem;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 750;
    cursor: pointer;
  }

  .chatw-tab:hover {
    background: rgb(28 32 36 / 0.04);
    color: var(--text);
  }

  .chatw-tab.is-active {
    background: var(--graphite);
    color: #fff;
  }

  .chatw-pane {
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
  }

  .chatw-pane[hidden] {
    display: none !important;
  }

  .chatw-pane[data-chat-pane='manuals'] {
    grid-template-rows: minmax(0, 1fr);
  }

  .chatw-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.9rem var(--cw-pad) 1.1rem;
    overflow: auto;
    overscroll-behavior: contain;
    scroll-behavior: smooth;
    background: #fff;
  }

  .chatw-anchor {
    height: 1px;
    width: 100%;
    flex: none;
  }

  .chatw-msg {
    max-width: 100%;
    padding: 0.85rem 0.95rem;
    border-radius: 1rem;
    font-size: 0.9rem;
    line-height: 1.45;
    flex: none;
  }

  .chatw-msg p {
    margin: 0;
  }

  .chatw-msg p + p {
    margin-top: 0.4rem;
  }

  .chatw-msg-lead {
    font-weight: 750;
  }

  .chatw-msg-bot {
    background: #f4f1ea;
    color: var(--text);
    border-bottom-left-radius: 0.35rem;
  }

  .chatw-msg-user {
    align-self: flex-end;
    max-width: 92%;
    background: var(--graphite);
    color: #fff;
    border-bottom-right-radius: 0.35rem;
  }

  .chatw-msg.is-latest {
    box-shadow: 0 0 0 2px rgb(208 129 21 / 0.45);
  }

  .chatw-msg.is-latest.chatw-msg-bot {
    background: linear-gradient(180deg, #fff7eb 0%, #f4f1ea 100%);
  }

  .chatw-msg-title {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.95rem;
    font-weight: 800;
  }

  .chatw-thinking {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
    color: var(--brand-ink);
  }

  .chatw-thinking-dots {
    display: inline-flex;
    gap: 0.22rem;
  }

  .chatw-thinking-dots span {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--brand);
    animation: chatw-dot 1s ease-in-out infinite;
  }

  .chatw-thinking-dots span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .chatw-thinking-dots span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes chatw-dot {
    0%,
    80%,
    100% {
      opacity: 0.25;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  .chatw-points {
    display: grid;
    gap: 0.35rem;
    margin: 0.65rem 0 0;
    padding: 0;
    list-style: none;
  }

  .chatw-points li {
    position: relative;
    padding: 0.45rem 0.6rem 0.45rem 1.55rem;
    border-radius: 0.55rem;
    background: rgb(255 255 255 / 0.72);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .chatw-points li::before {
    content: '';
    position: absolute;
    left: 0.55rem;
    top: 0.75rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--brand);
  }

  .chatw-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.7rem;
  }

  .chatw-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 2.15rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--brand);
    color: var(--graphite);
    font-size: 0.82rem;
    font-weight: 750;
    text-decoration: none;
  }

  .chatw-disclaimer {
    display: block;
    margin-top: 0.55rem;
    font-size: 0.75rem;
    opacity: 0.78;
  }

  .chatw-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chatw-chip {
    border: 1px solid rgb(28 32 36 / 0.12);
    border-radius: 999px;
    background: #fff;
    padding: 0.4rem 0.75rem;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .chatw-chip:hover {
    border-color: var(--brand);
    background: var(--brand-soft);
  }

  .chatw-composer {
    padding: 0.65rem var(--cw-pad) 0.85rem;
    border-top: 1px solid rgb(28 32 36 / 0.06);
    background: #fbf9f5;
  }

  .chatw-input-wrap {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 0.45rem;
    padding: 0.35rem 0.35rem 0.35rem 0.75rem;
    border: 1px solid rgb(28 32 36 / 0.12);
    border-radius: 1rem;
    background: #fff;
  }

  .chatw-input-wrap:focus-within {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgb(208 129 21 / 0.18);
  }

  .chatw-composer textarea {
    width: 100%;
    min-height: 2.5rem;
    max-height: 6.5rem;
    resize: none;
    border: 0;
    padding: 0.55rem 0;
    background: transparent;
    font: inherit;
    font-size: 0.9rem;
    line-height: 1.35;
    outline: none;
  }

  .chatw-send {
    display: grid;
    place-items: center;
    width: 2.45rem;
    height: 2.45rem;
    border: 0;
    border-radius: 0.8rem;
    background: var(--brand);
    color: var(--graphite);
    cursor: pointer;
  }

  .chatw-send:hover {
    filter: brightness(1.05);
  }

  .chatw-send :global(.icon) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .chatw-hint {
    margin: 0.4rem 0 0;
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .chatw-resize {
    position: absolute;
    left: 0;
    top: 0;
    width: 1.1rem;
    height: 1.1rem;
    cursor: nwse-resize;
    background:
      linear-gradient(135deg, transparent 45%, rgb(28 32 36 / 0.2) 46%, rgb(28 32 36 / 0.2) 54%, transparent 55%),
      linear-gradient(135deg, transparent 60%, rgb(28 32 36 / 0.18) 61%, rgb(28 32 36 / 0.18) 69%, transparent 70%);
  }

  .chatw-manuals {
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 0.85rem var(--cw-pad) 1rem;
    background: #fff;
  }

  .chatw-manual-kicker {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--brand-ink);
  }

  .chatw-manual-lead {
    margin: 0.3rem 0 0;
    font-size: 0.92rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .chatw-highlights {
    display: grid;
    gap: 0.45rem;
    margin: 0.85rem 0 1rem;
    padding: 0;
    list-style: none;
  }

  .chatw-highlights li {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.8rem;
    border-radius: 0.75rem;
    background: #f4f1ea;
  }

  .chatw-highlights strong {
    font-size: 0.82rem;
  }

  .chatw-highlights span {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .chatw-docs {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chatw-doc {
    display: grid;
    gap: 0.7rem;
    padding: 0.85rem;
    border: 1px solid rgb(28 32 36 / 0.08);
    border-radius: 0.9rem;
    background: linear-gradient(180deg, #fff 0%, #fbf9f5 100%);
  }

  .chatw-doc-badge {
    display: inline-flex;
    width: fit-content;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-ink);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .chatw-doc-badge[data-kind='ergaenzung'] {
    background: #e8eef6;
    color: #2a4a6e;
  }

  .chatw-doc-badge[data-kind='service'] {
    background: #eceae4;
    color: #3d3a32;
  }

  .chatw-doc-title {
    margin: 0.4rem 0 0;
    font-size: 0.95rem;
    font-weight: 800;
  }

  .chatw-doc-sub,
  .chatw-doc-meta {
    margin: 0.15rem 0 0;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .chatw-doc-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
  }

  .chatw-doc-topics li {
    padding: 0.2rem 0.45rem;
    border-radius: 0.4rem;
    background: rgb(28 32 36 / 0.05);
    font-size: 0.7rem;
    font-weight: 650;
  }

  .chatw-doc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 0.7rem;
    background: var(--graphite);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 750;
    text-decoration: none;
  }

  .chatw-doc-btn:hover {
    background: #2a3036;
  }

  .chatw-doc-btn :global(.icon) {
    width: 0.95rem;
    height: 0.95rem;
  }

  .chatw-manual-note {
    margin: 1rem 0 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .chatw-manual-note a {
    color: inherit;
    font-weight: 750;
  }

  @media (max-width: 40em) {
    .chatw-size-btn[data-chat-size='xl'] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chatw-thinking-dots span {
      animation: none;
      opacity: 0.7;
    }

    .chatw-body {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  import { track } from '@/lib/analytics';
  import { assistCamping, type CampingAssistResult } from '@/lib/camping-assist';
  import { url } from '@/lib/url';

  const API = (import.meta.env.PUBLIC_API_BASE as string | undefined)?.replace(/\/$/, '') || '';
  const SIZE_KEY = 'cco-chat-size';
  const THINK_MS = 700;

  function escapeHtml(s: string) {
    return s
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function renderResult(data: CampingAssistResult): string {
    const bullets = data.bullets?.length
      ? `<ul class="chatw-points">${data.bullets.map((b) => `<li>${escapeHtml(b)}</li>`).join('')}</ul>`
      : '';
    const href = data.ctaHref ? (data.ctaHref.startsWith('http') ? data.ctaHref : url(data.ctaHref)) : '';
    const cta =
      data.ctaLabel && href
        ? `<span class="chatw-actions"><a href="${href}">${escapeHtml(data.ctaLabel)}</a></span>`
        : '';
    const disclaimer = data.disclaimer
      ? `<span class="chatw-disclaimer">${escapeHtml(data.disclaimer)}</span>`
      : '';
    return `<span class="chatw-msg-title">${escapeHtml(data.title)}</span><p>${escapeHtml(data.summary)}</p>${bullets}${disclaimer}${cta}`;
  }

  function thinkingHtml() {
    return `<span class="chatw-thinking" aria-live="polite"><span>ccoverath KI denkt</span><span class="chatw-thinking-dots" aria-hidden="true"><span></span><span></span><span></span></span></span>`;
  }

  function wait(ms: number) {
    return new Promise((r) => window.setTimeout(r, ms));
  }

  document.querySelectorAll<HTMLElement>('[data-chat-widget]').forEach((root) => {
    const panel = root.querySelector<HTMLElement>('[data-chat-panel]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-chat-toggle]');
    const close = root.querySelector('[data-chat-close]');
    const form = root.querySelector<HTMLFormElement>('[data-chat-form]');
    const input = root.querySelector<HTMLTextAreaElement>('[data-chat-input]');
    const body = root.querySelector<HTMLElement>('[data-chat-body]');
    const chips = root.querySelector('[data-chat-chips]');
    const anchor = root.querySelector<HTMLElement>('[data-chat-anchor]');
    const resizeHandle = root.querySelector<HTMLElement>('[data-chat-resize]');
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-chat-tab]');
    const panes = root.querySelectorAll<HTMLElement>('[data-chat-pane]');
    const sizeBtns = root.querySelectorAll<HTMLButtonElement>('[data-chat-size]');
    if (!panel || !toggle || !form || !input || !body) return;

    const scrollToLatest = () => {
      requestAnimationFrame(() => {
        // Nur im Chat-Body scrollen – nie die ganze Seite verschieben
        body.scrollTop = body.scrollHeight;
      });
    };

    const markLatest = (el: HTMLElement) => {
      body.querySelectorAll('.is-latest').forEach((n) => n.classList.remove('is-latest'));
      el.classList.add('is-latest');
      scrollToLatest();
    };

    const appendMsg = (text: string, who: 'bot' | 'user', asHtml = false) => {
      const el = document.createElement('div');
      el.className = `chatw-msg chatw-msg-${who}`;
      el.dataset.chatMsg = '';
      if (asHtml) el.innerHTML = text;
      else el.textContent = text;
      if (anchor) body.insertBefore(el, anchor);
      else body.appendChild(el);
      markLatest(el);
      return el;
    };

    const setSize = (size: string) => {
      const allowed = ['sm', 'md', 'lg', 'xl'];
      const next = allowed.includes(size) ? size : 'md';
      root.dataset.size = next;
      root.style.removeProperty('--cw-w');
      root.style.removeProperty('--cw-h');
      sizeBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.chatSize === next));
      try {
        localStorage.setItem(SIZE_KEY, next);
      } catch {
        /* ignore */
      }
      scrollToLatest();
    };

    try {
      const saved = localStorage.getItem(SIZE_KEY);
      if (saved) setSize(saved);
    } catch {
      /* ignore */
    }

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      root.classList.toggle('is-open', open);
      document.body.classList.toggle('bar-hidden', open);
      if (open) {
        track('chat_widget_open');
        const chatPane = root.querySelector<HTMLElement>('[data-chat-pane="chat"]');
        if (!chatPane?.hidden) input.focus({ preventScroll: true });
        scrollToLatest();
      }
    };

    const setTab = (name: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.chatTab === name;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
      });
      panes.forEach((p) => {
        p.hidden = p.dataset.chatPane !== name;
      });
      if (name === 'manuals') track('chat_manuals_open');
      if (name === 'chat') {
        input.focus({ preventScroll: true });
        scrollToLatest();
      }
    };

    const ask = async (message: string): Promise<CampingAssistResult> => {
      let data = assistCamping(message);
      try {
        if (API) {
          const res = await fetch(`${API}/api/camping-assistant`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message }),
          });
          if (res.ok) data = (await res.json()) as CampingAssistResult;
        }
      } catch {
        /* local */
      }
      return data;
    };

    const autosize = (ta: HTMLTextAreaElement) => {
      ta.style.height = 'auto';
      ta.style.height = `${Math.min(ta.scrollHeight, 104)}px`;
    };

    const run = async (message: string) => {
      const cleaned = message.trim();
      if (cleaned.length < 2) return;
      if (cleaned.length < 4) {
        appendMsg('Schreib bitte etwas genauer – z. B. „Challenger 240“, „mieten“ oder „Öffnungszeiten“.', 'bot');
        return;
      }
      setTab('chat');
      chips?.setAttribute('hidden', '');
      appendMsg(cleaned, 'user');
      input.value = '';
      autosize(input);
      track('camping_assistant_start', { source: 'chat_widget' });

      const thinking = appendMsg(thinkingHtml(), 'bot', true);
      thinking.classList.add('is-thinking');
      const started = Date.now();
      const data = await ask(cleaned);
      const left = THINK_MS - (Date.now() - started);
      if (left > 0) await wait(left);

      thinking.classList.remove('is-thinking');
      thinking.innerHTML = renderResult(data);
      markLatest(thinking);
      track('camping_assistant_complete', { provider: data.provider, off_topic: data.offTopic ? 1 : 0 });
    };

    toggle.addEventListener('click', () => setOpen(panel.hasAttribute('hidden')));
    close?.addEventListener('click', () => setOpen(false));
    tabs.forEach((t) => t.addEventListener('click', () => setTab(t.dataset.chatTab || 'chat')));
    sizeBtns.forEach((b) => b.addEventListener('click', () => setSize(b.dataset.chatSize || 'md')));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void run(input.value);
    });

    input.addEventListener('input', () => autosize(input));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        void run(input.value);
      }
    });

    root.querySelectorAll<HTMLButtonElement>('[data-chat-chip]').forEach((chip) => {
      chip.addEventListener('click', () => {
        void run(chip.dataset.text || chip.textContent || '');
      });
    });

    // Drag resize from top-left corner
    if (resizeHandle) {
      let dragging = false;
      let startX = 0;
      let startY = 0;
      let startW = 0;
      let startH = 0;

      const onMove = (e: PointerEvent) => {
        if (!dragging) return;
        const dx = startX - e.clientX;
        const dy = startY - e.clientY;
        const maxW = Math.min(window.innerWidth - 24, 720);
        const panelBottom = panel.getBoundingClientRect().bottom;
        const maxH = Math.max(280, Math.min(panelBottom - 12, window.innerHeight - 24));
        const w = Math.max(300, Math.min(maxW, startW + dx));
        const h = Math.max(280, Math.min(maxH, startH + dy));
        root.style.setProperty('--cw-w', `${w}px`);
        root.style.setProperty('--cw-h', `${h}px`);
        root.dataset.size = 'custom';
        sizeBtns.forEach((b) => b.classList.remove('is-active'));
      };

      const onUp = () => {
        if (!dragging) return;
        dragging = false;
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', onUp);
        scrollToLatest();
      };

      resizeHandle.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        dragging = true;
        startX = e.clientX;
        startY = e.clientY;
        startW = panel.getBoundingClientRect().width;
        startH = panel.getBoundingClientRect().height;
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onUp);
      });
    }
  });
</script>
