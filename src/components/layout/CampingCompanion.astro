---
import Icon from '@/components/ui/Icon.astro';
import AccessibilityPrefs from '@/components/layout/AccessibilityPrefs.astro';
import { company } from '@/data/company';
import { CAMPING_QUICK_PROMPTS } from '@/lib/camping-assist';
import { url } from '@/lib/url';

---

<div
  class="companion"
  data-companion
  data-size="md"
  data-i18n-title={'Hilfe & Barrierefreiheit'}
  data-i18n-sub={'Wir helfen dir gerne weiter.'}
>
  <button
    type="button"
    class="companion-fab"
    data-companion-open
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="companion-panel"
    aria-label={'Barrierefreiheit & Hilfe öffnen'}
  >
    <span class="companion-fab-mark" aria-hidden="true">
      <!-- Universal accessibility pictogram (figure with outstretched arms/legs in circle) -->
      <svg class="companion-fab-svg" viewBox="0 0 48 48" focusable="false">
        <circle cx="24" cy="24" r="18.5" fill="none" stroke="currentColor" stroke-width="2.5" />
        <circle cx="24" cy="13.6" r="3.2" fill="currentColor" />
        <path
          fill="currentColor"
          d="M10.8 21.4h26.4v2.7H27.2l5.9 11.2-2.4 1.25-6.15-11.65h-1.1l-6.15 11.65-2.4-1.25 5.9-11.2H10.8z"
        />
        <path fill="currentColor" d="M22.55 24.1h2.9v12.8h-2.9z" />
      </svg>
    </span>
  </button>

  <dialog
    class="companion-panel"
    id="companion-panel"
    data-companion-panel
    aria-labelledby="companion-title"
    aria-describedby="companion-sub"
  >
    <div class="companion-sheet">
      <header class="companion-head">
        <div class="companion-head-copy">
          <h2 id="companion-title">{'Hilfe & Barrierefreiheit'}</h2>
          <p class="companion-sub" id="companion-sub">{'Wir helfen dir gerne weiter.'}</p>
        </div>
        <div class="companion-head-tools">
          <div class="companion-sizes" role="group" aria-label={'Fenstergröße'}>
            <button type="button" class="companion-size-btn" data-companion-size="sm" aria-pressed="false">
              {'KLEIN'}
            </button>
            <button type="button" class="companion-size-btn is-active" data-companion-size="md" aria-pressed="true">
              {'MITTEL'}
            </button>
            <button type="button" class="companion-size-btn" data-companion-size="lg" aria-pressed="false">
              {'GROSS'}
            </button>
          </div>
          <button type="button" class="companion-icon-btn" data-companion-minimize aria-label={'Minimieren'}>
            <span aria-hidden="true">–</span>
          </button>
          <button type="button" class="companion-icon-btn" data-companion-close aria-label={'Schließen'}>
            <Icon name="close" />
          </button>
        </div>
      </header>

      <div class="companion-tabs" role="tablist" aria-label={'Hilfe & Barrierefreiheit'}>
        <button
          type="button"
          class="companion-tab is-active"
          role="tab"
          id="companion-tab-a11y"
          aria-selected="true"
          aria-controls="companion-panel-a11y"
          data-companion-tab="a11y"
        >
          {'Barrierefreiheit'}
        </button>
        <button
          type="button"
          class="companion-tab"
          role="tab"
          id="companion-tab-chat"
          aria-selected="false"
          aria-controls="companion-panel-chat"
          data-companion-tab="chat"
          tabindex="-1"
        >
          {'Camping-KI'}
        </button>
        <button
          type="button"
          class="companion-tab"
          role="tab"
          id="companion-tab-contact"
          aria-selected="false"
          aria-controls="companion-panel-contact"
          data-companion-tab="contact"
          tabindex="-1"
        >
          {'Kontakt'}
        </button>
      </div>

      <div class="companion-body">
        <div
          class="companion-view is-active"
          role="tabpanel"
          id="companion-panel-a11y"
          aria-labelledby="companion-tab-a11y"
          data-companion-view="a11y"
        >
          <AccessibilityPrefs embedded />
          <p class="companion-a11y-note">
            Diese Einstellungen erleichtern die Nutzung dieser Website. Sie ersetzen keine vollständige
            Barrierefreiheitsprüfung.
            <a href={url('/barrierefreiheit/')}>{'Erklärung zur Barrierefreiheit'}</a>
          </p>
        </div>

        <div
          class="companion-view"
          role="tabpanel"
          id="companion-panel-chat"
          aria-labelledby="companion-tab-chat"
          data-companion-view="chat"
          hidden
        >
          <div class="companion-chat" data-companion-chat>
            <div class="companion-chat-body" data-companion-chat-body>
              <div class="companion-chat-msg companion-chat-msg-bot is-latest" data-companion-chat-msg>
                <p class="companion-chat-lead">{'Hallo – wie kann ich helfen?'}</p>
                <p>
                  {
                    'Fragen zu Challenger, Kauf, Miete, Ankauf, Öffnungszeiten oder Service. Kurze Stichworte reichen.'
                  }
                </p>
              </div>
              <div class="companion-chat-chips" data-companion-chat-chips>
                {
                  CAMPING_QUICK_PROMPTS.map((q) => (
                    <button type="button" class="companion-chat-chip" data-companion-chat-chip data-text={q.text}>
                      {q.label}
                    </button>
                  ))
                }
              </div>
              <div class="companion-chat-anchor" data-companion-chat-anchor aria-hidden="true"></div>
            </div>
            <form class="companion-chat-composer" data-companion-chat-form>
              <label class="sr-only" for="companion-chat-input">{'Nachricht an Camping-KI'}</label>
              <div class="companion-chat-input-wrap">
                <textarea
                  id="companion-chat-input"
                  name="message"
                  rows="1"
                  placeholder={'Nachricht an Camping-KI …'}
                  data-companion-chat-input
                  maxlength="800"
                ></textarea>
                <button type="submit" class="companion-chat-send" data-companion-chat-send aria-label={'Senden'}>
                  <Icon name="arrow-right" />
                </button>
              </div>
              <p class="companion-chat-hint">{'Enter senden · Shift+Enter neue Zeile'}</p>
            </form>
          </div>
        </div>

        <div
          class="companion-view"
          role="tabpanel"
          id="companion-panel-contact"
          aria-labelledby="companion-tab-contact"
          data-companion-view="contact"
          hidden
        >
          <section class="companion-contact" aria-label={'Kontakt'}>
            <p class="companion-contact-lead">
              Persönliche Beratung in Overath – Anruf, Nachricht oder Anfahrt.
            </p>
            <div class="companion-contact-actions">
              <a
                class="btn btn-accent companion-contact-btn"
                href={company.phone.href}
                data-track="call_click"
                data-track-location="companion"
              >
                <Icon name="phone" />
                {'Jetzt anrufen'}
              </a>
              <a
                class="btn companion-contact-btn"
                href={url('/kontakt/')}
                data-track="cta_click"
                data-track-location="companion"
              >
                <Icon name="mail" />
                {'Nachricht schreiben'}
              </a>
              <a
                class="btn companion-contact-btn"
                href={company.directions}
                target="_blank"
                rel="noopener noreferrer"
                data-track="cta_click"
                data-track-location="companion-route"
              >
                <Icon name="route" />
                {'Route planen'}
              </a>
            </div>
            <p class="companion-contact-meta">
              <a href={company.phone.href}>{company.phone.display}</a>
              ·
              <a href={`mailto:${company.email}`}>{company.email}</a>
            </p>
            <p class="companion-contact-meta">
              {company.address.street}, {company.address.postalCode} {company.address.city}
            </p>
          </section>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  import { track } from '@/lib/analytics';
  import type { CampingAssistResult } from '@/lib/camping-assist';
  import { url } from '@/lib/url';

  const API = (import.meta.env.PUBLIC_API_BASE as string | undefined)?.replace(/\/$/, '') || '';
  const SIZE_KEY = 'cco:companion-size';
  const THINK_MS = 700;
  const MSG_SHORT =
    'Schreib bitte etwas genauer – z. B. „Challenger 240“, „mieten“ oder „Öffnungszeiten“.';
  const THINK_LABEL = 'Camping-KI denkt';

  type AssistFn = (message: string) => CampingAssistResult;
  let assistCampingLazy: AssistFn | null = null;
  let assistLoad: Promise<AssistFn> | null = null;

  function loadAssist(): Promise<AssistFn> {
    if (assistCampingLazy) return Promise.resolve(assistCampingLazy);
    if (!assistLoad) {
      assistLoad = import('@/lib/camping-assist').then((m) => {
        assistCampingLazy = m.assistCamping;
        return m.assistCamping;
      });
    }
    return assistLoad;
  }

  function escapeHtml(s: string) {
    return s
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function renderResult(data: CampingAssistResult): string {
    const bullets = data.bullets?.length
      ? `<ul class="companion-chat-points">${data.bullets.map((b) => `<li>${escapeHtml(b)}</li>`).join('')}</ul>`
      : '';
    const href = data.ctaHref ? (data.ctaHref.startsWith('http') ? data.ctaHref : url(data.ctaHref)) : '';
    const cta =
      data.ctaLabel && href
        ? `<span class="companion-chat-actions"><a href="${href}">${escapeHtml(data.ctaLabel)}</a></span>`
        : '';
    const disclaimer = data.disclaimer
      ? `<span class="companion-chat-disclaimer">${escapeHtml(data.disclaimer)}</span>`
      : '';
    return `<span class="companion-chat-title">${escapeHtml(data.title)}</span><p>${escapeHtml(data.summary)}</p>${bullets}${disclaimer}${cta}`;
  }

  function thinkingHtml() {
    return `<span class="companion-chat-thinking" aria-live="polite"><span>${THINK_LABEL}</span><span class="companion-chat-dots" aria-hidden="true"><span></span><span></span><span></span></span></span>`;
  }

  function wait(ms: number) {
    return new Promise((r) => window.setTimeout(r, ms));
  }

  document.querySelectorAll<HTMLElement>('[data-companion]').forEach((root) => {
    const panel = root.querySelector<HTMLDialogElement>('[data-companion-panel]');
    const openBtn = root.querySelector<HTMLButtonElement>('[data-companion-open]');
    const closeBtn = root.querySelector('[data-companion-close]');
    const minimizeBtn = root.querySelector('[data-companion-minimize]');
    const sizeBtns = root.querySelectorAll<HTMLButtonElement>('[data-companion-size]');
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-companion-tab]');
    const views = root.querySelectorAll<HTMLElement>('[data-companion-view]');

    const chatBody = root.querySelector<HTMLElement>('[data-companion-chat-body]');
    const chatForm = root.querySelector<HTMLFormElement>('[data-companion-chat-form]');
    const chatInput = root.querySelector<HTMLTextAreaElement>('[data-companion-chat-input]');
    const chatChips = root.querySelector<HTMLElement>('[data-companion-chat-chips]');
    const chatAnchor = root.querySelector<HTMLElement>('[data-companion-chat-anchor]');

    if (!panel || !openBtn) return;

    const setSize = (size: string) => {
      const allowed = ['sm', 'md', 'lg'];
      const next = allowed.includes(size) ? size : 'md';
      root.dataset.size = next;
      sizeBtns.forEach((b) => {
        const on = b.dataset.companionSize === next;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      try {
        localStorage.setItem(SIZE_KEY, next);
      } catch {
        /* ignore */
      }
    };

    try {
      const saved = localStorage.getItem(SIZE_KEY);
      if (saved) setSize(saved);
    } catch {
      /* ignore */
    }

    const setTab = (name: string) => {
      const tabName = name === 'chat' || name === 'contact' || name === 'a11y' ? name : 'a11y';
      tabs.forEach((t) => {
        const on = t.dataset.companionTab === tabName;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      views.forEach((v) => {
        const on = v.dataset.companionView === tabName;
        v.hidden = !on;
        v.classList.toggle('is-active', on);
      });
      if (tabName === 'a11y') window.dispatchEvent(new CustomEvent('cco:a11y-sync'));
      if (tabName === 'chat') {
        void loadAssist();
        window.dispatchEvent(new CustomEvent('cco:chat-opened'));
        chatInput?.focus({ preventScroll: true });
        scrollChat();
      }
    };

    const setOpen = (open: boolean, tab?: string) => {
      openBtn.setAttribute('aria-expanded', String(open));
      if (open) {
        if (!panel.open) panel.showModal();
        document.body.classList.add('companion-open');
        setTab(tab || 'a11y');
        const focusTarget =
          root.querySelector<HTMLElement>('.companion-tab.is-active') ||
          root.querySelector<HTMLElement>('[data-companion-close]');
        focusTarget?.focus({ preventScroll: true });
      } else if (panel.open) {
        panel.close();
      }
    };

    panel.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('companion-open');
      openBtn.focus({ preventScroll: true });
    });

    openBtn.addEventListener('click', () => setOpen(!panel.open));
    closeBtn?.addEventListener('click', () => setOpen(false));
    minimizeBtn?.addEventListener('click', () => setOpen(false));

    panel.addEventListener('click', (e) => {
      if (e.target === panel) setOpen(false);
    });

    sizeBtns.forEach((b) => b.addEventListener('click', () => setSize(b.dataset.companionSize || 'md')));

    tabs.forEach((t) => {
      t.addEventListener('click', () => setTab(t.dataset.companionTab || 'a11y'));
      t.addEventListener('keydown', (e) => {
        const order = ['a11y', 'chat', 'contact'];
        const i = order.indexOf(t.dataset.companionTab || 'a11y');
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const dir = e.key === 'ArrowRight' ? 1 : -1;
          const next = order[(i + dir + order.length) % order.length] || 'a11y';
          setTab(next);
          root.querySelector<HTMLButtonElement>(`[data-companion-tab="${next}"]`)?.focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          setTab('a11y');
          root.querySelector<HTMLButtonElement>('[data-companion-tab="a11y"]')?.focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          setTab('contact');
          root.querySelector<HTMLButtonElement>('[data-companion-tab="contact"]')?.focus();
        }
      });
    });

    window.addEventListener('cco:open-companion', ((ev: CustomEvent<{ view?: string; tab?: string }>) => {
      const tab = ev.detail?.tab || ev.detail?.view || 'a11y';
      const mapped = tab === 'hub' ? 'a11y' : tab;
      setOpen(true, mapped);
    }) as EventListener);

    window.addEventListener('cco:open-chat', () => {
      setOpen(true, 'chat');
    });

    /* —— Compact Camping-KI —— */
    function scrollChat() {
      if (!chatBody) return;
      requestAnimationFrame(() => {
        chatBody.scrollTop = chatBody.scrollHeight;
      });
    }

    function markLatest(el: HTMLElement) {
      chatBody?.querySelectorAll('.is-latest').forEach((n) => n.classList.remove('is-latest'));
      el.classList.add('is-latest');
      scrollChat();
    }

    function appendMsg(text: string, who: 'bot' | 'user', asHtml = false) {
      if (!chatBody) return null;
      const el = document.createElement('div');
      el.className = `companion-chat-msg companion-chat-msg-${who}`;
      el.dataset.companionChatMsg = '';
      if (asHtml) el.innerHTML = text;
      else el.textContent = text;
      if (chatAnchor) chatBody.insertBefore(el, chatAnchor);
      else chatBody.appendChild(el);
      markLatest(el);
      return el;
    }

    async function ask(message: string): Promise<CampingAssistResult> {
      const assistCamping = await loadAssist();
      let data = assistCamping(message);
      try {
        if (API) {
          const res = await fetch(`${API}/api/camping-assistant`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message, lang: 'de' }),
          });
          if (res.ok) data = (await res.json()) as CampingAssistResult;
        }
      } catch {
        /* local rules / offline fallback */
      }
      return data;
    }

    function autosize(ta: HTMLTextAreaElement) {
      ta.style.height = 'auto';
      ta.style.height = `${Math.min(ta.scrollHeight, 96)}px`;
    }

    async function run(message: string) {
      const cleaned = message.trim();
      if (cleaned.length < 2) return;
      if (cleaned.length < 4) {
        appendMsg(MSG_SHORT, 'bot');
        return;
      }
      chatChips?.setAttribute('hidden', '');
      appendMsg(cleaned, 'user');
      if (chatInput) {
        chatInput.value = '';
        autosize(chatInput);
      }
      track('camping_assistant_start', { source: 'companion' });

      const thinking = appendMsg(thinkingHtml(), 'bot', true);
      thinking?.classList.add('is-thinking');
      const started = Date.now();
      const data = await ask(cleaned);
      const left = THINK_MS - (Date.now() - started);
      if (left > 0) await wait(left);

      if (thinking) {
        thinking.classList.remove('is-thinking');
        thinking.innerHTML = renderResult(data);
        markLatest(thinking);
      }
      track('camping_assistant_complete', { provider: data.provider, off_topic: data.offTopic ? 1 : 0 });
    }

    chatForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      void run(chatInput?.value || '');
    });
    chatInput?.addEventListener('input', () => chatInput && autosize(chatInput));
    chatInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        void run(chatInput.value);
      }
    });
    root.querySelectorAll<HTMLButtonElement>('[data-companion-chat-chip]').forEach((chip) => {
      chip.addEventListener('click', () => {
        void run(chip.dataset.text || chip.textContent || '');
      });
    });
  });
</script>

<style>
  .companion {
    --companion-bottom: calc(var(--actionbar-h, 0px) + var(--safe-bottom) + var(--consent-lift, 0px) + 1rem);
    --companion-fab: 3.15rem;
    --cw: min(360px, calc(100vw - 24px));
    --ch: min(480px, calc(100dvh - 100px));
    position: fixed;
    right: max(0.85rem, env(safe-area-inset-right, 0px));
    bottom: var(--companion-bottom);
    z-index: var(--z-companion, 68);
    display: grid;
    justify-items: end;
    align-content: end;
    gap: 0.65rem;
    pointer-events: none;
    font-family: var(--font-body);
  }

  .companion > * {
    pointer-events: auto;
  }

  .companion[data-size='sm'] {
    --cw: min(320px, calc(100vw - 24px));
    --ch: min(400px, calc(100dvh - 100px));
  }

  .companion[data-size='md'] {
    --cw: min(360px, calc(100vw - 24px));
    --ch: min(480px, calc(100dvh - 100px));
  }

  .companion[data-size='lg'] {
    --cw: min(440px, calc(100vw - 24px));
    --ch: min(620px, calc(100dvh - 100px));
  }

  .companion-fab {
    display: grid;
    place-items: center;
    width: var(--companion-fab);
    height: var(--companion-fab);
    min-width: 48px;
    min-height: 48px;
    padding: 0;
    border: 1px solid rgb(28 32 36 / 0.14);
    border-radius: 50%;
    background: color-mix(in srgb, var(--graphite) 88%, var(--forest));
    color: var(--ivory);
    box-shadow:
      0 0 0 1px rgb(247 244 238 / 0.08) inset,
      0 10px 22px -12px rgb(28 32 36 / 0.55);
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      box-shadow 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .companion-fab:hover {
    background: var(--graphite);
    box-shadow:
      0 0 0 1px rgb(247 244 238 / 0.1) inset,
      0 14px 26px -12px rgb(28 32 36 / 0.6);
  }

  .companion-fab:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .companion-fab[aria-expanded='true'] {
    background: var(--forest);
    color: var(--ivory);
  }

  .companion-fab-svg {
    width: 1.55rem;
    height: 1.55rem;
    display: block;
  }

  /* Compact support panel above launcher — never fullscreen */
  .companion-panel {
    position: fixed;
    inset: auto;
    right: max(0.85rem, env(safe-area-inset-right, 0px));
    bottom: calc(var(--companion-bottom) + var(--companion-fab) + 0.65rem);
    width: var(--cw);
    height: var(--ch);
    max-width: calc(100vw - 24px);
    max-height: calc(100dvh - 100px);
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 1rem;
    background: transparent;
    color: var(--text);
    box-shadow: none;
    overflow: visible;
  }

  .companion-panel::backdrop {
    background: rgb(36 40 43 / 0.28);
  }

  .companion-sheet {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    width: 100%;
    height: 100%;
    max-height: inherit;
    overflow: hidden;
    border: 1px solid rgb(28 32 36 / 0.1);
    border-radius: 1rem;
    background: linear-gradient(180deg, #fbf7f0 0%, #fff 38%);
    box-shadow: 0 22px 48px -22px rgb(28 32 36 / 0.45);
  }

  .companion-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.75rem 0.75rem 0.55rem;
    border-bottom: 1px solid rgb(28 32 36 / 0.06);
  }

  .companion-head-copy {
    min-width: 0;
  }

  .companion-head-copy h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--graphite);
  }

  .companion-sub {
    margin: 0.2rem 0 0;
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--text-muted);
  }

  .companion-head-tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.3rem;
    flex: none;
  }

  .companion-sizes {
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.12rem;
    border: 1px solid rgb(28 32 36 / 0.1);
    border-radius: 0.55rem;
    background: var(--sand);
  }

  .companion-size-btn {
    min-height: 1.7rem;
    padding: 0 0.4rem;
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.62rem;
    font-weight: 800;
