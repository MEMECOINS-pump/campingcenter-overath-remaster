---
import Logo from '@/components/brand/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { mainNav, moreNav } from '@/data/navigation';
import { company, openingHours, formatHours } from '@/data/company';
import { stripBase, url } from '@/lib/url';

const current = stripBase(Astro.url.pathname);
const primary = [
  { label: 'Wohnmobile', href: '/wohnmobile/', hint: 'Fahrzeuge entdecken', icon: 'van' as const },
  { label: 'Fahrzeug verkaufen', href: '/wohnmobil-ankauf/', hint: 'Ankauf starten', icon: 'tag' as const },
  { label: 'Vermietung', href: '/vermietung-wohnmobile/', hint: 'Wohnmobil mieten', icon: 'key' as const },
  { label: 'Werkstatt', href: '/werkstatt-kundendienst/', hint: 'Service & Terminanfrage', icon: 'wrench' as const },
];
const secondary = [
  ...mainNav.filter((i) => i.href === '/ueber-uns/'),
  ...(mainNav.find((i) => i.label === 'Wohnmobile')?.children ?? []).filter((c) => c.href !== '/wohnmobile/'),
  ...moreNav,
];
---

<dialog class="mobile-menu" id="mobile-menu" aria-label="Menü" data-menu>
  <div class="mm-shell">
    <div class="mm-top">
      <a href={url('/')} class="mm-logo" aria-label={`${company.name} – Startseite`}>
        <Logo withClaim={false} />
      </a>
      <button type="button" class="mm-close" data-menu-close autofocus>
        <Icon name="close" />
        <span class="sr-only">Menü schließen</span>
      </button>
    </div>

    <div class="mm-scroll">
      <nav aria-label="Mobile Navigation">
        <p class="mm-heading">Menü</p>
        <ul class="mm-primary">
          {
            primary.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                  <span class="mm-icon">
                    <Icon name={item.icon} />
                  </span>
                  <span class="mm-text">
                    <span class="mm-label">{item.label}</span>
                    <span class="mm-hint">{item.hint}</span>
                  </span>
                  <Icon name="chevron-right" class="mm-chevron" />
                </a>
              </li>
            ))
          }
        </ul>

        <ul class="mm-secondary">
          {
            secondary.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={current === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section class="mm-contact" aria-labelledby="mm-contact-h">
        <p class="mm-heading" id="mm-contact-h">Kontakt</p>
        <ul class="mm-contact-list">
          <li>
            <a href={company.phone.href} data-track="call_click" data-track-location="mobile-menu">
              <Icon name="phone" />
              <span>{company.phone.display}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${company.email}`} data-track="email_click" data-track-location="mobile-menu">
              <Icon name="mail" />
              <span>{company.email}</span>
            </a>
          </li>
          <li>
            <a href={company.directions} target="_blank" rel="noopener" data-track="route_click" data-track-location="mobile-menu">
              <Icon name="pin" />
              <span>{company.address.street}, {company.address.postalCode} {company.address.city}</span>
            </a>
          </li>
        </ul>
        <dl class="mm-hours">
          {
            openingHours.map((p) => (
              <div>
                <dt>{p.shortDays}</dt>
                <dd>{formatHours(p)}</dd>
              </div>
            ))
          }
          <div>
            <dt>So / Feiertag</dt>
            <dd>geschlossen</dd>
          </div>
        </dl>
      </section>
    </div>

    <div class="mm-bottom">
      <a class="btn btn-accent btn-block btn-lg" href={url('/kontakt/#beratung')} data-track="cta_click" data-track-location="mobile-menu">
        Beratung vereinbaren
      </a>
    </div>
  </div>
</dialog>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ivory);
    color: var(--graphite);
    overscroll-behavior: contain;
  }

  .mobile-menu::backdrop {
    background: rgb(12 14 16 / 0.4);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] {
      animation: mm-in 0.28s var(--ease-out);
    }
  }

  @keyframes mm-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .mm-shell {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    height: 100dvh;
    padding-top: var(--safe-top);
  }

  .mm-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--line);
  }

  .mm-logo {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    text-decoration: none;
  }

  .mm-close {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -0.5rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--sand);
  }

  .mm-scroll {
    overflow-y: auto;
    padding: 1.25rem var(--gutter) 1.5rem;
    -webkit-overflow-scrolling: touch;
  }

  .mm-heading {
    margin-bottom: 0.6rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink);
  }

  .mm-primary,
  .mm-secondary,
  .mm-contact-list {
    list-style: none;
  }

  .mm-primary {
    display: grid;
    gap: 0.5rem;
  }

  .mm-primary a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 4.25rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--line);
    text-decoration: none;
  }

  .mm-primary a[aria-current='page'] {
    border-color: var(--brand);
    box-shadow: inset 3px 0 0 var(--brand);
  }

  .mm-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
    border-radius: 12px;
    background: var(--brand-soft);
    color: var(--brand-ink);
  }

  .mm-text {
    display: grid;
    flex: 1;
    gap: 0.1rem;
  }

  .mm-label {
    font-family: var(--font-head);
    font-size: 1.3rem;
    font-weight: 560;
    line-height: 1.15;
  }

  .mm-hint {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .mm-chevron {
    color: var(--mist);
  }

  .mm-secondary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1rem;
    margin: 1.25rem 0 1.75rem;
  }

  .mm-secondary a {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid var(--line);
    font-weight: 550;
    text-decoration: none;
  }

  .mm-secondary a[aria-current='page'] {
    color: var(--brand-ink);
  }

  .mm-contact-list {
    display: grid;
    gap: 0.25rem;
  }

  .mm-contact-list a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
    font-weight: 550;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .mm-contact-list :global(.icon) {
    color: var(--brand-ink);
    flex: none;
  }

  .mm-hours {
    display: grid;
    gap: 0.35rem;
    margin: 0.75rem 0 0;
    padding: 0.9rem 1rem;
    border-radius: var(--radius);
    background: var(--sand);
    font-size: var(--fs-sm);
  }

  .mm-hours div {
    display: flex;
    gap: 0.75rem;
  }

  .mm-hours dt {
    min-width: 3.25rem;
    font-weight: 700;
  }

  .mm-hours dd {
    margin: 0;
  }

  .mm-bottom {
    padding: 0.85rem var(--gutter) calc(0.85rem + var(--safe-bottom));
    border-top: 1px solid var(--line);
    background: var(--paper);
  }
</style>
