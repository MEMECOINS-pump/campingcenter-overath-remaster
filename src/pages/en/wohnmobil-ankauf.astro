---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import Photo from '@/components/ui/Photo.astro';
import Field from '@/components/forms/Field.astro';
import FormEnd from '@/components/forms/FormEnd.astro';
import FormSuccess from '@/components/forms/FormSuccess.astro';
import FaqAccordion from '@/components/ui/FaqAccordion.astro';
import { ankaufEn } from '@/data/content-en';
import { company } from '@/data/company';
import { breadcrumbSchema, serviceSchema } from '@/lib/schema';
import { localizedPath } from '@/i18n';
import { url } from '@/lib/url';

const lang = 'en' as const;
const ankauf = ankaufEn;
const crumbs = [{ label: 'Sell your vehicle', href: '/wohnmobil-ankauf/' }];

const faqs = [
  {
    q: 'How quickly do I get an offer?',
    a: 'Within 24 hours you receive a non-binding offer — based on market value, condition and equipment.',
  },
  {
    q: 'Do I have to bring my vehicle?',
    a: 'No. If you cannot come by, we collect the vehicle — nationwide in Germany.',
  },
  {
    q: 'Who handles deregistration and paperwork?',
    a: 'On request we handle deregistration and the paperwork for you.',
  },
  {
    q: 'Which vehicles do you buy?',
    a: `We buy ${ankauf.vehicleTypes.join(', ').replace(/, ([^,]*)$/, ' and $1')}.`,
  },
  {
    q: 'Is the enquiry binding?',
    a: 'No. The offer is non-binding — you decide in your own time whether to sell.',
  },
];
---

<BaseLayout
  lang={lang}
  path="/wohnmobil-ankauf/"
  title="Sell your motorhome – trade-in in Overath"
  description="Sell a motorhome, caravan, van or boat: non-binding offer within 24 hours. Fair valuation, nationwide collection in Germany, deregistration included."
  actionBar={false}
  bodyClass="page-ankauf"
  jsonLd={[
    breadcrumbSchema(crumbs, Astro.site),
    serviceSchema('Purchase of motorhomes, caravans, vans and boats', ankauf.promise, '/wohnmobil-ankauf/', Astro.site),
  ]}
>
  <section class="page-hero section-dark ak-hero">
    <div class="container ak-hero-grid">
      <div>
        <Breadcrumbs items={crumbs} tone="light" />
        <p class="eyebrow">Sell your vehicle</p>
        <h1>Simply to a personal offer.</h1>
        <p class="lead">{ankauf.promise} Fairly valued by people who camp themselves.</p>
        <div class="btn-row">
          <a class="btn btn-accent btn-lg" href="#bewertung" data-track="cta_click" data-track-location="ankauf_hero">
            Value my vehicle <Icon name="arrow-right" class="arrow" />
          </a>
          <a class="btn btn-light btn-lg" href={company.phone.href} data-track="call_click" data-track-location="ankauf_hero">
            <Icon name="phone" /> {company.phone.display}
          </a>
        </div>
        <ul class="ak-points">
          <li><Icon name="clock" /> Offer in 24 h</li>
          <li><Icon name="truck" /> Collection nationwide</li>
          <li><Icon name="document" /> Deregistration included</li>
        </ul>
      </div>
      <div class="ak-hero-media">
        <Photo src="ankauf-couple" alt="Happy couple with vehicle keys in front of a motorhome" sizes="(min-width: 64em) 40vw, 100vw" widths={[480, 800]} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ak-why">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Why us</p>
        <h2 id="ak-why">Fair, fast and personal</h2>
      </div>
      <ul class="grid grid-3" role="list">
        {
          ankauf.reasons.map((r, i) => (
            <li class="card card-pad reveal" data-delay={i}>
              <h3>{r.title}</h3>
              <p class="muted">{r.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-sand" aria-labelledby="ak-process">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="ak-process">From enquiry to handover</h2>
      </div>
      <ol class="ak-steps">
        {
          ankauf.process.map((s, i) => (
            <li class="reveal" data-delay={i}>
              <span class="ak-no">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="bewertung" class="section" aria-labelledby="wz-title">
    <div class="container container-narrow">
      <h2 id="wz-title">Request a valuation</h2>
      <p class="lead">Send us the essentials — we reply with a non-binding offer, usually within 24 hours. For the full 7-step German wizard you can also use the DE form.</p>
      <div class="card card-pad">
        <form class="form-stack" data-form="ankauf" data-subject="Trade-in enquiry via the website (EN)">
          <Field name="fahrzeugart" type="select" label="Vehicle type" required options={ankauf.vehicleTypes.map((t) => ({ value: t, label: t }))} />
          <Field name="hersteller" label="Make / model" required placeholder="e.g. Challenger 240" />
          <Field name="baujahr" label="Year / first registration" />
          <Field name="km" label="Mileage (km)" />
          <Field name="zustand" label="Condition & equipment" type="textarea" rows={4} />
          <Field name="preisvorstellung" label="Price expectation (optional)" />
          <Field name="name" label="Name" required autocomplete="name" />
          <Field name="email" label="Email" type="email" required autocomplete="email" />
          <Field name="telefon" label="Phone" type="tel" required autocomplete="tel" />
          <FormEnd submitLabel="Request offer" />
          <FormSuccess title="Enquiry prepared" text="We will get back to you with a non-binding offer." />
        </form>
        <p class="small muted ak-de-note">
          Prefer the detailed German multi-step form? <a href={url('/wohnmobil-ankauf/#bewertung')}>Open DE valuation wizard</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ak-faq">
    <div class="container container-narrow">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2 id="ak-faq">Good to know about trade-in</h2>
      </div>
      <FaqAccordion items={faqs} />
      <div class="btn-row ak-faq-actions">
        <a class="btn btn-ghost" href={url(localizedPath('/kontakt/', lang))}>Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ak-hero-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 64em) {
    .ak-hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .ak-points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 1.5rem 0 0;
    list-style: none;
    font-weight: 650;
  }

  .ak-points li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .ak-hero-media {
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .ak-steps {
    display: grid;
    gap: 1rem;
    list-style: none;
  }

  @media (min-width: 48em) {
    .ak-steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ak-steps li {
    padding: 1.35rem;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .ak-no {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 800;
    color: var(--brand-ink);
  }

  .ak-de-note {
    margin-top: 1rem;
  }

  .ak-faq-actions {
    margin-top: 1.5rem;
  }
</style>
