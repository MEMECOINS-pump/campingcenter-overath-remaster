---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Icon from '@/components/ui/Icon.astro';
import Photo from '@/components/ui/Photo.astro';
import Journey from '@/components/sections/Journey.astro';
import YouTubeLite from '@/components/embeds/YouTubeLite.astro';
import ContactSection from '@/components/sections/ContactSection.astro';
import { videos } from '@/data/content';
import { storyEn } from '@/data/content-en';
import { company } from '@/data/company';
import { url } from '@/lib/url';
import { breadcrumbSchema } from '@/lib/schema';

const lang = 'en' as const;
const story = storyEn;
const crumbs = [{ label: 'About us', href: '/ueber-uns/' }];
---

<BaseLayout
  lang={lang}
  path="/ueber-uns/"
  title="About us – By campers, for campers"
  description="Campingcenter Overath on Weberstraße: an experienced sales and workshop team of passionate campers committed to camping culture."
  overlayHeader
  jsonLd={[breadcrumbSchema(crumbs, Astro.site)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="About us"
    title="By campers, for campers."
    lead={story.lead}
    image="team-wide"
    imageAlt="The Campingcenter Overath team"
    focus="top"
  />

  <section class="section" aria-labelledby="ab-story">
    <div class="container split ab-story">
      <div class="ab-intro">
        <p class="eyebrow">Our story</p>
        <h2 id="ab-story">Camping is not just a business for us — it is a passion.</h2>
        <p class="ab-stat">
          <strong>{company.foundedStatement}</strong>
          <span>Camping expertise on Weberstraße</span>
        </p>
      </div>
      <div class="ab-body">
        {story.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="ab-wide" aria-hidden="true">
    <Photo src="panorama-yard" alt="" sizes="100vw" widths={[640, 1024, 1600, 2200]} />
  </section>

  <Journey />

  <section class="section" aria-labelledby="ab-videos">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Films</p>
        <h2 id="ab-videos">Get to know us</h2>
        <p class="lead">How we work — and where a motorhome journey can take you.</p>
      </div>
      <div class="grid grid-2 ab-video-grid">
        <YouTubeLite id={videos.culture.id} title={videos.culture.title} />
        <YouTubeLite id={videos.australia.id} title={videos.australia.title} />
      </div>
    </div>
  </section>

  <section class="section section-dark" aria-labelledby="ab-jobs">
    <div class="container split">
      <div class="ab-jobs-photo">
        <Photo src="team" alt="Campingcenter Overath staff" sizes="(min-width: 60em) 45vw, 92vw" widths={[480, 768, 1080]} />
      </div>
      <div>
        <p class="eyebrow">Careers</p>
        <h2 id="ab-jobs">Join the team.</h2>
        <p class="lead">Share our enthusiasm for camping? Take a look at our open roles.</p>
        <a class="btn btn-accent btn-lg" href={url('/jobs/')}>
          Open positions <Icon name="arrow-right" class="arrow" />
        </a>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>

<style>
  h2 {
    margin: 0.5rem 0 0.75rem;
  }

  .ab-story {
    align-items: start;
  }

  .ab-stat {
    display: grid;
    gap: 0.2rem;
    margin-top: 1.75rem;
  }

  .ab-stat strong {
    font-size: var(--fs-lg);
  }

  .ab-wide {
    margin: 0;
  }

  .ab-wide :global(img) {
    width: 100%;
    max-height: 28rem;
    object-fit: cover;
  }

  .ab-jobs-photo {
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .ab-jobs-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
