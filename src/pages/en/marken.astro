---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Icon from '@/components/ui/Icon.astro';
import CtaSection from '@/components/sections/CtaSection.astro';
import { partners } from '@/data/brands';
import { brandsEn } from '@/data/content-en';
import { vehicles } from '@/lib/vehicles';
import { localizedPath } from '@/i18n';
import { url } from '@/lib/url';
import { breadcrumbSchema } from '@/lib/schema';

const lang = 'en' as const;
const brands = brandsEn;
const crumbs = [{ label: 'Brands', href: '/marken/' }];
const inStock = (make?: string) => (make ? vehicles.filter((v) => v.make === make).length : 0);
---

<BaseLayout
  lang={lang}
  path="/marken/"
  title="Our brands – CHALLENGER, LA STRADA and EURA MOBIL"
  description="Campingcenter Overath is an authorised partner for CHALLENGER, LA STRADA and EURA MOBIL — with personal advice and current stock."
  overlayHeader
  jsonLd={[breadcrumbSchema(crumbs, Astro.site)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Authorised dealer"
    title="Strong brands. Personal advice."
    lead="We advise across manufacturers — and show you honestly which model really fits you."
    image="challenger-bridge"
    imageAlt="Challenger motorhome on a bridge"
  />

  <section class="section" aria-labelledby="mk-brands">
    <div class="container">
      <h2 id="mk-brands" class="sr-only">Our brands</h2>
      <ul class="mk-list" role="list">
        {
          brands.map((b) => {
            const n = inStock(b.inventoryMake);
            return (
              <li id={b.id} class="mk-brand card reveal">
                <div class="mk-logo">
                  <Image src={b.logo} alt="" widths={[200, 400]} sizes="12rem" loading="lazy" />
                </div>
                <div class="mk-body">
                  <h3>{b.name}</h3>
                  <p class="muted">{b.summary}</p>
                  <div class="btn-row">
                    {b.internalHref ? (
                      <a class="btn btn-accent btn-sm" href={url(b.internalHref)}>
                        To {b.name} page <Icon name="arrow-right" class="arrow" />
                      </a>
                    ) : n > 0 ? (
                      <a class="btn btn-accent btn-sm" href={url(localizedPath('/wohnmobile/', lang) + `?marke=${encodeURIComponent(b.inventoryMake ?? '')}`)}>
                        {n} {n === 1 ? 'vehicle' : 'vehicles'} in stock <Icon name="arrow-right" class="arrow" />
                      </a>
                    ) : (
                      <a class="btn btn-accent btn-sm" href={url(localizedPath('/kontakt/', lang) + `?fahrzeug=${encodeURIComponent(b.name)}#beratung`)}>
                        Request advice
                      </a>
                    )}
                    <a class="btn btn-ghost btn-sm" href={b.website} target="_blank" rel="noopener">
                      Manufacturer site <Icon name="external" />
                      <span class="sr-only"> (opens in new tab)</span>
                    </a>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="section section-sand" aria-labelledby="mk-why">
    <div class="container split">
      <div>
        <p class="eyebrow">Why several brands?</p>
        <h2 id="mk-why">You get advice — not a sales show.</h2>
      </div>
      <ul class="check-list mk-why">
        <li>We compare layouts and concepts from different makers for you.</li>
        <li>New or used: you see our full stock in one place.</li>
        <li>Our specialist workshop looks after your vehicle after purchase too.</li>
        <li>We gladly take your current vehicle in part-exchange.</li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="mk-partners">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Accessories & service</p>
        <h2 id="mk-partners">Our partners</h2>
      </div>
      <ul class="mk-partners" role="list">
        {
          partners.map((p) => (
            <li>
              <a href={p.website} target="_blank" rel="noopener">
                <Image src={p.logo} alt={p.name} widths={[160, 320]} sizes="10rem" loading="lazy" />
                <span class="sr-only"> (opens in new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaSection
    primary={{ label: 'Browse vehicles', href: localizedPath('/wohnmobile/', lang) }}
    secondary={{ label: 'Book consultation', href: localizedPath('/kontakt/', lang) + '#beratung' }}
  />
</BaseLayout>

<style>
  .mk-list {
    display: grid;
    gap: 1.25rem;
    list-style: none;
  }

  .mk-brand {
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  @media (min-width: 48em) {
    .mk-brand {
      grid-template-columns: 12rem 1fr;
      align-items: center;
    }
  }

  .mk-logo :global(img) {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .mk-partners {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 1rem;
    list-style: none;
  }

  .mk-partners a {
    display: grid;
    place-items: center;
    min-height: 5rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }

  .mk-partners :global(img) {
    max-height: 2.5rem;
    width: auto;
    object-fit: contain;
  }
</style>
