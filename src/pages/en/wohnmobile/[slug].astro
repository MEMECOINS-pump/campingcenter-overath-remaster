---
import VehicleDetail from '@/components/vehicles/VehicleDetail.astro';
import { vehicles, type Vehicle } from '@/lib/vehicles';

export function getStaticPaths() {
  return vehicles.map((vehicle) => ({ params: { slug: vehicle.slug }, props: { vehicle } }));
}

interface Props {
  vehicle: Vehicle;
}
const { vehicle } = Astro.props;
---

<VehicleDetail vehicle={vehicle} lang="en" />
