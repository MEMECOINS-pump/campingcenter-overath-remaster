---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import VehicleCard from '@/components/vehicles/VehicleCard.astro';
import Field from '@/components/forms/Field.astro';
import FormEnd from '@/components/forms/FormEnd.astro';
import { vehicles } from '@/lib/vehicles';
import { breadcrumbSchema } from '@/lib/schema';
import { url } from '@/lib/url';

import { finderQuestionsFor } from '@/data/camper-finder';
import { glossary, g } from '@/i18n/glossary';

const lang = 'de' as const;
const crumbs = [{ label: 'Camper-Finder', href: '/camper-finder/' }];
const questions = finderQuestionsFor(lang);
const ui = glossary.finderUi;
---

<BaseLayout
  compareTray
  title="Camper-Finder – Welcher Camper passt zu dir?"
  description="Beantworte ein paar kurze Fragen zu Personen, Schlafplätzen, Bettlänge und Fahrzeuglänge – der Camping Finder zeigt passende Wohnmobile aus dem Bestand des Campingcenter Overath."
  jsonLd={[breadcrumbSchema(crumbs, Astro.site)]}
>
  <section class="page-hero section-paper finder-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Camping Finder</p>
      <h1>Welcher Camper passt zu dir?</h1>
      <p class="lead">Beantworte ein paar kurze Fragen und finde heraus, welche Fahrzeuge zu deinen Reiseplänen passen.</p>
    </div>
  </section>

  <section class="section-tight" aria-label="Fragen">
    <div class="container container-narrow">
      <form
        class="finder"
        data-finder
        data-lang={lang}
        data-i18n-next={g(lang, ui.next)}
        data-i18n-show={g(lang, ui.showResults)}
        data-i18n-step={g(lang, ui.stepOf)}
        data-i18n-pick={g(lang, ui.pickAnswer)}
        data-i18n-results={g(lang, ui.resultsTitle)}
        data-i18n-empty={g(lang, ui.noExact)}
        data-i18n-empty-blocked={g(lang, ui.noExactBlocked)}
        data-i18n-why={g(lang, ui.whyLabel)}
        novalidate
      >
        <div class="finder-progress" data-finder-progress>
          <p><span data-finder-step>1 von {questions.length}</span></p>
          <div class="finder-bar" aria-hidden="true"><span data-finder-bar></span></div>
        </div>

        {
          questions.map((q, i) => (
            <fieldset class:list={['finder-q', i === 0 && 'is-active']} data-finder-q={i} aria-describedby={`fq-${q.name}-hint`}>
              <legend>
                <span class="finder-num">{String(i + 1).padStart(2, '0')}</span>
                {q.title}
              </legend>
              <p class="hint" id={`fq-${q.name}-hint`}>
                {q.hint}
              </p>
              <div class="finder-options">
                {q.options.map((o) => (
                  <label class="finder-opt">
                    <input type="radio" name={q.name} value={o.value} required={i === 0 || true} />
                    <span class="finder-opt-card">
                      <strong>{o.label}</strong>
                      {o.text && <span>{o.text}</span>}
                    </span>
                  </label>
                ))}
              </div>
              <p class="field-error" data-finder-error aria-live="polite"></p>
            </fieldset>
          ))
        }

        <div class="finder-nav">
          <button type="button" class="btn btn-ghost" data-finder-back hidden>Zurück</button>
          <button type="submit" class="btn btn-accent btn-lg finder-next">
            <span data-finder-next-label>Weiter</span>
          </button>
        </div>
      </form>
    </div>
  </section>

  <section class="section" data-finder-results hidden aria-live="polite">
    <div class="container">
      <header class="finder-result-head">
        <p class="eyebrow">Ergebnis</p>
        <h2 data-finder-title>Deine Empfehlungen</h2>
        <p class="lead" data-finder-summary></p>
      </header>

      <div class="finder-empty card card-pad" data-finder-empty hidden>
        <h3>Wir finden gemeinsam eine Lösung.</h3>
        <p>Hinterlasse unten deine Kontaktdaten – wir melden uns mit konkreten Vorschlägen inkl. deiner Finder-Antworten.</p>
        <a class="btn btn-accent" href={url('/kontakt/#beratung')}>Persönliche Beratung anfragen</a>
      </div>

      <div class="finder-grid" data-finder-grid>
        {
          vehicles.map((v, i) => (
            <div class="finder-item" data-finder-item hidden>
              <VehicleCard vehicle={v} index={i} />
              <div class="finder-why" data-finder-reasons={v.id}></div>
              <div class="btn-row">
                <a class="btn btn-accent btn-sm" href={url(`/wohnmobile/${v.slug}/`)}>Fahrzeug ansehen</a>
                <a class="btn btn-ghost btn-sm" href={url(`/kontakt/?fahrzeug=${encodeURIComponent(v.title)}#beratung`)}>Beratung anfragen</a>
              </div>
            </div>
          ))
        }
      </div>

      <form class="finder-lead card card-pad" data-finder-lead hidden>
        <h3>Persönliche Beratung anfragen</h3>
        <p class="muted">Wir speichern deine Antworten und Empfehlungen sicher und werten sie für unser Team aus.</p>
        <div class="form-stack">
          <Field name="name" label="Name" required autocomplete="name" />
          <Field name="email" label="E-Mail-Adresse" type="email" required autocomplete="email" />
          <Field name="phone" label="Telefonnummer" type="tel" required autocomplete="tel" />
          <FormEnd submitLabel="Beratung anfragen" />
        </div>
        <p class="muted small" data-finder-lead-status aria-live="polite"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import '@/scripts/finder';
</script>

<style>
  .finder-hero h1 {
    max-width: 16ch;
  }

  .finder {
    display: grid;
    gap: 1.25rem;
  }

  .finder-progress p {
    margin: 0 0 0.5rem;
    font-weight: 700;
  }

  .finder-bar {
    height: 0.35rem;
    border-radius: 999px;
    background: var(--sand);
    overflow: hidden;
  }

  .finder-bar span {
    display: block;
    width: 14%;
    height: 100%;
    background: var(--brand);
    transition: width 240ms var(--ease);
  }

  .finder-q {
    display: none;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .finder-q.is-active {
    display: grid;
    gap: 1rem;
  }

  .finder-q legend {
    display: grid;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 1.2rem + 1.4vw, 2.1rem);
    line-height: 1.15;
  }

  .finder-num {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-ink);
  }

  .finder-options {
    display: grid;
    gap: 0.65rem;
  }

  .finder-opt {
    cursor: pointer;
  }

  .finder-opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .finder-opt-card {
    display: grid;
    gap: 0.2rem;
    min-height: 4.5rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--white);
    transition:
      border-color 160ms var(--ease),
      background-color 160ms var(--ease),
      transform 120ms var(--ease);
  }

  .finder-opt input:checked + .finder-opt-card {
    border-color: var(--graphite);
    background: var(--sand);
  }

  .finder-opt input:focus-visible + .finder-opt-card {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .finder-nav {
    position: sticky;
    bottom: 0.75rem;
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    padding-top: 0.5rem;
    background: linear-gradient(to top, var(--bg), rgb(from var(--bg) r g b / 0.85) 70%, transparent);
  }

  .finder-next {
    margin-left: auto;
    min-width: min(100%, 12rem);
  }

  .finder-grid {
    display: grid;
    gap: 2rem;
  }

  .finder-item {
    display: grid;
    gap: 0.85rem;
  }

  .finder-why {
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--sand);
    font-size: var(--fs-sm);
  }

  .finder-why ul {
    margin: 0.35rem 0 0;
    padding-left: 0;
    list-style: none;
  }

  .finder-why-label {
    margin: 0;
    font-weight: 700;
  }

  .finder-lead {
    margin-top: 2.5rem;
  }

  .finder-empty {
    margin-bottom: 1.5rem;
  }

  @media (min-width: 40em) {
    .finder-options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .finder-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
