---
import Atmosphere from '@/components/ui/Atmosphere.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import VehicleCard from '@/components/vehicles/VehicleCard.astro';
import Field from '@/components/forms/Field.astro';
import FormEnd from '@/components/forms/FormEnd.astro';
import { vehicles } from '@/lib/vehicles';
import { breadcrumbSchema } from '@/lib/schema';
import { url } from '@/lib/url';

const crumbs = [{ label: 'Mein perfekter Camper', href: '/camper-finder/' }];

const questions = [
  {
    name: 'persons',
    title: 'Mit wem reist du?',
    hint: 'Schlafplätze und Sitzplätze sind unterschiedlich – wir trennen das bewusst.',
    options: [
      { value: '1', label: 'Alleine', text: 'Solo' },
      { value: '2', label: 'Zu zweit', text: 'Paar' },
      { value: '3', label: 'Kleine Gruppe', text: '3 Personen' },
      { value: '4', label: 'Mit der Familie', text: '4 Personen' },
      { value: '5plus', label: 'Mit Freunden', text: '5+ Personen' },
    ],
  },
  {
    name: 'style',
    title: 'Wie oft möchtest du verreisen?',
    hint: 'Hilft bei Komfort- und Größenempfehlungen – ohne erfundene Ausstattung.',
    options: [
      { value: 'kompakt', label: 'Am Wochenende', text: 'kurze Trips' },
      { value: 'offen', label: 'Mehrmals im Jahr', text: 'flexibel' },
      { value: 'komfort', label: 'Auf längeren Reisen', text: 'Komfort' },
      { value: 'raum', label: 'So oft wie möglich', text: 'viel Raum' },
    ],
  },
  {
    name: 'sleeps',
    title: 'Wie viele Schlafplätze werden benötigt?',
    hint: 'Nur Fahrzeuge mit passenden oder bestätigten Schlafplätzen zählen als harte Treffer.',
    options: [
      { value: '1', label: '1', text: '' },
      { value: '2', label: '2', text: '' },
      { value: '3', label: '3', text: '' },
      { value: '4', label: '4', text: '' },
      { value: '5plus', label: '5+', text: '' },
    ],
  },
  {
    name: 'bedType',
    title: 'Welche Bettform bevorzugst du?',
    hint: 'Wenn die Bettform in den Quelldaten fehlt, werten wir sie nicht als Treffer.',
    options: [
      { value: 'einzelbetten', label: 'Einzelbetten', text: '' },
      { value: 'doppelbett', label: 'Doppelbett', text: '' },
      { value: 'queensbett', label: 'Queensbett', text: '' },
      { value: 'hubbett', label: 'Hubbett', text: '' },
      { value: 'etagenbett', label: 'Etagenbett', text: '' },
      { value: 'any', label: 'Keine Präferenz', text: '' },
    ],
  },
  {
    name: 'bedLength',
    title: 'Welche Bettlänge benötigst du?',
    hint: 'Hilfreich besonders für größere Personen. Maße in cm – ohne Beleg in den Daten kein Treffer.',
    options: [
      { value: 'lt190', label: 'Unter 190 cm', text: 'kürzere Betten ok' },
      { value: 'min190', label: 'Mindestens 190 cm', text: '1,90 m' },
      { value: 'min195', label: 'Mindestens 195 cm', text: '1,95 m' },
      { value: 'min200', label: 'Mindestens 200 cm', text: '2,00 m' },
      { value: 'gt200', label: 'Über 200 cm', text: '2,00 m+' },
      { value: 'any', label: 'Keine Präferenz', text: '' },
    ],
  },
  {
    name: 'lengthMax',
    title: 'Wie lang darf dein Fahrzeug maximal sein?',
    hint: 'Wir vergleichen mit der angegebenen Fahrzeuglänge.',
    options: [
      { value: '6', label: 'Bis 6 m', text: '' },
      { value: '6.5', label: 'Bis 6,5 m', text: '' },
      { value: '7', label: 'Bis 7 m', text: '' },
      { value: '7.5', label: 'Bis 7,5 m', text: '' },
      { value: 'any', label: 'Über 7,5 m / egal', text: '' },
    ],
  },
  {
    name: 'condition',
    title: 'Neu oder gebraucht?',
    hint: 'Optional – du kannst beides offen lassen.',
    options: [
      { value: 'neu', label: 'Neufahrzeug', text: '' },
      { value: 'gebraucht', label: 'Gebraucht', text: '' },
      { value: 'any', label: 'Beides', text: '' },
    ],
  },
  {
    name: 'budget',
    title: 'Welches Budget hast du im Kopf?',
    hint: 'Nur zur Orientierung – Finanzierung und Inzahlungnahme besprechen wir gern persönlich.',
    options: [
      { value: 'bis50', label: 'Bis 50.000 €', text: '' },
      { value: '50-80', label: '50–80.000 €', text: '' },
      { value: '80+', label: 'Über 80.000 €', text: '' },
      { value: 'any', label: 'Noch offen', text: '' },
    ],
  },
];
---

<BaseLayout
  compareTray
  title="Mein perfekter Camper – intelligenter Camper-Finder"
  description="Erzähl uns, wie du reisen möchtest – Mein perfekter Camper zeigt passende Wohnmobile aus dem aktuellen Bestand des Campingcenter Overath. Ohne erfundene Fahrzeugdaten."
  jsonLd={[breadcrumbSchema(crumbs, Astro.site)]}
>
  <section class="page-hero atmo finder-hero" data-header-theme="dark">
    <Atmosphere src="atmo-meadow" focus="center" />
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Mein perfekter Camper</p>
      <h1>Welcher Camper passt zu dir?</h1>
      <p class="lead">
        <span class="finder-lead-short">Erzähl uns, wie du reisen möchtest – wir finden passende Fahrzeuge aus dem aktuellen Bestand.</span>
        <span class="finder-lead-full">
          Erzähl uns, wie du reisen möchtest – wir finden passende Fahrzeuge aus unserem aktuellen Bestand. Empfehlungen
          nutzen nur verifizierte Angaben; fehlende technische Daten werden nicht erraten.
        </span>
      </p>
    </div>
  </section>

  <section class="section-tight" aria-label="Fragen">
    <div class="container container-narrow">
      <form class="finder" data-finder novalidate>
        <div class="finder-progress" data-finder-progress>
          <p><span data-finder-step aria-live="polite">1 von {questions.length}</span></p>
          <div class="finder-bar" aria-hidden="true"><span data-finder-bar></span></div>
        </div>

        {
          questions.map((q, i) => (
            <fieldset class:list={['finder-q', i === 0 && 'is-active']} data-finder-q={i} aria-describedby={`fq-${q.name}-hint`}>
              <legend>
                <span class="finder-num">{String(i + 1).padStart(2, '0')}</span>
                {q.title}
              </legend>
              <p class="hint" id={`fq-${q.name}-hint`}>
                {q.hint}
              </p>
              <div class="finder-options">
                {q.options.map((o) => (
                  <label class="finder-opt">
                    <input type="radio" name={q.name} value={o.value} required={i === 0 || true} />
                    <span class="finder-opt-card">
                      <strong>{o.label}</strong>
                      {o.text && <span>{o.text}</span>}
                    </span>
                  </label>
                ))}
              </div>
              <p class="field-error" data-finder-error aria-live="polite"></p>
            </fieldset>
          ))
        }

        <div class="finder-nav">
          <button type="button" class="btn btn-ghost" data-finder-back hidden>Zurück</button>
          <button type="submit" class="btn btn-accent btn-lg finder-next">
            <span data-finder-next-label>Weiter</span>
          </button>
        </div>
      </form>
    </div>
  </section>

  <section class="section atmo" data-header-theme="dark" data-finder-results hidden aria-live="polite">
    <Atmosphere src="atmo-lake" focus="center" />
    <div class="container">
      <header class="finder-result-head">
        <p class="eyebrow">Ergebnis</p>
        <h2 data-finder-title>Deine Empfehlungen</h2>
        <p class="lead" data-finder-summary></p>
      </header>

      <div class="finder-empty card card-pad" data-finder-empty hidden>
        <h3>Aktuell haben wir kein Fahrzeug, das alle deine Wünsche erfüllt.</h3>
        <p>Hinterlasse unten deine Kontaktdaten – wir melden uns mit konkreten Vorschlägen inkl. deiner Finder-Antworten.</p>
        <a class="btn btn-accent" href={url('/kontakt/#beratung')}>Persönliche Beratung anfragen</a>
      </div>

      <div class="finder-grid" data-finder-grid>
        {
          vehicles.map((v, i) => (
            <div class="finder-item" data-finder-item hidden>
              <VehicleCard vehicle={v} index={i} />
              <div class="finder-why" data-finder-reasons={v.id}></div>
              <div class="btn-row">
                <a class="btn btn-accent btn-sm" href={url(`/wohnmobile/${v.slug}/`)}>Fahrzeug ansehen</a>
                <a class="btn btn-ghost btn-sm" href={url(`/kontakt/?fahrzeug=${encodeURIComponent(v.title)}#beratung`)}>Beratung anfragen</a>
              </div>
            </div>
          ))
        }
      </div>

      <form class="finder-lead card card-pad" data-finder-lead hidden>
        <h2>Persönliche Beratung anfragen</h2>
        <p class="muted">Deine Antworten und die empfohlenen Fahrzeuge gehen an unser Team, damit wir dich passend beraten können.</p>
        <div class="form-stack">
          <Field name="name" label="Name" required autocomplete="name" />
          <Field name="email" label="E-Mail-Adresse" type="email" required autocomplete="email" />
          <Field name="phone" label="Telefonnummer" type="tel" required autocomplete="tel" />
          <FormEnd submitLabel="Beratung anfragen" />
        </div>
        <p class="muted small" data-finder-lead-status aria-live="polite"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import '@/scripts/finder';
</script>

<style>
  .finder-hero h1 {
    max-width: 16ch;
  }

  .finder-lead-short {
    display: none;
  }

  @media (max-height: 740px) {
    .finder-lead-full {
      display: none;
    }

    .finder-lead-short {
      display: inline;
    }

    .finder-options {
      padding-right: calc(var(--companion-fab-h) + 0.85rem);
    }
  }

  @media (max-width: 63.99em) {
    .finder-hero {
      padding-block: 0.85rem 0.35rem;
    }

    .finder-hero h1 {
      font-size: clamp(1.7rem, 1.2rem + 2vw, 2.4rem);
    }

    .finder-hero .lead {
      margin-top: 0.55rem;
      font-size: var(--fs-sm);
      line-height: 1.45;
    }

    .finder-q legend {
      font-size: 1.45rem;
    }

    .finder-q.is-active {
      scroll-margin-bottom: calc(var(--actionbar-h) + var(--companion-fab-h) + 1rem);
    }

    .finder-options {
      padding-bottom: 0.25rem;
    }
  }

  .finder {
    display: grid;
    gap: 1.25rem;
  }

  .finder-progress p {
    margin: 0 0 0.5rem;
    font-weight: 700;
  }

  .finder-bar {
    height: 0.35rem;
    border-radius: 999px;
    background: var(--sand);
    overflow: hidden;
  }

  .finder-bar span {
    display: block;
    width: 14%;
    height: 100%;
    background: var(--brand);
    transition: width 240ms var(--ease);
  }

  .finder-q {
    display: none;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .finder-q.is-active {
    display: grid;
    gap: 1rem;
  }

  .finder-q legend {
    display: grid;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 1.2rem + 1.4vw, 2.1rem);
    line-height: 1.15;
  }

  .finder-num {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-ink);
  }

  .finder-options {
    display: grid;
    gap: 0.65rem;
  }

  .finder-opt {
    cursor: pointer;
  }

  .finder-opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .finder-opt-card {
    display: grid;
    gap: 0.2rem;
    min-height: 4.5rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--white);
    transition:
      border-color 160ms var(--ease),
      background-color 160ms var(--ease),
      transform 120ms var(--ease);
  }

  .finder-opt input:checked + .finder-opt-card {
    border-color: var(--graphite);
    background: var(--sand);
  }

  .finder-opt input:focus-visible + .finder-opt-card {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .finder-nav {
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    padding-top: 0.35rem;
  }

  .finder-next {
    margin-left: auto;
    min-width: min(100%, 12rem);
  }

  .finder-grid {
    display: grid;
    gap: 2rem;
  }

  .finder-item {
    display: grid;
    gap: 0.85rem;
  }

  .finder-why {
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--sand);
    font-size: var(--fs-sm);
  }

  .finder-why ul {
    margin: 0.35rem 0 0;
    padding-left: 0;
    list-style: none;
  }

  .finder-match-score {
    margin: 0 0 0.35rem;
    font-size: var(--fs-sm);
    color: var(--brand-ink);
  }

  .finder-match-score strong {
    font-size: 1.05rem;
  }

  .finder-why-label {
    margin: 0;
    font-weight: 700;
  }

  .finder-lead {
    margin-top: 2.5rem;
  }

  .finder-lead h2 {
    font-size: var(--fs-xl);
  }

  .finder-empty {
    margin-bottom: 1.5rem;
  }

  @media (min-width: 40em) {
    .finder-options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .finder-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
