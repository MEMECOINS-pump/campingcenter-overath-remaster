---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import Photo from '@/components/ui/Photo.astro';
import { company } from '@/data/company';
import { url } from '@/lib/url';

const links = [
  { label: 'Wohnmobile kaufen', href: '/wohnmobile/' },
  { label: 'Fahrzeug verkaufen', href: '/wohnmobil-ankauf/' },
  { label: 'Wohnmobil mieten', href: '/vermietung-wohnmobile/' },
  { label: 'Werkstatt', href: '/werkstatt-kundendienst/' },
  { label: 'Kontakt', href: '/kontakt/' },
];
---

<BaseLayout title="Seite nicht gefunden" description="Diese Seite gibt es nicht (mehr). Hier geht es weiter zu Fahrzeugen, Ankauf, Vermietung und Werkstatt." noindex path="/404/" overlayHeader>
  <section class="nf" aria-labelledby="nf-title">
    <div class="nf-media">
      <Photo src="road-landscape" alt="" sizes="100vw" widths={[640, 1024, 1600]} priority />
    </div>
    <div class="container nf-inner">
      <p class="nf-code">404</p>
      <h1 id="nf-title">Hier endet die Straße – aber nicht dein Abenteuer.</h1>
      <p class="nf-lead">Die Seite, die du suchst, gibt es nicht oder nicht mehr. Vielleicht hilft dir einer dieser Wege weiter.</p>
      <div class="btn-row">
        <a class="btn btn-accent btn-lg" href={url('/')}>Zur Startseite</a>
        <a class="btn btn-glass btn-lg" href={url('/wohnmobile/')}>Fahrzeuge entdecken <Icon name="arrow-right" class="arrow" /></a>
      </div>
      <nav class="nf-links" aria-label="Beliebte Seiten">
        <ul>
          {
            links.map((l) => (
              <li>
                <a href={url(l.href)}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="nf-help">
        Oder ruf uns an: <a href={company.phone.href}>{company.phone.display}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: 100svh;
    color: #fff;
    background: #2a2622;
  }

  .nf-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .nf-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(14 12 10 / 0.9), rgb(14 12 10 / 0.35) 70%, rgb(14 12 10 / 0.55));
  }

  .nf-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nf-inner {
    padding-top: calc(var(--header-h) + var(--safe-top) + 3rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .nf-code {
    font-family: var(--font-head);
    font-size: clamp(4rem, 3rem + 6vw, 8rem);
    font-weight: 700;
    line-height: 1;
    color: #ffd9a3;
    opacity: 0.9;
  }

  .nf h1 {
    max-width: 18ch;
    margin: 0.75rem 0 1rem;
    color: #fff;
    font-size: var(--fs-hero);
    line-height: 1.05;
  }

  .nf-lead {
    max-width: 36rem;
    margin-bottom: 1.75rem;
    font-size: var(--fs-lg);
    color: rgb(255 255 255 / 0.9);
  }

  .nf-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 2rem;
    list-style: none;
  }

  .nf-links a,
  .nf-help a {
    color: #fff;
    font-weight: 620;
    text-underline-offset: 0.25em;
  }

  .nf-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .nf-help {
    margin-top: 1rem;
    color: rgb(255 255 255 / 0.85);
  }
</style>
