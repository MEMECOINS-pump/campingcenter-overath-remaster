---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LegalShell from '@/components/sections/LegalShell.astro';
import Icon from '@/components/ui/Icon.astro';
import { agbDocuments } from '@/data/content';
---

<BaseLayout title="Allgemeine Geschäftsbedingungen" description="AGB des Campingcenter Overath zum Download: Reparaturbedingungen, Mietbedingungen, AGB Neuwagen und AGB Gebrauchtwagen.">
  <LegalShell title="Allgemeine Geschäftsbedingungen" path="/agb/" original="/agb/">
    <p>Hier findest du unsere Geschäftsbedingungen für die Bereiche Werkstatt, Vermietung, Neuwagen- und Gebrauchtwagen-Verkauf als PDF zum Download.</p>
    <ul class="agb-list" role="list">
      {
        agbDocuments.map((d) => (
          <li>
            <a class="agb-doc" href={d.href} target="_blank" rel="noopener">
              <span class="agb-icon">
                <Icon name="document" />
              </span>
              <span class="agb-text">
                <strong>{d.title}</strong>
                <span class="muted small">{d.area} · PDF</span>
              </span>
              <Icon name="external" class="agb-ext" />
              <span class="sr-only"> (PDF, öffnet in neuem Tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="small muted">Die Dokumente werden von ccoverath.de geladen. Fragen zu unseren Bedingungen beantworten wir gern persönlich.</p>
  </LegalShell>
</BaseLayout>

<style>
  .agb-list {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .agb-list li + li {
    margin-top: 0;
  }

  .agb-doc {
    display: flex;
    gap: 1rem;
    align-items: center;
    min-height: 4.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .agb-doc:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }

  .agb-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 10px;
    background: var(--brand-soft);
    color: var(--brand-ink);
  }

  .agb-text {
    display: grid;
    gap: 0.1rem;
  }

  .agb-doc :global(.agb-ext) {
    margin-left: auto;
    color: var(--text-muted);
  }
</style>
