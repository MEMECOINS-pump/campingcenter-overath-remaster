---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Icon from '@/components/ui/Icon.astro';
import Photo from '@/components/ui/Photo.astro';
import CtaSection from '@/components/sections/CtaSection.astro';
import { panamaModels, panamaUseCases } from '@/data/panama';
import { company } from '@/data/company';
import { url } from '@/lib/url';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [{ label: 'PANAMA', href: '/panama/' }];
const consult = (model: string) => url(`/kontakt/?fahrzeug=${encodeURIComponent(model)}#beratung`);
---

<BaseLayout
  title="PANAMA Vans im Raum Köln – Peak, Peak Next Generation und Urban"
  description="Dein PANAMA-Profi im Raum Köln: Der Camper für Alltag, Wochenende und Urlaub. Lass dich im Campingcenter Overath zu PANAMA Peak und Urban beraten."
  overlayHeader
  inquiryHref="/kontakt/?fahrzeug=PANAMA#beratung"
  inquiryLabel="Beratung"
  jsonLd={[breadcrumbSchema(crumbs, Astro.site)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="PANAMA-Profi im Raum Köln"
    title="365 Tage Freiheit."
    lead="Ein Van für den Alltag und das Abenteuer: Schulweg am Morgen, Baumarkt am Mittag, Stellplatz am Meer am Wochenende."
    image="panama-wide"
    imageAlt="PANAMA Van mit geöffnetem Aufstelldach in der Natur"
    size="lg"
  >
    <a class="btn btn-accent btn-lg" href="#modelle" data-track="cta_click" data-track-location="panama_hero">
      Modelle entdecken <Icon name="arrow-right" class="arrow" />
    </a>
    <a class="btn btn-glass btn-lg" href={url('/kontakt/?fahrzeug=PANAMA#beratung')} data-track="cta_click" data-track-location="panama_hero">
      Beratung vereinbaren
    </a>
  </PageHero>

  <section class="section" aria-labelledby="pn-uses">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Ein Fahrzeug, viele Leben</p>
        <h2 id="pn-uses">Wofür brauchst du deinen Van?</h2>
        <p class="lead">PANAMA Vans sind Alltagsauto, Transporter und Camper in einem.</p>
      </div>
      <ul class="pn-uses" role="list">
        {
          panamaUseCases.map((u, i) => (
            <li class="pn-use reveal" data-delay={i % 4}>
              <span class="pn-use-no">{String(i + 1).padStart(2, '0')}</span>
              <h3>{u.title}</h3>
              <p>{u.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="modelle" class="section section-sand pn-models" aria-labelledby="pn-models">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Modelle</p>
        <h2 id="pn-models">Finde deinen PANAMA</h2>
      </div>
      <nav class="pn-tabs" aria-label="PANAMA Modelle">
        {
          panamaModels.map((m) => (
            <a href={`#${m.id}`}>{m.name.replace('PANAMA ', '')}</a>
          ))
        }
      </nav>

      <div class="pn-list">
        {
          panamaModels.map((m) => (
            <article id={m.id} class="pn-model" aria-labelledby={`${m.id}-t`}>
              <div class="pn-gallery">
                {m.images.map((img, i) => (
                  <Photo
                    src={img}
                    alt={i === 0 ? m.name : ''}
                    sizes={i === 0 ? '(min-width: 64em) 36rem, 92vw' : '(min-width: 64em) 18rem, 46vw'}
                    widths={i === 0 ? [480, 768, 1080] : [320, 560]}
                    class={i === 0 ? 'pn-img pn-img-main' : 'pn-img'}
                  />
                ))}
              </div>
              <div class="pn-copy">
                <p class="pn-meta">
                  {m.variants} · Basis {m.base}
                </p>
                <h3 id={`${m.id}-t`}>{m.name}</h3>
                <p class="lead">{m.lead}</p>
                {m.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
                <details class="pn-features">
                  <summary>
                    Ausstattung ansehen <span class="muted">({m.features.length} Punkte)</span>
                    <Icon name="chevron-down" />
                  </summary>
                  <ul class="check-list">
                    {m.features.map((f) => (
                      <li>{f}</li>
                    ))}
                  </ul>
                </details>
                <div class="btn-row">
                  <a class="btn btn-accent" href={consult(m.name)} data-track="cta_click" data-track-location={`panama_${m.id}`}>
                    Beratung zum {m.name.replace('PANAMA ', '')}
                  </a>
                  {m.links.map((l) => (
                    <a class="btn btn-ghost btn-sm" href={l.href} target="_blank" rel="noopener">
                      {l.label} <Icon name="external" />
                      <span class="sr-only"> (Herstellerseite, öffnet in neuem Tab)</span>
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pn-visit">
    <div class="container split">
      <div class="pn-visit-photo reveal">
        <Photo src="panama-sea" alt="PANAMA Van am Meer" sizes="(min-width: 60em) 45vw, 92vw" widths={[480, 768, 1080]} />
      </div>
      <div>
        <p class="eyebrow">Beratung in Overath</p>
        <h2 id="pn-visit">Lass uns über deinen PANAMA sprechen.</h2>
        <p class="lead">Welche Variante passt zu deinem Alltag? Wir beraten dich ausführlich – frag am besten vorab kurz an, welche Modelle gerade bei uns vor Ort stehen.</p>
        <div class="btn-row">
          <a class="btn btn-accent btn-lg" href={url('/kontakt/?fahrzeug=PANAMA#beratung')}>Termin anfragen</a>
          <a class="btn btn-ghost btn-lg" href={company.phone.href} data-track="call_click" data-track-location="panama_visit">
            <Icon name="phone" /> {company.phone.display}
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaSection />
</BaseLayout>

<style>
  h2 {
    margin: 0.5rem 0 0.75rem;
  }

  .pn-uses {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
    list-style: none;
  }

  .pn-use {
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }

  .pn-use-no {
    font-family: var(--font-head);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--brand-ink);
  }

  .pn-use h3 {
    margin: 0.4rem 0 0.3rem;
    font-size: 1.2rem;
  }

  .pn-use p {
    color: var(--text-muted);
  }

  .pn-tabs {
    position: sticky;
    top: var(--header-h, 4.5rem);
    z-index: 4;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    margin: 0 calc(var(--gutter) * -1) 1.5rem;
    padding: 0.6rem var(--gutter);
    background: rgb(from var(--sand) r g b / 0.94);
    backdrop-filter: blur(10px);
    scrollbar-width: none;
  }

  .pn-tabs a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--white);
    font-weight: 620;
    white-space: nowrap;
    text-decoration: none;
  }

  .pn-list {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 5rem);
  }

  .pn-model {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    scroll-margin-top: calc(var(--header-h, 4.5rem) + 4.5rem);
  }

  @media (min-width: 64em) {
    .pn-model {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }

    .pn-model:nth-child(even) .pn-gallery {
      order: 2;
    }

    .pn-gallery {
      position: sticky;
      top: calc(var(--header-h, 4.5rem) + 5rem);
    }
  }

  .pn-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  .pn-gallery :global(.pn-img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    object-fit: cover;
  }

  .pn-gallery > :global(picture) {
    display: block;
    min-width: 0;
  }

  .pn-gallery > :global(picture:first-child) {
    grid-column: 1 / -1;
  }

  .pn-gallery :global(.pn-img-main) {
    aspect-ratio: 16 / 10;
  }

  .pn-meta {
    font-size: var(--fs-sm);
    font-weight: 650;
    letter-spacing: 0.04em;
    color: var(--brand-ink);
  }

  .pn-copy h3 {
    margin: 0.35rem 0 0.75rem;
    font-size: var(--fs-2xl);
  }

  .pn-copy > p + p {
    margin-top: 0.9rem;
  }

  .pn-features {
    margin: 1.5rem 0;
    border-block: 1px solid var(--line-strong);
  }

  .pn-features summary {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    min-height: 3.25rem;
    font-weight: 650;
    cursor: pointer;
    list-style: none;
  }

  .pn-features summary::-webkit-details-marker {
    display: none;
  }

  .pn-features summary :global(.icon) {
    margin-left: auto;
    transition: transform var(--dur) var(--ease);
  }

  .pn-features[open] summary :global(.icon) {
    transform: rotate(180deg);
  }

  .pn-features .check-list {
    padding-bottom: 1.25rem;
  }

  @media (min-width: 40em) {
    .pn-features .check-list {
      columns: 2;
      column-gap: 1.5rem;
    }
  }

  .pn-visit-photo {
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .pn-visit-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
