# Optional: form backend endpoint (e.g. a Formspree form URL or your own API).
# Without it, forms run in presentation mode: full validation, but instead of a
# network request the visitor can send the prepared request by e-mail or phone.
PUBLIC_FORM_ENDPOINT=

# Secure Cloudflare Worker / API base (no trailing slash), e.g. https://cco-api.example.workers.dev
# Used for camping-finder leads, rental inquiries, workshop assistant, La Strada inquiries.
PUBLIC_API_BASE=

# Search engine indexing. Off by default because this presentation duplicates
# the content of ccoverath.de. Set to "true" only for the real production launch.
PUBLIC_INDEXABLE=

# Set by the GitHub Pages workflow; only needed for local production previews.
SITE_URL=
BASE_PATH=

# --- Server-side only (api/ Cloudflare Worker secrets / vars) ---
# Never put these in frontend code or commit real values.
MOBILE_DE_API_USER=
MOBILE_DE_API_PASSWORD=
MOBILE_DE_SELLER_KEY=
MOBILE_DE_CLIENT_ID=
MOBILE_DE_CLIENT_SECRET=
LASTRADA_API_KEY=
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
AI_API_KEY=
AI_API_BASE=
